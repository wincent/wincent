#!/bin/bash
#
# Launch Pi outside the nono sandbox, still via the credential proxy.
#
# Usage:
#
#   bin/pi-naked [pi-args...]
#
# On Darwin this leases a current proxy generation, exports its matching
# proxy/CA/phantom variables, then execs `pi`. The lease follows this PID
# through exec; other sessions keep their own generation during updates.
# The agent is unsandboxed; credential capture/injection stays host-side.
#
# Inside a Linux VM, `sb ssh` already exported those variables, so this
# falls through to `pi`.
#
# A PATH shim may replace this later. Until then, invoke it by path.

set -e

if [ "$(uname -s)" = Darwin ]; then
  generation="$(nono-proxy acquire "$$")" || exit $?
  proxy_env="$(nono-proxy --generation "$generation" env)" || exit $?
  eval "$proxy_env"
fi

exec pi "$@"
