#!/bin/bash

# -E so that shell functions inherit the ERR trap installed below. We don't
# add `pipefail`, because it would interact badly with the `tart list | grep
# -q ...` guards: `grep -q` exits at the first match, `tart` then dies of
# SIGPIPE, and the pipeline would report failure despite the successful match.
set -eE

REPO_ROOT="${BASH_SOURCE%/*}/.."

source "$REPO_ROOT/bin/common"

# Say *which* step failed, instead of exiting silently.
trap 'status=$?; log_error "line $LINENO: \`$BASH_COMMAND\` failed with status $status"; exit $status' ERR

VM_BASE="wincent-base"

# `cmd_create` builds under this name and only promotes it to $VM_BASE once the
# build succeeds, so that a partial image can never be picked up by `bin/vm
# clone` or `sb create`.
VM_BUILD="$VM_BASE-building"
BUILD_VERIFIED=0

VM_USER="admin"
VM_PASS="admin"
VM_REPO_PATH="/home/$VM_USER/code/wincent"
OCI_IMAGE="ghcr.io/cirruslabs/ubuntu:latest"
REGISTRY="ghcr.io/wincent/wincent-base:latest"

# Keepalives so that a wedged session fails within a couple of minutes instead
# of hanging forever, or being silently reaped in the middle of an `apt-get`
# run.
SSH_OPTIONS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ServerAliveInterval=15 -o ServerAliveCountMax=8"

vm_ssh() {
  sshpass -p "$VM_PASS" ssh $SSH_OPTIONS "$VM_USER@$VM_IP" "$@"
}

wait_for_ssh() {
  log_info "Waiting for SSH..."
  local retries=30
  while [ $retries -gt 0 ]; do
    if vm_ssh true 2>/dev/null; then
      log_info "SSH is available"
      return 0
    fi
    retries=$((retries - 1))
    sleep 2
  done
  log_error "Timed out waiting for SSH"
  exit 1
}

cmd_create() {
  if tart list | grep -q "^local[[:space:]]*$VM_BASE "; then
    log_error "VM '$VM_BASE' already exists; destroy it first with: bin/vm destroy"
    exit 1
  fi

  if tart list | grep -q "^local[[:space:]]*$VM_BUILD "; then
    log_error "leftover VM '$VM_BUILD' from a failed build; discard it with: tart delete $VM_BUILD"
    exit 1
  fi

  log_info "Cloning $OCI_IMAGE -> $VM_BUILD"
  tart clone "$OCI_IMAGE" "$VM_BUILD"

  log_info "Configuring VM resources"
  tart set "$VM_BUILD" --disk-size 50 --cpu 4 --memory 8192

  log_info "Starting VM (headless)"
  tart run "$VM_BUILD" --no-graphics &
  TART_PID=$!

  trap finish_build EXIT INT TERM HUP

  VM_IP=$(tart ip "$VM_BUILD" --wait 30)
  log_info "VM IP: $VM_IP"

  wait_for_ssh

  log_info "Installing prerequisites"
  vm_ssh "sudo apt-get update && sudo apt-get install -y git curl"

  log_info "Initializing repo on VM"
  vm_ssh "mkdir -p $VM_REPO_PATH && cd $VM_REPO_PATH && git init -b main && git config receive.denyCurrentBranch updateInstead"

  log_info "Pushing repo to VM"
  GIT_SSH_COMMAND="sshpass -p $VM_PASS ssh $SSH_OPTIONS" \
    git -C "$REPO_ROOT" push "ssh://$VM_USER@$VM_IP$VM_REPO_PATH" HEAD:refs/heads/main

  log_info "Checking out and running install"
  vm_ssh "cd $VM_REPO_PATH && git checkout main && FIG_IDENTITY=wincent SUDO_ASKPASS=echo ./install"

  log_info "Upgrading system packages"
  vm_ssh "sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get clean"

  # Catch the failure modes that otherwise only show up much later, in daily
  # use: an interrupted `dpkg` transaction, or locales that were configured in
  # /etc/locale.gen but never actually generated (which makes every zsh prompt
  # print "character not in range").
  log_info "Verifying image"
  vm_ssh bash -s <<'REMOTE'
set -eu

if sudo dpkg --audit | grep -q .; then
  echo 'dpkg reports broken or unconfigured packages' >&2
  exit 1
fi

for locale in en_US.utf8 en_AU.utf8; do
  if ! locale -a | grep -qx "$locale"; then
    echo "locale $locale was not generated" >&2
    exit 1
  fi
done
REMOTE

  BUILD_VERIFIED=1
}

# EXIT/signal handler for `cmd_create`: shut the VM down cleanly, then promote
# the staging VM to $VM_BASE, but only if the build actually succeeded.
finish_build() {
  local status=$?

  # Avoid re-entering this handler via the commands below.
  trap - EXIT INT TERM HUP

  # A signal can arrive when $? is 0, so don't trust the status alone.
  if [ "$status" -eq 0 ] && [ "$BUILD_VERIFIED" -ne 1 ]; then
    status=1
  fi

  # Flush guest writes before yanking the power: `tart stop` in the middle of
  # `dpkg` is how you end up with files (such as
  # /usr/lib/locale/locale-archive) that never made it to disk.
  vm_ssh sync 2>/dev/null || true

  log_info "Stopping VM"
  tart stop "$VM_BUILD" 2>/dev/null || true
  wait $TART_PID 2>/dev/null || true

  if [ "$status" -ne 0 ]; then
    log_error "BASE IMAGE BUILD FAILED (status $status)"
    log_error "'$VM_BASE' was not created, so nothing can clone a broken image"
    log_error "inspect the leftovers with: bin/vm start $VM_BUILD --background && bin/vm ssh $VM_BUILD"
    log_error "or discard them with:       tart delete $VM_BUILD"
    exit "$status"
  fi

  # `tart rename` requires a stopped VM, which is why this happens here and not
  # at the end of `cmd_create`.
  log_info "Renaming $VM_BUILD -> $VM_BASE"
  tart rename "$VM_BUILD" "$VM_BASE"

  log_info "Base image '$VM_BASE' is ready"
  log_info "Clone it with: bin/vm clone <name>"
}

cmd_clone() {
  if [ -z "$1" ]; then
    log_error "Usage: bin/vm clone <vm-name>"
    exit 1
  fi

  local vm_name="$1"
  local clone_source

  if [ "$USE_REGISTRY" = false ] && tart list | grep -q "^local[[:space:]]*$VM_BASE "; then
    clone_source="$VM_BASE"
    log_info "Using local $VM_BASE image; run with --use-registry to use remote $REGISTRY image"
  elif tart list | grep -q "^OCI[[:space:]]*$REGISTRY "; then
    clone_source="$REGISTRY"
    log_info "Using image previously fetched from $REGISTRY; use \`bin/vm pull\` to obtain a newer image if desired"
  else
    log_error "Base image '$VM_BASE' not found; create it with: bin/vm create (or pull it with: bin/vm pull)"
    exit 1
  fi

  log_info "Cloning $clone_source -> $vm_name"
  tart clone "$clone_source" "$vm_name"

  log_info "VM '$vm_name' is ready"
  log_info "Start it with:  bin/vm start $vm_name"
  log_info "Connect with:   bin/vm ssh $vm_name"
}

cmd_push() {
  if ! tart list --format json | jq -e --arg name "$VM_BASE" '.[] | select(.Name == $name)' &>/dev/null; then
    log_error "VM '$VM_BASE' not found; create it first with: bin/vm create"
    exit 1
  fi

  if tart list --format json | jq -e --arg name "$VM_BASE" '.[] | select(.Name == $name and .State == "running")' &>/dev/null; then
    log_error "VM '$VM_BASE' is running; stop it first with: bin/vm stop"
    exit 1
  fi

  log_info "Pushing $VM_BASE -> $REGISTRY"
  if ! tart push "$VM_BASE" "$REGISTRY"; then
    log_error "Push failed; you may need to run: \`tart login ghcr.io\` (use a GitHub PAT with \`write:packages\` scope as the password)"
    exit 1
  fi

  log_info "Pushed successfully"
  log_info "Pull with: bin/vm pull"
}

cmd_pull() {
  if tart list --format json | jq -e --arg name "$VM_BASE" '.[] | select(.Name == $name and .State == "running")' &>/dev/null; then
    log_error "Local '$VM_BASE' is running; stop it first with: bin/vm stop"
    exit 1
  fi

  log_info "Pulling $REGISTRY"
  if ! tart pull "$REGISTRY"; then
    log_error "Pull failed; you may need to run: \`tart login ghcr.io\` (use a GitHub PAT with \`read:packages\` scope as the password)"
    exit 1
  fi

  if tart list | grep -q "^local[[:space:]]*$VM_BASE "; then
    log_info "Deleting local $VM_BASE to replace with pulled image"
    tart delete "$VM_BASE"
  fi

  log_info "Cloning $REGISTRY -> $VM_BASE"
  tart clone "$REGISTRY" "$VM_BASE"

  log_info "Pulled successfully"
  log_info "Clone it with: bin/vm clone <name>"
}

cmd_destroy() {
  local vm_name="${1:-$VM_BASE}"
  tart stop "$vm_name" 2>/dev/null || true
  tart delete "$vm_name"
}

cmd_start() {
  local vm_name="${1:-$VM_BASE}"
  if [ "$vm_name" = "--background" ]; then
    vm_name="$VM_BASE"
    tart run "$vm_name" --no-graphics &
    disown
    log_info "VM started in background (PID $!)"
  elif [ "${2:-}" = "--background" ]; then
    tart run "$vm_name" --no-graphics &
    disown
    log_info "VM started in background (PID $!)"
  else
    log_info "Running in foreground (pass \`--background\` to run in the background)"
    tart run "$vm_name" --no-graphics
  fi
}

cmd_ssh() {
  local vm_name="${1:-$VM_BASE}"
  VM_IP=$(tart ip "$vm_name" --wait 30)
  sshpass -p "$VM_PASS" ssh $SSH_OPTIONS "$VM_USER@$VM_IP"
}

cmd_stop() {
  local vm_name="${1:-$VM_BASE}"
  tart stop "$vm_name"
}

cmd_help() {
  cat <<EOF
Usage: bin/vm <command> [options]

Commands:
  clone <name> [--use-registry]
                          Clone the base image to create a new VM
  create                  Create a new base image from
                          ${OCI_IMAGE}
  destroy [name]          Stop and delete a VM (default: wincent-base)
  help                    Show this help message
  pull                    Pull the base image from the registry
  push                    Push the base image to the registry
  start [name] [--background]
                          Start a VM (default: wincent-base)
  ssh [name]              Connect to a running VM via SSH (default: wincent-base)
  stop [name]             Stop a running VM (default: wincent-base)
EOF
}

USE_REGISTRY=false
args=()
for arg in "$@"; do
  case "$arg" in
    --use-registry) USE_REGISTRY=true ;;
    *) args+=("$arg") ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

case "${1:-}" in
  clone)
    shift
    cmd_clone "$@"
    ;;
  create)
    shift
    cmd_create "$@"
    ;;
  destroy)
    shift
    cmd_destroy "$@"
    ;;
  help|--help)
    cmd_help
    ;;
  pull)
    shift
    cmd_pull "$@"
    ;;
  push)
    shift
    cmd_push "$@"
    ;;
  start)
    shift
    cmd_start "$@"
    ;;
  ssh)
    shift
    cmd_ssh "$@"
    ;;
  stop)
    shift
    cmd_stop "$@"
    ;;
  *)
    cmd_help
    exit 1
    ;;
esac
