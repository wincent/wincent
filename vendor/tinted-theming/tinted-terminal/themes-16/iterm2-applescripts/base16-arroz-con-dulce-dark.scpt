tell application "iTerm2"
    tell current session of current window
        set background color to {8481, 5140, 3855}
        set foreground color to {62194, 57311, 49344}

        -- Set ANSI Colors
        set ANSI black color to {8481, 5140, 3855}
        set ANSI red color to {57568, 31354, 35466}
        set ANSI green color to {54484, 31354, 20560}
        set ANSI yellow color to {55769, 42148, 16705}
        set ANSI blue color to {47545, 39578, 51400}
        set ANSI magenta color to {54741, 35466, 46260}
        set ANSI cyan color to {55769, 33410, 30326}
        set ANSI white color to {62194, 57311, 49344}

        -- Set Bright ANSI Colors
        set ANSI bright black color to {43433, 34181, 26728}
        set ANSI bright red color to {57568, 31354, 35466}
        set ANSI bright green color to {54484, 31354, 20560}
        set ANSI bright yellow color to {55769, 42148, 16705}
        set ANSI bright blue color to {47545, 39578, 51400}
        set ANSI bright magenta color to {54741, 35466, 46260}
        set ANSI bright cyan color to {55769, 33410, 30326}
        set ANSI bright white color to {65535, 63736, 59367}
    end tell
end tell
