# Scheme name: Berlin
# Scheme system: base24
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0xcccccc
foreground_bold    0xd6d6d6

# Cursor color
cursor             0xcccccc
cursor_foreground  0x000000

# Background color
background         0x000000

color0 0x000000 # base00 - Black
color1 0x999999 # base08 - Red
color2 0xbbbbbb # base0B - Green
color3 0xdddddd # base0A - Yellow
color4 0x888888 # base0D - Blue
color5 0xaaaaaa # base0E - Magenta
color6 0xcccccc # base0C - Cyan
color7 0xcccccc # base05 - White
color8 0x333333 # base03 - Bright Black
color9 0xbbbbbb # base12 - Bright Red
color10 0xdddddd # base14 - Bright Green
color11 0xffffff # base13 - Bright Yellow
color12 0xaaaaaa # base16 - Bright Blue
color13 0xcccccc # base17 - Bright Magenta
color14 0xeeeeee # base15 - Bright Cyan
color15 0xffffff # base07 - Bright White
