# Scheme name: Tokio
# Scheme system: base16
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0xf7f1ff
foreground_bold    0xf9f4ff

# Cursor color
cursor             0xf7f1ff
cursor_foreground  0x1c1c1d

# Background color
background         0x1c1c1d

color0 0x1c1c1d # base00 - Black
color1 0xfc618d # base08 - Red
color2 0x7bd88f # base0B - Green
color3 0xfce566 # base0A - Yellow
color4 0xfd9353 # base0D - Blue
color5 0x948ae3 # base0E - Magenta
color6 0x5ad4e6 # base0C - Cyan
color7 0xf7f1ff # base05 - White
color8 0x78757c # base03 - Bright Black
color9 0xfc618d # base08 - Bright Red
color10 0x7bd88f # base0B - Bright Green
color11 0xfce566 # base0A - Bright Yellow
color12 0xfd9353 # base0D - Bright Blue
color13 0x948ae3 # base0E - Bright Magenta
color14 0x5ad4e6 # base0C - Bright Cyan
color15 0xf7f1ff # base07 - Bright White
