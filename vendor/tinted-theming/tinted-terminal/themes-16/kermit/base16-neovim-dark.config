# Scheme name: Neovim Dark
# Scheme system: base16
# Scheme author: https://github.com/neovim/neovim/blob/master/src/nvim/highlight_group.c
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0xe0e2ea
foreground_bold    0xeef1f8

# Cursor color
cursor             0xe0e2ea
cursor_foreground  0x14161b

# Background color
background         0x14161b

color0 0x14161b # base00 - Black
color1 0xffc0b9 # base08 - Red
color2 0xb3f6c0 # base0B - Green
color3 0xfce094 # base0A - Yellow
color4 0xa6dbff # base0D - Blue
color5 0xffcaff # base0E - Magenta
color6 0x8cf8f7 # base0C - Cyan
color7 0xe0e2ea # base05 - White
color8 0x9b9ea4 # base03 - Bright Black
color9 0xffc0b9 # base08 - Bright Red
color10 0xb3f6c0 # base0B - Bright Green
color11 0xfce094 # base0A - Bright Yellow
color12 0xa6dbff # base0D - Bright Blue
color13 0xffcaff # base0E - Bright Magenta
color14 0x8cf8f7 # base0C - Bright Cyan
color15 0xeef1f8 # base07 - Bright White
