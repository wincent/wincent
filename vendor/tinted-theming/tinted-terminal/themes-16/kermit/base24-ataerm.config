# Scheme name: Aftertaerm
# Scheme system: base24
# Scheme author: Radek Polasek (https://github.com/radekp31), based on Taerminal by cozywigwam
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0xf0f0f0
foreground_bold    0xf1f1f1

# Cursor color
cursor             0xf0f0f0
cursor_foreground  0x26282a

# Background color
background         0x26282a

color0 0x26282a # base00 - Black
color1 0xff8878 # base08 - Red
color2 0xb4fb73 # base0B - Green
color3 0xfffcb7 # base0A - Yellow
color4 0x8bbce5 # base0D - Blue
color5 0xffb2fe # base0E - Magenta
color6 0xa2e1f8 # base0C - Cyan
color7 0xf0f0f0 # base05 - White
color8 0x6f6f6f # base03 - Bright Black
color9 0xfe978b # base12 - Bright Red
color10 0xd6fcba # base14 - Bright Green
color11 0xfffed5 # base13 - Bright Yellow
color12 0xc2e3ff # base16 - Bright Blue
color13 0xffc6ff # base17 - Bright Magenta
color14 0xc0e9f8 # base15 - Bright Cyan
color15 0xffffff # base07 - Bright White
