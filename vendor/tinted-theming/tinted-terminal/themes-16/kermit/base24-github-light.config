color2 0x116329 # base0B - Green
color3 0x9a6700 # base0A - Yellow
color4 0x0969da # base0D - Blue
color5 0x8250df # base0E - Magenta
color6 0x1b7c83 # base0C - Cyan
color7 0x454c54 # base05 - White
color8 0x818b98 # base03 - Bright Black
color9 0xa40e26 # base12 - Bright Red
color10 0x1a7f37 # base14 - Bright Green
color11 0x633c01 # base13 - Bright Yellow
color12 0x218bff # base16 - Bright Blue
color13 0xa475f9 # base17 - Bright Magenta
color14 0x3192aa # base15 - Bright Cyan
color15 0x1f2328 # base07 - Bright White
