# Scheme name: Apprentice
# Scheme system: base16
# Scheme author: Romain Lafourcade (https://github.com/romainl)
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0xbcbcbc
foreground_bold    0xdfdfdf

# Cursor color
