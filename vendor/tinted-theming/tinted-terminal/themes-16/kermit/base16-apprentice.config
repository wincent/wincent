color4 0x5f87af # base0D - Blue
color5 0x5f5f87 # base0E - Magenta
color6 0x5f8787 # base0C - Cyan
color7 0xbcbcbc # base05 - White
color8 0x444444 # base03 - Bright Black
color9 0xaf5f5f # base08 - Bright Red
color10 0x5f875f # base0B - Bright Green
color11 0x87875f # base0A - Bright Yellow
color12 0x5f87af # base0D - Bright Blue
color13 0x5f5f87 # base0E - Bright Magenta
