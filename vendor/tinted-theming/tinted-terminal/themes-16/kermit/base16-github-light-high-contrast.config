color3 0x603700 # base0A - Yellow
color4 0x0349b4 # base0D - Blue
color5 0x622cbc # base0E - Magenta
color6 0x1b7c83 # base0C - Cyan
color7 0x454c54 # base05 - White
color8 0x818b98 # base03 - Bright Black
color9 0xa0111f # base08 - Bright Red
color10 0x024c1a # base0B - Bright Green
color11 0x603700 # base0A - Bright Yellow
color12 0x0349b4 # base0D - Bright Blue
color13 0x622cbc # base0E - Bright Magenta
color14 0x1b7c83 # base0C - Bright Cyan
color15 0x010409 # base07 - Bright White
