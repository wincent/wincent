# Scheme name: Neovim Light
# Scheme system: base16
# Scheme author: https://github.com/neovim/neovim/blob/master/src/nvim/highlight_group.c
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0x14161b
foreground_bold    0x07080d

# Cursor color
cursor             0x14161b
cursor_foreground  0xe0e2ea

# Background color
background         0xe0e2ea

color0 0xe0e2ea # base00 - Black
color1 0x590008 # base08 - Red
color2 0x005523 # base0B - Green
color3 0x6b5300 # base0A - Yellow
color4 0x004c73 # base0D - Blue
color5 0x470045 # base0E - Magenta
color6 0x007373 # base0C - Cyan
color7 0x14161b # base05 - White
color8 0x4f5258 # base03 - Bright Black
color9 0x590008 # base08 - Bright Red
color10 0x005523 # base0B - Bright Green
color11 0x6b5300 # base0A - Bright Yellow
color12 0x004c73 # base0D - Bright Blue
color13 0x470045 # base0E - Bright Magenta
color14 0x007373 # base0C - Bright Cyan
color15 0x07080d # base07 - Bright White
