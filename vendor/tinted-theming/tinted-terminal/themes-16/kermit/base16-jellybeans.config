# Scheme name: Jellybeans
# Scheme system: base16
# Scheme author: FredHappyface (https://github.com/fredHappyface), converted to Base16 by https://github.com/nonetrix
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0xd5d5d5
foreground_bold    0xdedede

# Cursor color
cursor             0xd5d5d5
cursor_foreground  0x121212

# Background color
background         0x121212

color0 0x121212 # base00 - Black
color1 0xffa1a1 # base08 - Red
color2 0xbddeab # base0B - Green
color3 0xffdca0 # base0A - Yellow
color4 0xb1d8f6 # base0D - Blue
color5 0xfbdaff # base0E - Magenta
color6 0x1ab2a8 # base0C - Cyan
color7 0xd5d5d5 # base05 - White
color8 0xc5c5c5 # base03 - Bright Black
color9 0xffa1a1 # base08 - Bright Red
color10 0xbddeab # base0B - Bright Green
color11 0xffdca0 # base0A - Bright Yellow
color12 0xb1d8f6 # base0D - Bright Blue
color13 0xfbdaff # base0E - Bright Magenta
color14 0x1ab2a8 # base0C - Bright Cyan
color15 0xffffff # base07 - Bright White
