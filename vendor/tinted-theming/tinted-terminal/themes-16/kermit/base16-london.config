# Scheme name: London
# Scheme system: base16
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0x333333
foreground_bold    0x242424

# Cursor color
cursor             0x333333
cursor_foreground  0xffffff

# Background color
background         0xffffff

color0 0xffffff # base00 - Black
color1 0x333333 # base08 - Red
color2 0x444444 # base0B - Green
color3 0x555555 # base0A - Yellow
color4 0x666666 # base0D - Blue
color5 0x777777 # base0E - Magenta
color6 0x888888 # base0C - Cyan
color7 0x333333 # base05 - White
color8 0x333333 # base03 - Bright Black
color9 0x333333 # base08 - Bright Red
color10 0x444444 # base0B - Bright Green
color11 0x555555 # base0A - Bright Yellow
color12 0x666666 # base0D - Bright Blue
color13 0x777777 # base0E - Bright Magenta
color14 0x888888 # base0C - Bright Cyan
color15 0xaaaaaa # base07 - Bright White
