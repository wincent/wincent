# Scheme name: Praha
# Scheme system: base16
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: https://github.com/tinted-theming/tinted-kermit-terminal

# Foreground color
foreground         0xffffff
foreground_bold    0xffffff

# Cursor color
cursor             0xffffff
cursor_foreground  0x1a1a1a

# Background color
background         0x1a1a1a

color0 0x1a1a1a # base00 - Black
color1 0xff5555 # base08 - Red
color2 0xb8e6a0 # base0B - Green
color3 0xffe4a3 # base0A - Yellow
color4 0xbd93f9 # base0D - Blue
color5 0xff9aa2 # base0E - Magenta
color6 0x8be9fd # base0C - Cyan
color7 0xffffff # base05 - White
color8 0x6272a4 # base03 - Bright Black
color9 0xff5555 # base08 - Bright Red
color10 0xb8e6a0 # base0B - Bright Green
color11 0xffe4a3 # base0A - Bright Yellow
color12 0xbd93f9 # base0D - Bright Blue
color13 0xff9aa2 # base0E - Bright Magenta
color14 0x8be9fd # base0C - Bright Cyan
color15 0xffffff # base07 - Bright White
