color3 0x8a6408 # base0A - Yellow
color4 0x007a9e # base0D - Blue
color5 0x4d2699 # base0E - Magenta
color6 0x007a9e # base0C - Cyan
color7 0x1a1a1a # base05 - White
color8 0x4d4d4d # base03 - Bright Black
color9 0x990026 # base12 - Bright Red
color10 0x007a28 # base14 - Bright Green
color11 0x8a6408 # base13 - Bright Yellow
color12 0x007a9e # base16 - Bright Blue
color13 0x4d2699 # base17 - Bright Magenta
color14 0x007a9e # base15 - Bright Cyan
