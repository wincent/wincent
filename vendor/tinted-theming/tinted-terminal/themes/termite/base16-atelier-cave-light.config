color2  = #2a9292
# base0A - Yellow
color3  = #a06e3b
# base0D - Blue
color4  = #576ddb
# base0E - Magenta
color5  = #955ae7
# base0C - Cyan
color6  = #398bc6
# base05 - White
color7  = #585260
# base03 - Bright Black
color8  = #7e7887
# base08 - Bright Red
color9  = #be4678
# base0B - Bright Green
color10 = #2a9292
# base0A - Bright Yellow
color11 = #a06e3b
# base0D - Bright Blue
color12 = #576ddb
# base0E - Bright Magenta
color13 = #955ae7
# base0C - Bright Cyan
color14 = #398bc6
# base07 - Bright White
color15 = #19171c
# base09
color16 = #aa573c
# base0F
color17 = #bf40bf
