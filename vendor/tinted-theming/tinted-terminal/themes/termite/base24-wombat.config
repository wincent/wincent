color5  = #e86aff
# base0C - Cyan
color6  = #82fff6
# base05 - White
color7  = #b2afa6
# base03 - Bright Black
color8  = #5c5b58
# base12 - Bright Red
color9  = #f58b7f
# base14 - Bright Green
color10 = #dcf88f
# base13 - Bright Yellow
color11 = #eee5b2
