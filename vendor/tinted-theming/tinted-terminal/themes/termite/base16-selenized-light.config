[colors]
# base16 selenized-light
# Scheme author: Jan Warchol (https://github.com/jan-warchol/selenized) / adapted to base16 by ali
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #53676d
foreground_bold     = #53676d
cursor              = #53676d
cursor_foreground   = #fbf3db
background          = #fbf3db

# base00 - Black
color0  = #fbf3db
# base08 - Red
color1  = #cc1729
# base0B - Green
color2  = #428b00
# base0A - Yellow
color3  = #a78300
# base0D - Blue
color4  = #006dce
# base0E - Magenta
color5  = #825dc0
# base0C - Cyan
color6  = #00978a
# base05 - White
color7  = #53676d
# base03 - Bright Black
color8  = #909995
# base08 - Bright Red
color9  = #cc1729
# base0B - Bright Green
color10 = #428b00
# base0A - Bright Yellow
color11 = #a78300
# base0D - Bright Blue
color12 = #006dce
# base0E - Bright Magenta
color13 = #825dc0
# base0C - Bright Cyan
color14 = #00978a
# base07 - Bright White
color15 = #3a4d53
# base09
color16 = #bc5819
# base0F
color17 = #c44392
# base01
color18 = #ece3cc
# base02
color19 = #d5cdb6
# base04
color20 = #909995
# base06
color21 = #3a4d53
