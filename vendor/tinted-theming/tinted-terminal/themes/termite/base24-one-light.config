color2  = #50a14f
# base0A - Yellow
color3  = #febb2a
# base0D - Blue
color4  = #4078f2
# base0E - Magenta
color5  = #a626a4
# base0C - Cyan
color6  = #0184bc
# base05 - White
color7  = #383a42
# base03 - Bright Black
color8  = #a0a1a7
# base12 - Bright Red
color9  = #ec2258
# base14 - Bright Green
color10 = #6db76c
# base13 - Bright Yellow
color11 = #f4a701
# base16 - Bright Blue
color12 = #709af5
# base17 - Bright Magenta
color13 = #d02fcd
# base15 - Bright Cyan
color14 = #01a7ef
# base07 - Bright White
color15 = #090a0b
# base09
color16 = #c18401
# base0F
color17 = #986801
