[colors]
# base16 Helsinki
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #544d40
foreground_bold     = #544d40
cursor              = #544d40
cursor_foreground   = #f8fafe
background          = #f8fafe

# base00 - Black
color0  = #f8fafe
# base08 - Red
color1  = #1faa9e
# base0B - Green
color2  = #733d9a
# base0A - Yellow
color3  = #2e70ad
# base0D - Blue
color4  = #b55a0f
# base0E - Magenta
color5  = #3e9d21
# base0C - Cyan
color6  = #bd4c3d
# base05 - White
color7  = #544d40
# base03 - Bright Black
color8  = #b0a999
# base08 - Bright Red
color9  = #1faa9e
# base0B - Bright Green
color10 = #733d9a
# base0A - Bright Yellow
color11 = #2e70ad
# base0D - Bright Blue
color12 = #b55a0f
# base0E - Bright Magenta
color13 = #3e9d21
# base0C - Bright Cyan
color14 = #bd4c3d
# base07 - Bright White
color15 = #000000
# base09
color16 = #268da6
# base0F
color17 = #1b6374
# base01
color18 = #edeef1
# base02
color19 = #e4e5e7
# base04
color20 = #8d8a82
# base06
color21 = #3b362d
