[colors]
# base16 Flat
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e0e0e0
foreground_bold     = #e0e0e0
cursor              = #e0e0e0
cursor_foreground   = #2c3e50
background          = #2c3e50

# base00 - Black
color0  = #2c3e50
# base08 - Red
color1  = #e74c3c
# base0B - Green
color2  = #2ecc71
# base0A - Yellow
color3  = #f1c40f
# base0D - Blue
color4  = #3498db
# base0E - Magenta
color5  = #9b59b6
# base0C - Cyan
color6  = #1abc9c
# base05 - White
color7  = #e0e0e0
# base03 - Bright Black
color8  = #95a5a6
# base08 - Bright Red
color9  = #e74c3c
# base0B - Bright Green
color10 = #2ecc71
# base0A - Bright Yellow
color11 = #f1c40f
# base0D - Bright Blue
color12 = #3498db
# base0E - Bright Magenta
color13 = #9b59b6
# base0C - Bright Cyan
color14 = #1abc9c
# base07 - Bright White
color15 = #ecf0f1
# base09
color16 = #e67e22
# base0F
color17 = #be643c
# base01
color18 = #34495e
# base02
color19 = #7f8c8d
# base04
color20 = #bdc3c7
# base06
color21 = #f5f5f5
