color4  = #82aaff
# base0E - Magenta
color5  = #fca7ea
# base0C - Cyan
color6  = #86e1fc
# base05 - White
color7  = #828bb8
# base03 - Bright Black
color8  = #3b4261
# base08 - Bright Red
color9  = #ff757f
# base0B - Bright Green
color10 = #c3e88d
# base0A - Bright Yellow
color11 = #ffdf77
# base0D - Bright Blue
color12 = #82aaff
