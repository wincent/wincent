[colors]
# base16 Windows 95 Light
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #545454
foreground_bold     = #545454
cursor              = #545454
cursor_foreground   = #fcfcfc
background          = #fcfcfc

# base00 - Black
color0  = #fcfcfc
# base08 - Red
color1  = #a80000
# base0B - Green
color2  = #00a800
# base0A - Yellow
color3  = #a85400
# base0D - Blue
color4  = #0000a8
# base0E - Magenta
color5  = #a800a8
# base0C - Cyan
color6  = #00a8a8
# base05 - White
color7  = #545454
# base03 - Bright Black
color8  = #a8a8a8
# base08 - Bright Red
color9  = #a80000
# base0B - Bright Green
color10 = #00a800
# base0A - Bright Yellow
color11 = #a85400
# base0D - Bright Blue
color12 = #0000a8
# base0E - Bright Magenta
color13 = #a800a8
# base0C - Bright Cyan
color14 = #00a8a8
# base07 - Bright White
color15 = #000000
# base09
color16 = #fcfc54
# base0F
color17 = #54fc54
# base01
color18 = #e0e0e0
# base02
color19 = #c4c4c4
# base04
color20 = #7e7e7e
# base06
color21 = #2a2a2a
