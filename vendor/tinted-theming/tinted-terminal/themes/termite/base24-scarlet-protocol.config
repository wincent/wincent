color6  = #00c5c7
# base05 - White
color7  = #afafaf
# base03 - Bright Black
color8  = #7f7f7f
# base12 - Bright Red
color9  = #ff6d67
# base14 - Bright Green
color10 = #5ff967
# base13 - Bright Yellow
color11 = #fefb67
# base16 - Bright Blue
color12 = #6871ff
# base17 - Bright Magenta
color13 = #bc35eb
