[colors]
# base16 Bogota
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #f7f1ff
foreground_bold     = #f7f1ff
cursor              = #f7f1ff
cursor_foreground   = #200b0a
background          = #200b0a

color0  = #200b0a # base00 - Black
color1  = #fc618d # base08 - Red
color2  = #7bd88f # base0B - Green
color3  = #ffed89 # base0A - Yellow
color4  = #47e6ff # base0D - Blue
color5  = #ff9999 # base0E - Magenta
color6  = #47e6ff # base0C - Cyan
color7  = #f7f1ff # base05 - White
color8  = #525053 # base03 - Bright Black
color9  = #fc618d # base08 - Bright Red
color10 = #7bd88f # base0B - Bright Green
color11 = #ffed89 # base0A - Bright Yellow
color12 = #47e6ff # base0D - Bright Blue
color13 = #ff9999 # base0E - Bright Magenta
color14 = #47e6ff # base0C - Bright Cyan
color15 = #f7f1ff # base07 - Bright White
color16 = #fea78b # base09
color17 = #b0705e # base0F
color18 = #2f1b1b # base01
color19 = #3a2727 # base02
color20 = #968a91 # base04
color21 = #f9f4ff # base06
