color1  = #fc618d
# base0B - Green
color2  = #7bd88f
# base0A - Yellow
color3  = #ffed89
# base0D - Blue
color4  = #47e6ff
# base0E - Magenta
color5  = #ff9999
# base0C - Cyan
color6  = #47e6ff
# base05 - White
color7  = #f7f1ff
# base03 - Bright Black
color8  = #525053
# base08 - Bright Red
color9  = #fc618d
# base0B - Bright Green
color10 = #7bd88f
# base0A - Bright Yellow
color11 = #ffed89
# base0D - Bright Blue
color12 = #47e6ff
# base0E - Bright Magenta
color13 = #ff9999
# base0C - Bright Cyan
color14 = #47e6ff
# base07 - Bright White
color15 = #f7f1ff
# base09
color16 = #fea78b
# base0F
color17 = #b0705e
# base01
color18 = #2f1b1b
# base02
color19 = #3a2727
