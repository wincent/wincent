[colors]
# base24 Cerulean Signal Light
# Scheme author: Aaron Colichia (https://aaron.colichia.org/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #232b38
foreground_bold     = #232b38
cursor              = #232b38
cursor_foreground   = #f7f9fc
background          = #f7f9fc

color0  = #f7f9fc # base00 - Black
color1  = #b4233d # base08 - Red
color2  = #17795e # base0B - Green
color3  = #6f6300 # base0A - Yellow
color4  = #006fa8 # base0D - Blue
color5  = #a0007d # base0E - Magenta
color6  = #00727e # base0C - Cyan
color7  = #232b38 # base05 - White
color8  = #637287 # base03 - Bright Black
color9  = #c7354d # base12 - Bright Red
color10 = #247b4e # base14 - Bright Green
color11 = #7b6500 # base13 - Bright Yellow
color12 = #0078b5 # base16 - Bright Blue
color13 = #b5149e # base17 - Bright Magenta
color14 = #007787 # base15 - Bright Cyan
color15 = #141d2a # base07 - Bright White
color16 = #9a4f00 # base09
color17 = #7a4e3c # base0F
color18 = #eef4fb # base01
color19 = #dde7f1 # base02
color20 = #566579 # base04
color21 = #202b3a # base06
