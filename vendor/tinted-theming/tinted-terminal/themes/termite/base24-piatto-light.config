[colors]
# base24 Piatto Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #515151
foreground_bold     = #515151
cursor              = #515151
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #b23771
# base0B - Green
color2  = #66781e
# base0A - Yellow
color3  = #cda434
# base0D - Blue
color4  = #3c5ea8
# base0E - Magenta
color5  = #a454b2
# base0C - Cyan
color6  = #1e7878
# base05 - White
color7  = #515151
# base03 - Bright Black
color8  = #c1c1c1
# base12 - Bright Red
color9  = #db3365
# base14 - Bright Green
color10 = #829429
# base13 - Bright Yellow
color11 = #cd6f34
# base16 - Bright Blue
color12 = #3c5ea8
# base17 - Bright Magenta
color13 = #a454b2
# base15 - Bright Cyan
color14 = #175e5e
# base07 - Bright White
color15 = #212121
# base09
color16 = #cd6f34
# base0F
color17 = #591b38
# base01
color18 = #f1f1f1
