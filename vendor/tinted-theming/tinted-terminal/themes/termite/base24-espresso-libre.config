color3  = #43a8ed
# base0D - Blue
color4  = #0066ff
# base0E - Magenta
color5  = #c5656b
# base0C - Cyan
color6  = #05989a
# base05 - White
color7  = #b3b7b0
# base03 - Bright Black
color8  = #737772
# base12 - Bright Red
color9  = #ef2828
# base14 - Bright Green
color10 = #9aff87
# base13 - Bright Yellow
color11 = #fffa5c
# base16 - Bright Blue
color12 = #43a8ed
# base17 - Bright Magenta
color13 = #ff8089
# base15 - Bright Cyan
color14 = #34e2e2
# base07 - Bright White
color15 = #ededec
