[colors]
# base16 OneDark Dark
# Scheme author: olimorris (https://github.com/olimorris)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #abb2bf
foreground_bold     = #abb2bf
cursor              = #abb2bf
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ef596f
# base0B - Green
color2  = #89ca78
# base0A - Yellow
color3  = #e5c07b
# base0D - Blue
color4  = #61afef
# base0E - Magenta
color5  = #d55fde
# base0C - Cyan
color6  = #2bbac5
# base05 - White
color7  = #abb2bf
# base03 - Bright Black
color8  = #434852
# base08 - Bright Red
color9  = #ef596f
# base0B - Bright Green
color10 = #89ca78
# base0A - Bright Yellow
color11 = #e5c07b
# base0D - Bright Blue
color12 = #61afef
# base0E - Bright Magenta
color13 = #d55fde
# base0C - Bright Cyan
color14 = #2bbac5
# base07 - Bright White
color15 = #c8ccd4
# base09
color16 = #d19a66
# base0F
color17 = #be5046
# base01
color18 = #1c1f24
# base02
color19 = #2c313a
# base04
color20 = #565c64
