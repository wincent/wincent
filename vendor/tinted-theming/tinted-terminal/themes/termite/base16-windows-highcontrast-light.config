[colors]
# base16 Windows High Contrast Light
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #545454
foreground_bold     = #545454
cursor              = #545454
cursor_foreground   = #fcfcfc
background          = #fcfcfc

# base00 - Black
color0  = #fcfcfc
# base08 - Red
color1  = #800000
# base0B - Green
color2  = #008000
# base0A - Yellow
color3  = #808000
# base0D - Blue
color4  = #000080
# base0E - Magenta
color5  = #800080
# base0C - Cyan
color6  = #008080
# base05 - White
color7  = #545454
# base03 - Bright Black
color8  = #c0c0c0
# base08 - Bright Red
color9  = #800000
# base0B - Bright Green
color10 = #008000
# base0A - Bright Yellow
color11 = #808000
# base0D - Bright Blue
color12 = #000080
# base0E - Bright Magenta
color13 = #800080
# base0C - Bright Cyan
color14 = #008080
# base07 - Bright White
color15 = #000000
# base09
color16 = #fcfc54
# base0F
color17 = #54fc54
# base01
color18 = #e8e8e8
# base02
color19 = #d4d4d4
# base04
color20 = #7e7e7e
# base06
color21 = #2a2a2a
