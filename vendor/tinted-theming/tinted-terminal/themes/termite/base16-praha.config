color5  = #ff9aa2
# base0C - Cyan
color6  = #8be9fd
# base05 - White
color7  = #ffffff
# base03 - Bright Black
color8  = #6272a4
# base08 - Bright Red
color9  = #ff5555
# base0B - Bright Green
color10 = #b8e6a0
# base0A - Bright Yellow
color11 = #ffe4a3
# base0D - Bright Blue
color12 = #bd93f9
# base0E - Bright Magenta
color13 = #ff9aa2
# base0C - Bright Cyan
color14 = #8be9fd
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff9c7c
# base0F
color17 = #af6e5a
# base01
color18 = #2a2a2a
