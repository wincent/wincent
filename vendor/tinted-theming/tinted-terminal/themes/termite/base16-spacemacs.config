[colors]
# base16 Spacemacs
# Scheme author: Nasser Alshammari (https://github.com/nashamri/spacemacs-theme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a3a3a3
