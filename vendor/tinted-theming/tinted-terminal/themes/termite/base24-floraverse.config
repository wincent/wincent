color3  = #40a4cf
# base0D - Blue
color4  = #1d6da1
# base0E - Magenta
color5  = #b7077e
# base0C - Cyan
color6  = #42a38c
# base05 - White
color7  = #c3af9d
# base03 - Bright Black
color8  = #634e67
# base12 - Bright Red
color9  = #d02063
# base14 - Bright Green
color10 = #b4ce59
# base13 - Bright Yellow
color11 = #fac357
# base16 - Bright Blue
color12 = #40a4cf
# base17 - Bright Magenta
color13 = #f12aae
# base15 - Bright Cyan
color14 = #62caa8
# base07 - Bright White
color15 = #fff5db
# base09
color16 = #cd751c
# base0F
color17 = #320016
