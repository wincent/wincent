[colors]
# base16 standardized-light
# Scheme author: ali (https://github.com/ali-githb/base16-standardized-scheme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #444444
foreground_bold     = #444444
cursor              = #444444
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #d03e3e
# base0B - Green
color2  = #31861f
# base0A - Yellow
color3  = #ad8200
# base0D - Blue
color4  = #3173c5
# base0E - Magenta
color5  = #9e57c2
# base0C - Cyan
color6  = #00998f
# base05 - White
color7  = #444444
# base03 - Bright Black
color8  = #767676
# base08 - Bright Red
color9  = #d03e3e
# base0B - Bright Green
color10 = #31861f
# base0A - Bright Yellow
color11 = #ad8200
# base0D - Bright Blue
color12 = #3173c5
# base0E - Bright Magenta
color13 = #9e57c2
# base0C - Bright Cyan
color14 = #00998f
# base07 - Bright White
color15 = #222222
# base09
color16 = #d7691d
# base0F
color17 = #895025
# base01
color18 = #eeeeee
# base02
color19 = #cccccc
# base04
color20 = #767676
# base06
color21 = #333333
