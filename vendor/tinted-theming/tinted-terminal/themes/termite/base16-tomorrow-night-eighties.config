[colors]
# base16 Tomorrow Night Eighties
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cccccc
foreground_bold     = #cccccc
cursor              = #cccccc
cursor_foreground   = #2d2d2d
background          = #2d2d2d

# base00 - Black
color0  = #2d2d2d
# base08 - Red
color1  = #f2777a
# base0B - Green
color2  = #99cc99
# base0A - Yellow
color3  = #ffcc66
# base0D - Blue
color4  = #6699cc
# base0E - Magenta
color5  = #cc99cc
# base0C - Cyan
color6  = #66cccc
# base05 - White
color7  = #cccccc
# base03 - Bright Black
color8  = #999999
# base08 - Bright Red
color9  = #f2777a
# base0B - Bright Green
color10 = #99cc99
# base0A - Bright Yellow
color11 = #ffcc66
# base0D - Bright Blue
color12 = #6699cc
# base0E - Bright Magenta
color13 = #cc99cc
# base0C - Bright Cyan
color14 = #66cccc
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f99157
# base0F
color17 = #a3685a
# base01
color18 = #393939
# base02
color19 = #515151
# base04
color20 = #b4b7b4
# base06
color21 = #e0e0e0
