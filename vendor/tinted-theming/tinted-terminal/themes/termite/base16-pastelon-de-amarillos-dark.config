color3  = #ffc84a # base0A - Yellow
color4  = #5a9fe6 # base0D - Blue
color5  = #d978cf # base0E - Magenta
color6  = #35c4b6 # base0C - Cyan
color7  = #ffe0a3 # base05 - White
color8  = #a0747c # base03 - Bright Black
color9  = #ff646a # base08 - Bright Red
color10 = #3ccb83 # base0B - Bright Green
color11 = #ffc84a # base0A - Bright Yellow
color12 = #5a9fe6 # base0D - Bright Blue
color13 = #d978cf # base0E - Bright Magenta
color14 = #35c4b6 # base0C - Bright Cyan
color15 = #fff7e6 # base07 - Bright White
color16 = #f99a32 # base09
color17 = #e2764a # base0F
color18 = #2a1424 # base01
color19 = #432031 # base02
color20 = #c39a89 # base04
color21 = #ffebc5 # base06
