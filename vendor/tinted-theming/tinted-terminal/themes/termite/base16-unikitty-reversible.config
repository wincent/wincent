[colors]
# base16 Unikitty Reversible
# Scheme author: Josh W Lewis (@joshwlewis)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c3c2c4
foreground_bold     = #c3c2c4
cursor              = #c3c2c4
cursor_foreground   = #2e2a31
background          = #2e2a31

# base00 - Black
color0  = #2e2a31
# base08 - Red
color1  = #d8137f
# base0B - Green
color2  = #17ad98
# base0A - Yellow
color3  = #dc8a0e
# base0D - Blue
color4  = #7864fa
# base0E - Magenta
color5  = #b33ce8
# base0C - Cyan
color6  = #149bda
# base05 - White
color7  = #c3c2c4
# base03 - Bright Black
color8  = #878589
# base08 - Bright Red
color9  = #d8137f
# base0B - Bright Green
color10 = #17ad98
# base0A - Bright Yellow
color11 = #dc8a0e
# base0D - Bright Blue
color12 = #7864fa
# base0E - Bright Magenta
color13 = #b33ce8
# base0C - Bright Cyan
color14 = #149bda
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #d65407
# base0F
color17 = #d41acd
# base01
color18 = #4b484e
# base02
color19 = #69666b
# base04
color20 = #a5a3a6
# base06
color21 = #e1e0e1
