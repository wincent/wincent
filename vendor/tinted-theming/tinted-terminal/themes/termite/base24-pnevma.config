color4  = #7fa5bd
# base0E - Magenta
color5  = #c79ec4
# base0C - Cyan
color6  = #8adbb4
# base05 - White
color7  = #aeaead
# base03 - Bright Black
color8  = #6b6a67
# base12 - Bright Red
color9  = #d78787
# base14 - Bright Green
color10 = #afbea2
# base13 - Bright Yellow
color11 = #e4c9af
# base16 - Bright Blue
color12 = #a1bdce
# base17 - Bright Magenta
color13 = #d7beda
# base15 - Bright Cyan
color14 = #b1e7dd
# base07 - Bright White
color15 = #efefef
