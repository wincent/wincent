[colors]
# base24 Nocturnal Winter
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dcdcdc
foreground_bold     = #dcdcdc
cursor              = #dcdcdc
cursor_foreground   = #0d0d17
background          = #0d0d17

# base00 - Black
color0  = #0d0d17
# base08 - Red
color1  = #f12d52
# base0B - Green
color2  = #08cd7d
# base0A - Yellow
color3  = #6095fe
# base0D - Blue
color4  = #3081df
# base0E - Magenta
color5  = #fe2a6c
# base0C - Cyan
color6  = #09c87a
# base05 - White
color7  = #dcdcdc
# base03 - Bright Black
color8  = #9e9e9e
# base12 - Bright Red
color9  = #f16c85
# base14 - Bright Green
color10 = #0ae78d
# base13 - Bright Yellow
color11 = #fefb67
# base16 - Bright Blue
color12 = #6095fe
# base17 - Bright Magenta
color13 = #ff78a2
# base15 - Bright Cyan
color14 = #0ae78d
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f5f079
# base0F
color17 = #781629
# base01
color18 = #4c4c4c
# base02
color19 = #7f7f7f
# base04
color20 = #bdbdbd
# base06
color21 = #fbfbfb
