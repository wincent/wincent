color7  = #d1d7e0 # base05 - White
color8  = #656c76 # base03 - Bright Black
color9  = #f47067 # base08 - Bright Red
color10 = #57ab5a # base0B - Bright Green
color11 = #c69026 # base0A - Bright Yellow
color12 = #539bf5 # base0D - Bright Blue
color13 = #b083f0 # base0E - Bright Magenta
color14 = #39c5cf # base0C - Bright Cyan
color15 = #cdd9e5 # base07 - Bright White
