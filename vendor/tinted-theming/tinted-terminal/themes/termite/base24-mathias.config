[colors]
# base24 Mathias
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cacaca
foreground_bold     = #cacaca
cursor              = #cacaca
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #e52222
# base0B - Green
color2  = #a6e32d
# base0A - Yellow
color3  = #5555ff
# base0D - Blue
color4  = #c48dff
# base0E - Magenta
color5  = #fa2573
# base0C - Cyan
color6  = #67d9f0
# base05 - White
color7  = #cacaca
# base03 - Bright Black
color8  = #7c7c7c
# base12 - Bright Red
color9  = #ff5555
# base14 - Bright Green
color10 = #55ff55
# base13 - Bright Yellow
color11 = #ffff55
# base16 - Bright Blue
color12 = #5555ff
# base17 - Bright Magenta
color13 = #ff55ff
# base15 - Bright Cyan
color14 = #55ffff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fc951e
# base0F
color17 = #721111
# base01
color18 = #000000
# base02
color19 = #555555
# base04
color20 = #a3a3a3
