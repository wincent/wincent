color1  = #ec5f67
# base0B - Green
color2  = #80a763
# base0A - Yellow
color3  = #4d83d0
# base0D - Blue
color4  = #5485c0
# base0E - Magenta
color5  = #bf83c0
# base0C - Cyan
color6  = #57c2c0
# base05 - White
color7  = #c7c6c2
# base03 - Bright Black
color8  = #7b7a79
# base12 - Bright Red
color9  = #ff6973
# base14 - Bright Green
color10 = #93d393
# base13 - Bright Yellow
color11 = #ffd156
# base16 - Bright Blue
color12 = #4d83d0
# base17 - Bright Magenta
color13 = #ff55ff
# base15 - Bright Cyan
color14 = #83e8e4
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fdc253
# base0F
color17 = #762f33
# base01
color18 = #15171c
