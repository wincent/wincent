color2  = #2f7462 # base0B - Green
color3  = #506b29 # base0A - Yellow
color4  = #356e8a # base0D - Blue
color5  = #6e5689 # base0E - Magenta
color6  = #356569 # base0C - Cyan
color7  = #2d302b # base05 - White
color8  = #687161 # base03 - Bright Black
color9  = #a34740 # base12 - Bright Red
color10 = #506b29 # base14 - Bright Green
color11 = #875e20 # base13 - Bright Yellow
color12 = #3b6d86 # base16 - Bright Blue
color13 = #8a4f67 # base17 - Bright Magenta
color14 = #3f6464 # base15 - Bright Cyan
color15 = #151613 # base07 - Bright White
color16 = #8b5d27 # base09
color17 = #8a4f67 # base0F
color18 = #ecefe7 # base01
color19 = #cfe4ae # base02
color20 = #4e5149 # base04
color21 = #232420 # base06
