[colors]
# base24 Hardcore
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a9a9a9
foreground_bold     = #a9a9a9
cursor              = #a9a9a9
cursor_foreground   = #111111
background          = #111111

# base00 - Black
color0  = #111111
# base08 - Red
color1  = #ff5555
# base0B - Green
color2  = #98ec65
# base0A - Yellow
color3  = #33bbff
# base0D - Blue
color4  = #00aaff
# base0E - Magenta
color5  = #aa88ff
# base0C - Cyan
color6  = #88ddff
# base05 - White
color7  = #a9a9a9
# base03 - Bright Black
color8  = #636363
# base12 - Bright Red
color9  = #ff8888
# base14 - Bright Green
color10 = #b6f292
# base13 - Bright Yellow
color11 = #ffd966
# base16 - Bright Blue
color12 = #33bbff
# base17 - Bright Magenta
color13 = #cebbff
# base15 - Bright Cyan
color14 = #bbecff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffcc33
# base0F
color17 = #7f2a2a
# base01
color18 = #141414
# base02
color19 = #414141
# base04
color20 = #868686
# base06
color21 = #cccccc
