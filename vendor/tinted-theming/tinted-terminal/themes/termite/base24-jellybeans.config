[colors]
# base24 Jellybeans
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d5d5d5
foreground_bold     = #d5d5d5
cursor              = #d5d5d5
cursor_foreground   = #121212
background          = #121212

# base00 - Black
color0  = #121212
# base08 - Red
color1  = #e27373
# base0B - Green
color2  = #93b979
# base0A - Yellow
color3  = #b1d8f6
# base0D - Blue
color4  = #97bedc
# base0E - Magenta
color5  = #e1c0fa
# base0C - Cyan
color6  = #00988e
# base05 - White
color7  = #d5d5d5
# base03 - Bright Black
color8  = #c5c5c5
# base12 - Bright Red
color9  = #ffa1a1
# base14 - Bright Green
color10 = #bddeab
# base13 - Bright Yellow
color11 = #ffdca0
# base16 - Bright Blue
color12 = #b1d8f6
# base17 - Bright Magenta
color13 = #fbdaff
# base15 - Bright Cyan
color14 = #1ab2a8
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffba7b
# base0F
color17 = #713939
# base01
color18 = #929292
# base02
color19 = #bdbdbd
# base04
color20 = #cdcdcd
# base06
color21 = #dedede
