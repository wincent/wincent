[colors]
# base16 Pasque
# Scheme author: Gabriel Fontes (https://github.com/Misterio77)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dedcdf
foreground_bold     = #dedcdf
cursor              = #dedcdf
cursor_foreground   = #271c3a
background          = #271c3a

# base00 - Black
color0  = #271c3a
# base08 - Red
color1  = #a92258
# base0B - Green
color2  = #c6914b
# base0A - Yellow
color3  = #804ead
# base0D - Blue
color4  = #8e7dc6
# base0E - Magenta
color5  = #953b9d
# base0C - Cyan
color6  = #7263aa
# base05 - White
color7  = #dedcdf
# base03 - Bright Black
color8  = #5d5766
# base08 - Bright Red
color9  = #a92258
# base0B - Bright Green
color10 = #c6914b
# base0A - Bright Yellow
color11 = #804ead
# base0D - Bright Blue
color12 = #8e7dc6
# base0E - Bright Magenta
color13 = #953b9d
# base0C - Bright Cyan
color14 = #7263aa
# base07 - Bright White
color15 = #bbaadd
# base09
color16 = #918889
# base0F
color17 = #59325c
# base01
color18 = #100323
# base02
color19 = #3e2d5c
# base04
color20 = #bebcbf
# base06
color21 = #edeaef
