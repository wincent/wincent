color6  = #00948b
# base05 - White
color7  = #ababab
# base03 - Bright Black
color8  = #777777
# base08 - Bright Red
color9  = #f04339
# base0B - Bright Green
color10 = #7f8b00
# base0A - Bright Yellow
color11 = #bb8801
