color2  = #6562a8
# base0A - Yellow
color3  = #4f9062
# base0D - Blue
color4  = #4d6bb6
# base0E - Magenta
color5  = #716cae
# base0C - Cyan
color6  = #226f68
# base05 - White
color7  = #a4a6a9
# base03 - Bright Black
color8  = #6e6f72
# base08 - Bright Red
color9  = #777abc
# base0B - Bright Green
color10 = #6562a8
# base0A - Bright Yellow
color11 = #4f9062
# base0D - Bright Blue
color12 = #4d6bb6
# base0E - Bright Magenta
color13 = #716cae
# base0C - Bright Cyan
color14 = #226f68
# base07 - Bright White
color15 = #8dbdaa
# base09
color16 = #94929e
# base0F
color17 = #8c70a7
