[colors]
# base16 Neovim Light
# Scheme author: https://github.com/neovim/neovim/blob/master/src/nvim/highlight_group.c
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #14161b
foreground_bold     = #14161b
cursor              = #14161b
cursor_foreground   = #e0e2ea
background          = #e0e2ea

# base00 - Black
color0  = #e0e2ea
# base08 - Red
color1  = #590008
# base0B - Green
color2  = #005523
# base0A - Yellow
color3  = #6b5300
# base0D - Blue
color4  = #004c73
# base0E - Magenta
color5  = #470045
# base0C - Cyan
color6  = #007373
# base05 - White
color7  = #14161b
# base03 - Bright Black
color8  = #4f5258
# base08 - Bright Red
color9  = #590008
# base0B - Bright Green
color10 = #005523
# base0A - Bright Yellow
color11 = #6b5300
# base0D - Bright Blue
color12 = #004c73
# base0E - Bright Magenta
color13 = #470045
# base0C - Bright Cyan
color14 = #007373
# base07 - Bright White
color15 = #07080d
# base09
color16 = #8b4513
# base0F
color17 = #a52a2a
# base01
color18 = #eef1f8
# base02
color19 = #9b9ea4
# base04
color20 = #2c2e33
# base06
color21 = #07080d
