[colors]
# base16 Neovim Light
# Scheme author: https://github.com/neovim/neovim/blob/master/src/nvim/highlight_group.c
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #14161b
foreground_bold     = #14161b
cursor              = #14161b
cursor_foreground   = #e0e2ea
background          = #e0e2ea

color0  = #e0e2ea # base00 - Black
color1  = #590008 # base08 - Red
color2  = #005523 # base0B - Green
color3  = #6b5300 # base0A - Yellow
color4  = #004c73 # base0D - Blue
color5  = #470045 # base0E - Magenta
color6  = #007373 # base0C - Cyan
color7  = #14161b # base05 - White
color8  = #4f5258 # base03 - Bright Black
color9  = #590008 # base08 - Bright Red
color10 = #005523 # base0B - Bright Green
color11 = #6b5300 # base0A - Bright Yellow
color12 = #004c73 # base0D - Bright Blue
color13 = #470045 # base0E - Bright Magenta
color14 = #007373 # base0C - Bright Cyan
color15 = #07080d # base07 - Bright White
color16 = #8b4513 # base09
color17 = #a52a2a # base0F
color18 = #eef1f8 # base01
color19 = #9b9ea4 # base02
color20 = #2c2e33 # base04
color21 = #07080d # base06
