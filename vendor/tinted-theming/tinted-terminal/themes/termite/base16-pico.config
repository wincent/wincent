[colors]
# base16 Pico
# Scheme author: PICO-8 (http://www.lexaloffle.com/pico-8.php)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #5f574f
foreground_bold     = #5f574f
cursor              = #5f574f
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff004d
# base0B - Green
color2  = #00e756
# base0A - Yellow
color3  = #fff024
# base0D - Blue
color4  = #83769c
# base0E - Magenta
color5  = #ff77a8
# base0C - Cyan
color6  = #29adff
# base05 - White
color7  = #5f574f
# base03 - Bright Black
color8  = #008751
# base08 - Bright Red
color9  = #ff004d
# base0B - Bright Green
color10 = #00e756
# base0A - Bright Yellow
color11 = #fff024
# base0D - Bright Blue
color12 = #83769c
# base0E - Bright Magenta
color13 = #ff77a8
# base0C - Bright Cyan
color14 = #29adff
# base07 - Bright White
color15 = #fff1e8
# base09
color16 = #ffa300
# base0F
color17 = #ffccaa
# base01
color18 = #1d2b53
# base02
color19 = #7e2553
# base04
color20 = #ab5236
# base06
color21 = #c2c3c7
