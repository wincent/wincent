color5  = #be9bf8
# base0C - Cyan
color6  = #56d3c1
# base05 - White
color7  = #c3c3d4
# base03 - Bright Black
color8  = #8585ac
# base12 - Bright Red
color9  = #ff91cd
# base14 - Bright Green
color10 = #00e9c0
