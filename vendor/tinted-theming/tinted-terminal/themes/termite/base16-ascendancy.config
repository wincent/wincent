color5  = #fabd2f
# base0C - Cyan
color6  = #8f3f71
# base05 - White
color7  = #d5c7a1
# base03 - Bright Black
color8  = #928374
# base08 - Bright Red
color9  = #d05000
# base0B - Bright Green
color10 = #b8bb26
# base0A - Bright Yellow
color11 = #ffcc1b
# base0D - Bright Blue
color12 = #458588
# base0E - Bright Magenta
color13 = #fabd2f
