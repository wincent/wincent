[colors]
# base16 Apprentice
# Scheme author: Romain Lafourcade (https://github.com/romainl)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #bcbcbc
foreground_bold     = #bcbcbc
cursor              = #bcbcbc
cursor_foreground   = #262626
background          = #262626

# base00 - Black
color0  = #262626
# base08 - Red
color1  = #af5f5f
# base0B - Green
color2  = #5f875f
# base0A - Yellow
color3  = #87875f
# base0D - Blue
color4  = #5f87af
# base0E - Magenta
color5  = #5f5f87
# base0C - Cyan
color6  = #5f8787
# base05 - White
color7  = #bcbcbc
# base03 - Bright Black
color8  = #444444
# base08 - Bright Red
color9  = #af5f5f
# base0B - Bright Green
color10 = #5f875f
# base0A - Bright Yellow
color11 = #87875f
# base0D - Bright Blue
color12 = #5f87af
# base0E - Bright Magenta
color13 = #5f5f87
# base0C - Bright Cyan
color14 = #5f8787
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff8700
# base0F
color17 = #af5f5f
# base01
color18 = #303030
# base02
color19 = #3a3a3a
# base04
color20 = #6c6c6c
# base06
color21 = #dfdfdf
