[colors]
# base16 Digital Rain
# Scheme author: Nathan Byrd (https://github.com/cognitivegears)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #00ff00
foreground_bold     = #00ff00
cursor              = #00ff00
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #c85a46
# base0B - Green
color2  = #64c83c
# base0A - Yellow
color3  = #a67a50
# base0D - Blue
color4  = #5482af
# base0E - Magenta
color5  = #9472b4
# base0C - Cyan
color6  = #468c78
# base05 - White
color7  = #00ff00
# base03 - Bright Black
color8  = #7c8d7c
# base08 - Bright Red
color9  = #c85a46
# base0B - Bright Green
color10 = #64c83c
# base0A - Bright Yellow
color11 = #a67a50
# base0D - Bright Blue
color12 = #5482af
# base0E - Bright Magenta
color13 = #9472b4
# base0C - Bright Cyan
color14 = #468c78
# base07 - Bright White
color15 = #d8e2dc
# base09
color16 = #c86428
# base0F
color17 = #b37c5e
# base01
color18 = #4a806c
# base02
color19 = #4a8d7e
# base04
color20 = #919893
# base06
color21 = #c4cec4
