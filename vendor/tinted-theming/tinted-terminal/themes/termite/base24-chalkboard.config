[colors]
# base24 Chalkboard
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #afafaf
foreground_bold     = #afafaf
cursor              = #afafaf
cursor_foreground   = #29262f
background          = #29262f

# base00 - Black
color0  = #29262f
# base08 - Red
color1  = #c37372
# base0B - Green
color2  = #72c373
# base0A - Yellow
color3  = #aaaadb
# base0D - Blue
color4  = #7372c3
# base0E - Magenta
color5  = #c372c2
# base0C - Cyan
color6  = #72c2c3
# base05 - White
color7  = #afafaf
# base03 - Bright Black
color8  = #5b5b5b
# base12 - Bright Red
color9  = #dbaaaa
# base14 - Bright Green
color10 = #aadbaa
# base13 - Bright Yellow
color11 = #dadbaa
# base16 - Bright Blue
color12 = #aaaadb
# base17 - Bright Magenta
color13 = #dbaada
# base15 - Bright Cyan
color14 = #aadadb
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #c2c372
# base0F
color17 = #613939
# base01
color18 = #000000
# base02
color19 = #323232
# base04
color20 = #858585
# base06
color21 = #d9d9d9
