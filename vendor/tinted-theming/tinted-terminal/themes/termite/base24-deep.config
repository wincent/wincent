[colors]
# base24 deep
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #bcbcbc
foreground_bold     = #bcbcbc
cursor              = #bcbcbc
cursor_foreground   = #080808
background          = #080808

# base00 - Black
color0  = #080808
# base08 - Red
color1  = #d60005
# base0B - Green
color2  = #1cd815
# base0A - Yellow
color3  = #9fa8fe
# base0D - Blue
color4  = #5665fe
# base0E - Magenta
color5  = #af51d9
# base0C - Cyan
color6  = #4fd2d9
# base05 - White
color7  = #bcbcbc
# base03 - Bright Black
color8  = #767676
# base12 - Bright Red
color9  = #fb0006
# base14 - Bright Green
color10 = #21fe17
# base13 - Bright Yellow
color11 = #fedc2b
# base16 - Bright Blue
color12 = #9fa8fe
# base17 - Bright Magenta
color13 = #e099fe
# base15 - Bright Cyan
color14 = #8cf9fe
# base07 - Bright White
color15 = #fffefe
# base09
color16 = #d9bc25
# base0F
color17 = #6b0002
# base01
color18 = #000000
# base02
color19 = #535353
# base04
color20 = #999999
# base06
color21 = #dfdfdf
