[colors]
# base24 Wez
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #aeaeae
foreground_bold     = #aeaeae
cursor              = #aeaeae
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #cc5555
# base0B - Green
color2  = #55cc55
# base0A - Yellow
color3  = #5555ff
# base0D - Blue
color4  = #5455cb
# base0E - Magenta
color5  = #cc55cc
# base0C - Cyan
color6  = #7acaca
# base05 - White
color7  = #aeaeae
# base03 - Bright Black
color8  = #727272
# base12 - Bright Red
color9  = #ff5555
# base14 - Bright Green
color10 = #55ff55
# base13 - Bright Yellow
color11 = #ffff55
# base16 - Bright Blue
color12 = #5555ff
# base17 - Bright Magenta
color13 = #ff55ff
# base15 - Bright Cyan
color14 = #55ffff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #cdcd55
# base0F
color17 = #662a2a
# base01
color18 = #000000
# base02
color19 = #555555
# base04
color20 = #909090
# base06
color21 = #cccccc
