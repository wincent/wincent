[colors]
# base16 Rebecca
# Scheme author: Victor Borja (http://github.com/vic) based on Rebecca Theme (http://github.com/vic/rebecca-theme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #f1eff8
foreground_bold     = #f1eff8
cursor              = #f1eff8
cursor_foreground   = #292a44
background          = #292a44

# base00 - Black
color0  = #292a44
# base08 - Red
color1  = #a0a0c5
# base0B - Green
color2  = #6dfedf
# base0A - Yellow
color3  = #ae81ff
# base0D - Blue
color4  = #2de0a7
# base0E - Magenta
color5  = #7aa5ff
# base0C - Cyan
color6  = #8eaee0
# base05 - White
color7  = #f1eff8
# base03 - Bright Black
color8  = #666699
# base08 - Bright Red
color9  = #a0a0c5
# base0B - Bright Green
color10 = #6dfedf
# base0A - Bright Yellow
color11 = #ae81ff
# base0D - Bright Blue
color12 = #2de0a7
# base0E - Bright Magenta
color13 = #7aa5ff
# base0C - Bright Cyan
color14 = #8eaee0
# base07 - Bright White
color15 = #53495d
# base09
color16 = #efe4a1
# base0F
color17 = #ff79c6
