[colors]
# base16 Hardcore
# Scheme author: Chris Caller
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdcdcd
foreground_bold     = #cdcdcd
cursor              = #cdcdcd
cursor_foreground   = #212121
background          = #212121

# base00 - Black
color0  = #212121
# base08 - Red
color1  = #f92672
# base0B - Green
color2  = #a6e22e
# base0A - Yellow
color3  = #e6db74
# base0D - Blue
color4  = #66d9ef
# base0E - Magenta
color5  = #9e6ffe
# base0C - Cyan
color6  = #708387
# base05 - White
color7  = #cdcdcd
# base03 - Bright Black
color8  = #4a4a4a
# base08 - Bright Red
color9  = #f92672
# base0B - Bright Green
color10 = #a6e22e
# base0A - Bright Yellow
color11 = #e6db74
# base0D - Bright Blue
color12 = #66d9ef
# base0E - Bright Magenta
color13 = #9e6ffe
# base0C - Bright Cyan
color14 = #708387
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fd971f
# base0F
color17 = #e8b882
# base01
color18 = #303030
# base02
color19 = #353535
# base04
color20 = #707070
# base06
color21 = #e5e5e5
