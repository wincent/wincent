color5  = #9d73b0
# base0C - Cyan
color6  = #248886
# base05 - White
color7  = #515151
# base03 - Bright Black
color8  = #c5c5c5
# base12 - Bright Red
color9  = #fc6f72
# base14 - Bright Green
color10 = #98b61b
# base13 - Bright Yellow
color11 = #ffff0a
# base16 - Bright Blue
color12 = #6c9bed
# base17 - Bright Magenta
color13 = #fc7efe
# base15 - Bright Cyan
color14 = #248886
# base07 - Bright White
color15 = #171717
# base09
color16 = #ccb343
# base0F
color17 = #7d292a
