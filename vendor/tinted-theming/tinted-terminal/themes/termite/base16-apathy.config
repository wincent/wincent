color4  = #96883e
# base0E - Magenta
color5  = #4c963e
# base0C - Cyan
color6  = #963e4c
# base05 - White
color7  = #81b5ac
# base03 - Bright Black
color8  = #2b685e
# base08 - Bright Red
color9  = #3e9688
# base0B - Bright Green
color10 = #883e96
# base0A - Bright Yellow
color11 = #3e4c96
# base0D - Bright Blue
color12 = #96883e
