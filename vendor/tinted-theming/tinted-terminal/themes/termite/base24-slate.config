[colors]
# base24 Slate
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #42d3e8
foreground_bold     = #42d3e8
cursor              = #42d3e8
cursor_foreground   = #212121
background          = #212121

# base00 - Black
color0  = #212121
# base08 - Red
color1  = #e1a7bf
# base0B - Green
color2  = #80d778
# base0A - Yellow
color3  = #79afd2
# base0D - Blue
color4  = #254a49
# base0E - Magenta
color5  = #a380d3
# base0C - Cyan
color6  = #14ab9c
# base05 - White
color7  = #42d3e8
# base03 - Bright Black
color8  = #c0f1f8
# base12 - Bright Red
color9  = #ffccd8
# base14 - Bright Green
color10 = #bdffa8
# base13 - Bright Yellow
color11 = #d0cbc9
# base16 - Bright Blue
color12 = #79afd2
# base17 - Bright Magenta
color13 = #c4a7d8
# base15 - Bright Cyan
color14 = #8bdee0
# base07 - Bright White
color15 = #e0e0e0
# base09
color16 = #c4c9bf
# base0F
color17 = #70535f
# base01
color18 = #212121
# base02
color19 = #ffffff
# base04
color20 = #81e2f0
# base06
color21 = #02c4e0
