[colors]
# base24 Flatland
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c5c6c4
foreground_bold     = #c5c6c4
cursor              = #c5c6c4
cursor_foreground   = #1c1e20
background          = #1c1e20

# base00 - Black
color0  = #1c1e20
# base08 - Red
color1  = #f18238
# base0B - Green
color2  = #9ed264
# base0A - Yellow
color3  = #61b8d0
# base0D - Blue
color4  = #4f96be
# base0E - Magenta
color5  = #695abb
# base0C - Cyan
color6  = #d53864
# base05 - White
color7  = #c5c6c4
# base03 - Bright Black
color8  = #545552
# base12 - Bright Red
color9  = #d12a24
# base14 - Bright Green
color10 = #a7d32c
# base13 - Bright Yellow
color11 = #ff8948
# base16 - Bright Blue
color12 = #61b8d0
# base17 - Bright Magenta
color13 = #695abb
# base15 - Bright Cyan
color14 = #d53864
# base07 - Bright White
color15 = #fefffe
# base09
color16 = #f3ef6d
# base0F
color17 = #78411c
# base01
color18 = #1c1d19
# base02
color19 = #1c1d19
# base04
color20 = #8d8e8b
# base06
color21 = #fefffe
