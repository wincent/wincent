[colors]
# base16 Mocha
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0c8c6
foreground_bold     = #d0c8c6
cursor              = #d0c8c6
cursor_foreground   = #3b3228
background          = #3b3228

# base00 - Black
color0  = #3b3228
# base08 - Red
color1  = #cb6077
# base0B - Green
color2  = #beb55b
# base0A - Yellow
color3  = #f4bc87
# base0D - Blue
color4  = #8ab3b5
# base0E - Magenta
color5  = #a89bb9
# base0C - Cyan
color6  = #7bbda4
# base05 - White
color7  = #d0c8c6
# base03 - Bright Black
color8  = #7e705a
# base08 - Bright Red
color9  = #cb6077
# base0B - Bright Green
color10 = #beb55b
# base0A - Bright Yellow
color11 = #f4bc87
# base0D - Bright Blue
color12 = #8ab3b5
# base0E - Bright Magenta
color13 = #a89bb9
# base0C - Bright Cyan
color14 = #7bbda4
# base07 - Bright White
color15 = #f5eeeb
# base09
color16 = #d28b71
# base0F
color17 = #bb9584
# base01
color18 = #534636
# base02
color19 = #645240
# base04
color20 = #b8afad
# base06
color21 = #e9e1dd
