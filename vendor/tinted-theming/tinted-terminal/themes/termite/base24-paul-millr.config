[colors]
# base24 Paul Millr
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a5a5a5
foreground_bold     = #a5a5a5
cursor              = #a5a5a5
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff0000
# base0B - Green
color2  = #79ff0f
# base0A - Yellow
color3  = #709aed
# base0D - Blue
color4  = #386bd7
# base0E - Magenta
color5  = #b349be
# base0C - Cyan
color6  = #66ccff
# base05 - White
color7  = #a5a5a5
# base03 - Bright Black
color8  = #7b7b7b
# base12 - Bright Red
color9  = #ff0080
# base14 - Bright Green
color10 = #66ff66
# base13 - Bright Yellow
color11 = #f3d64e
# base16 - Bright Blue
color12 = #709aed
# base17 - Bright Magenta
color13 = #db67e6
# base15 - Bright Cyan
color14 = #79dff2
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #e7bf00
# base0F
color17 = #7f0000
# base01
color18 = #2a2a2a
# base02
color19 = #666666
# base04
color20 = #909090
# base06
color21 = #bbbbbb
