foreground          = #8b9cbe
foreground_bold     = #8b9cbe
cursor              = #8b9cbe
cursor_foreground   = #17191e
background          = #17191e

# base00 - Black
color0  = #17191e
# base08 - Red
color1  = #ff29a8
# base0B - Green
color2  = #0badff
# base0A - Yellow
color3  = #f0ffaa
# base0D - Blue
color4  = #00eaff
# base0E - Magenta
color5  = #00f6d9
# base0C - Cyan
color6  = #8265ff
# base05 - White
color7  = #8b9cbe
# base03 - Bright Black
color8  = #383a47
# base08 - Bright Red
color9  = #ff29a8
# base0B - Bright Green
color10 = #0badff
# base0A - Bright Yellow
color11 = #f0ffaa
# base0D - Bright Blue
color12 = #00eaff
# base0E - Bright Magenta
color13 = #00f6d9
# base0C - Bright Cyan
color14 = #8265ff
# base07 - Bright White
color15 = #f4f4f7
# base09
color16 = #85ffe0
# base0F
color17 = #ff3d81
# base01
color18 = #22262d
# base02
color19 = #3c3f4c
# base04
color20 = #555e70
# base06
color21 = #b2bfd9
