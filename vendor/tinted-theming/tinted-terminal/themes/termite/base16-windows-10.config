[colors]
# base16 Windows 10
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cccccc
foreground_bold     = #cccccc
cursor              = #cccccc
cursor_foreground   = #0c0c0c
background          = #0c0c0c

# base00 - Black
color0  = #0c0c0c
# base08 - Red
color1  = #e74856
# base0B - Green
color2  = #16c60c
# base0A - Yellow
color3  = #f9f1a5
# base0D - Blue
color4  = #3b78ff
# base0E - Magenta
color5  = #b4009e
# base0C - Cyan
color6  = #61d6d6
# base05 - White
color7  = #cccccc
# base03 - Bright Black
color8  = #767676
# base08 - Bright Red
color9  = #e74856
# base0B - Bright Green
color10 = #16c60c
# base0A - Bright Yellow
color11 = #f9f1a5
# base0D - Bright Blue
color12 = #3b78ff
# base0E - Bright Magenta
color13 = #b4009e
# base0C - Bright Cyan
color14 = #61d6d6
# base07 - Bright White
color15 = #f2f2f2
# base09
color16 = #c19c00
# base0F
color17 = #13a10e
# base01
color18 = #2f2f2f
# base02
color19 = #535353
# base04
color20 = #b9b9b9
# base06
color21 = #dfdfdf
