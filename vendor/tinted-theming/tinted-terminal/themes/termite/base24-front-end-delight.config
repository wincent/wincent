color5  = #f02d4e
# base0C - Cyan
color6  = #3ba0a5
# base05 - White
color7  = #98ac9c
# base03 - Bright Black
color8  = #71ac7c
# base12 - Bright Red
color9  = #f64319
# base14 - Bright Green
color10 = #74eb4c
# base13 - Bright Yellow
color11 = #fcc224
# base16 - Bright Blue
color12 = #3393c9
# base17 - Bright Magenta
color13 = #e75e4e
