[colors]
# base24 Pro
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a8a8a8
foreground_bold     = #a8a8a8
cursor              = #a8a8a8
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #990000
# base0B - Green
color2  = #00a600
# base0A - Yellow
color3  = #0000ff
# base0D - Blue
color4  = #1f08db
# base0E - Magenta
color5  = #b200b2
# base0C - Cyan
color6  = #00a6b2
# base05 - White
color7  = #a8a8a8
# base03 - Bright Black
color8  = #7c7c7c
# base12 - Bright Red
color9  = #e50000
# base14 - Bright Green
color10 = #00d900
# base13 - Bright Yellow
color11 = #e5e500
# base16 - Bright Blue
color12 = #0000ff
# base17 - Bright Magenta
color13 = #e500e5
# base15 - Bright Cyan
color14 = #00e5e5
# base07 - Bright White
color15 = #e5e5e5
# base09
color16 = #999900
# base0F
color17 = #4c0000
# base01
color18 = #000000
# base02
color19 = #666666
# base04
color20 = #929292
# base06
color21 = #bfbfbf
