[colors]
# base24 One Dark
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #abb2bf
foreground_bold     = #abb2bf
cursor              = #abb2bf
cursor_foreground   = #282c34
background          = #282c34

# base00 - Black
color0  = #282c34
# base08 - Red
color1  = #e05561
# base0B - Green
color2  = #8cc265
# base0A - Yellow
color3  = #e6b965
# base0D - Blue
color4  = #4aa5f0
# base0E - Magenta
color5  = #c162de
# base0C - Cyan
color6  = #42b3c2
# base05 - White
color7  = #abb2bf
# base03 - Bright Black
color8  = #545862
# base12 - Bright Red
color9  = #ff616e
# base14 - Bright Green
color10 = #a5e075
# base13 - Bright Yellow
color11 = #f0a45d
# base16 - Bright Blue
color12 = #4dc4ff
# base17 - Bright Magenta
color13 = #de73ff
# base15 - Bright Cyan
color14 = #4cd1e0
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #d18f52
# base0F
color17 = #bf4034
# base01
color18 = #3f4451
# base02
color19 = #4f5666
