[colors]
# base16 Linux VT
# Scheme author: j-c-m (https://github.com/j-c-m/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #aaaaaa
foreground_bold     = #aaaaaa
cursor              = #aaaaaa
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #aa0000
# base0B - Green
color2  = #00aa00
# base0A - Yellow
color3  = #ffff55
# base0D - Blue
color4  = #5555ff
# base0E - Magenta
color5  = #ff55ff
# base0C - Cyan
color6  = #00aaaa
# base05 - White
color7  = #aaaaaa
# base03 - Bright Black
color8  = #555555
# base08 - Bright Red
color9  = #aa0000
# base0B - Bright Green
color10 = #00aa00
# base0A - Bright Yellow
color11 = #ffff55
# base0D - Bright Blue
color12 = #5555ff
# base0E - Bright Magenta
color13 = #ff55ff
# base0C - Bright Cyan
color14 = #00aaaa
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff5555
# base0F
color17 = #aa5500
# base01
color18 = #333333
# base02
color19 = #444444
# base04
color20 = #888888
# base06
color21 = #cccccc
