[colors]
# base16 Synth Midnight Terminal Dark
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c1c3c4
foreground_bold     = #c1c3c4
cursor              = #c1c3c4
cursor_foreground   = #050608
background          = #050608

# base00 - Black
color0  = #050608
# base08 - Red
color1  = #b53b50
# base0B - Green
color2  = #06ea61
# base0A - Yellow
color3  = #c9d364
# base0D - Blue
color4  = #03aeff
# base0E - Magenta
color5  = #ea5ce2
# base0C - Cyan
color6  = #42fff9
# base05 - White
color7  = #c1c3c4
# base03 - Bright Black
color8  = #474849
# base08 - Bright Red
color9  = #b53b50
# base0B - Bright Green
color10 = #06ea61
# base0A - Bright Yellow
color11 = #c9d364
# base0D - Bright Blue
color12 = #03aeff
# base0E - Bright Magenta
color13 = #ea5ce2
# base0C - Bright Cyan
color14 = #42fff9
# base07 - Bright White
color15 = #dddfe0
# base09
color16 = #ea770d
# base0F
color17 = #cd6320
# base01
color18 = #1a1b1c
# base02
color19 = #28292a
# base04
color20 = #a3a5a6
# base06
color21 = #cfd1d2
