color5  = #82034c
# base0C - Cyan
color6  = #f80059
# base05 - White
color7  = #bdb6c5
# base03 - Bright Black
color8  = #7b6d8b
# base08 - Bright Red
color9  = #27d9d5
# base0B - Bright Green
color10 = #c33678
# base0A - Bright Yellow
color11 = #8f6c97
# base0D - Bright Blue
color12 = #bd0152
# base0E - Bright Magenta
color13 = #82034c
