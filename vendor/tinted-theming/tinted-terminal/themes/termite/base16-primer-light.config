[colors]
# base16 Primer Light
# Scheme author: Jimmy Lin
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #2f363d
foreground_bold     = #2f363d
cursor              = #2f363d
cursor_foreground   = #fafbfc
background          = #fafbfc

# base00 - Black
color0  = #fafbfc
# base08 - Red
color1  = #d73a49
# base0B - Green
color2  = #28a745
# base0A - Yellow
color3  = #ffd33d
# base0D - Blue
color4  = #0366d6
# base0E - Magenta
color5  = #ea4aaa
# base0C - Cyan
color6  = #79b8ff
# base05 - White
color7  = #2f363d
# base03 - Bright Black
color8  = #959da5
# base08 - Bright Red
color9  = #d73a49
# base0B - Bright Green
color10 = #28a745
# base0A - Bright Yellow
color11 = #ffd33d
# base0D - Bright Blue
color12 = #0366d6
# base0E - Bright Magenta
color13 = #ea4aaa
# base0C - Bright Cyan
color14 = #79b8ff
# base07 - Bright White
color15 = #1b1f23
# base09
color16 = #f66a0a
# base0F
color17 = #a04100
# base01
color18 = #e1e4e8
# base02
color19 = #d1d5da
# base04
color20 = #444d56
# base06
color21 = #24292e
