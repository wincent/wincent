color3  = #d29922 # base0A - Yellow
color4  = #58a6ff # base0D - Blue
color5  = #be8fff # base0E - Magenta
color6  = #39c5cf # base0C - Cyan
color7  = #d1d7e0 # base05 - White
color8  = #656c76 # base03 - Bright Black
color9  = #ffa198 # base12 - Bright Red
color10 = #56d364 # base14 - Bright Green
color11 = #e3b341 # base13 - Bright Yellow
color12 = #79c0ff # base16 - Bright Blue
color13 = #d2a8ff # base17 - Bright Magenta
color14 = #56d4dd # base15 - Bright Cyan
color15 = #ffffff # base07 - Bright White
color16 = #ffa657 # base09
color17 = #ffa198 # base0F
color18 = #151b23 # base01
color19 = #2f3742 # base02
color20 = #9198a1 # base04
color21 = #f0f6fc # base06
