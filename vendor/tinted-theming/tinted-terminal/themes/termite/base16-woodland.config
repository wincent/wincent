[colors]
# base16 Woodland
# Scheme author: Jay Cornwall (https://jcornwall.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cabcb1
foreground_bold     = #cabcb1
cursor              = #cabcb1
cursor_foreground   = #231e18
background          = #231e18

# base00 - Black
color0  = #231e18
# base08 - Red
color1  = #d35c5c
# base0B - Green
color2  = #b7ba53
# base0A - Yellow
color3  = #e0ac16
# base0D - Blue
color4  = #88a4d3
# base0E - Magenta
color5  = #bb90e2
# base0C - Cyan
color6  = #6eb958
# base05 - White
color7  = #cabcb1
# base03 - Bright Black
color8  = #9d8b70
# base08 - Bright Red
color9  = #d35c5c
# base0B - Bright Green
color10 = #b7ba53
# base0A - Bright Yellow
color11 = #e0ac16
# base0D - Bright Blue
color12 = #88a4d3
# base0E - Bright Magenta
color13 = #bb90e2
# base0C - Bright Cyan
color14 = #6eb958
# base07 - Bright White
color15 = #e4d4c8
# base09
color16 = #ca7f32
# base0F
color17 = #b49368
# base01
color18 = #302b25
# base02
color19 = #48413a
# base04
color20 = #b4a490
# base06
color21 = #d7c8bc
