[colors]
# base16 Cyberpunk
# Scheme author: benjujo
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dcdccc
foreground_bold     = #dcdccc
cursor              = #dcdccc
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff0000
# base0B - Green
color2  = #61ce3c
# base0A - Yellow
color3  = #ffff00
# base0D - Blue
color4  = #4c83ff
# base0E - Magenta
color5  = #ff1493
# base0C - Cyan
color6  = #93e0e3
# base05 - White
color7  = #dcdccc
# base03 - Bright Black
color8  = #4f4f4f
# base08 - Bright Red
color9  = #ff0000
# base0B - Bright Green
color10 = #61ce3c
# base0A - Bright Yellow
color11 = #ffff00
# base0D - Bright Blue
color12 = #4c83ff
# base0E - Bright Magenta
color13 = #ff1493
# base0C - Bright Cyan
color14 = #93e0e3
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffa500
# base0F
color17 = #ff8c00
# base01
color18 = #2b2b2b
# base02
color19 = #383838
# base04
color20 = #8b8989
# base06
color21 = #f8f8f8
