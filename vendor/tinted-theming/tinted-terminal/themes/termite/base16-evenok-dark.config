color4  = #00aff2
# base0E - Magenta
color5  = #9095ff
# base0C - Cyan
color6  = #00bab3
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #505050
# base08 - Bright Red
color9  = #f5708a
# base0B - Bright Green
color10 = #54bc5c
# base0A - Bright Yellow
color11 = #b8a300
# base0D - Bright Blue
color12 = #00aff2
# base0E - Bright Magenta
color13 = #9095ff
# base0C - Bright Cyan
color14 = #00bab3
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ee8122
# base0F
color17 = #d47ada
# base01
color18 = #202020
