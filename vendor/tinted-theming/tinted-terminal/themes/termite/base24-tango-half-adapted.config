[colors]
# base24 Tango Half Adapted
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #4f4f4f
foreground_bold     = #4f4f4f
cursor              = #4f4f4f
cursor_foreground   = #feffff
background          = #feffff

# base00 - Black
color0  = #feffff
# base08 - Red
color1  = #ff0000
# base0B - Green
color2  = #4cc300
# base0A - Yellow
color3  = #e2bf00
# base0D - Blue
color4  = #008df5
# base0E - Magenta
color5  = #a86bb2
# base0C - Cyan
color6  = #00bdc3
# base05 - White
color7  = #4f4f4f
# base03 - Bright Black
color8  = #cccccc
# base12 - Bright Red
color9  = #ff0012
# base14 - Bright Green
color10 = #8af600
# base13 - Bright Yellow
color11 = #ffeb00
# base16 - Bright Blue
color12 = #75beff
# base17 - Bright Magenta
color13 = #d798d0
# base15 - Bright Cyan
color14 = #00f6fa
# base07 - Bright White
color15 = #000000
# base09
color16 = #e28400
# base0F
color17 = #7f0000
# base01
color18 = #f1f1f1
# base02
color19 = #dcdcdc
# base04
color20 = #757575
# base06
color21 = #323232
