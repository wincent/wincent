color2  = #97e123
# base0A - Yellow
color3  = #fef20a
# base0D - Blue
color4  = #0442fe
# base0E - Magenta
color5  = #f800f8
# base0C - Cyan
color6  = #01b6ed
# base05 - White
color7  = #dfdfdf
# base03 - Bright Black
color8  = #525252
# base12 - Bright Red
color9  = #f5669c
# base14 - Bright Green
color10 = #b0e05e
# base13 - Bright Yellow
color11 = #fef26c
# base16 - Bright Blue
color12 = #0442fe
# base17 - Bright Magenta
color13 = #f200f5
# base15 - Bright Cyan
color14 = #50cdfe
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fec50a
# base0F
color17 = #7d141a
# base01
color18 = #323232
