[colors]
# base16 Material Lighter
# Scheme author: Nate Peterson
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #80cbc4
foreground_bold     = #80cbc4
cursor              = #80cbc4
cursor_foreground   = #fafafa
background          = #fafafa

# base00 - Black
color0  = #fafafa
# base08 - Red
color1  = #ff5370
# base0B - Green
color2  = #91b859
# base0A - Yellow
color3  = #ffb62c
# base0D - Blue
color4  = #6182b8
# base0E - Magenta
color5  = #7c4dff
# base0C - Cyan
color6  = #39adb5
# base05 - White
color7  = #80cbc4
# base03 - Bright Black
color8  = #ccd7da
# base08 - Bright Red
color9  = #ff5370
# base0B - Bright Green
color10 = #91b859
# base0A - Bright Yellow
color11 = #ffb62c
# base0D - Bright Blue
color12 = #6182b8
# base0E - Bright Magenta
color13 = #7c4dff
# base0C - Bright Cyan
color14 = #39adb5
# base07 - Bright White
color15 = #000000
# base09
color16 = #f76d47
# base0F
color17 = #e53935
# base01
color18 = #e7eaec
# base02
color19 = #cceae7
# base04
color20 = #8796b0
# base06
color21 = #43a39a
