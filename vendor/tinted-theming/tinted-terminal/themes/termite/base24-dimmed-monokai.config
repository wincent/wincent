color5  = #855b8d
# base0C - Cyan
color6  = #568ea3
# base05 - White
color7  = #acafac
# base03 - Bright Black
color8  = #949593
# base12 - Bright Red
color9  = #fb001e
# base14 - Bright Green
color10 = #0e712e
# base13 - Bright Yellow
color11 = #c37033
# base16 - Bright Blue
color12 = #176ce3
# base17 - Bright Magenta
color13 = #fb0067
