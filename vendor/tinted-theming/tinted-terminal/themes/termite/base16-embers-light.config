color3  = #6d8257
# base0D - Blue
color4  = #6d5782
# base0E - Magenta
color5  = #82576d
# base0C - Cyan
color6  = #576d82
# base05 - White
color7  = #433b32
# base03 - Bright Black
color8  = #8a8075
# base08 - Bright Red
color9  = #826d57
# base0B - Bright Green
color10 = #57826d
# base0A - Bright Yellow
color11 = #6d8257
# base0D - Bright Blue
color12 = #6d5782
# base0E - Bright Magenta
color13 = #82576d
# base0C - Bright Cyan
color14 = #576d82
# base07 - Bright White
color15 = #16130f
# base09
color16 = #828257
# base0F
color17 = #825757
