color3  = #f2ff27
# base0D - Blue
color4  = #489bf0
# base0E - Magenta
color5  = #ff8080
# base0C - Cyan
color6  = #5aebbc
# base05 - White
color7  = #736e55
# base03 - Bright Black
color8  = #504b38
# base08 - Bright Red
color9  = #e35142
# base0B - Bright Green
color10 = #5ceb5a
# base0A - Bright Yellow
color11 = #f2ff27
# base0D - Bright Blue
color12 = #489bf0
# base0E - Bright Magenta
color13 = #ff8080
# base0C - Bright Cyan
color14 = #5aebbc
# base07 - Bright White
color15 = #f8f5de
