[colors]
# base16 Macintosh
# Scheme author: Rebecca Bettencourt (http://www.kreativekorp.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c0c0c0
foreground_bold     = #c0c0c0
cursor              = #c0c0c0
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #dd0907
# base0B - Green
color2  = #1fb714
# base0A - Yellow
color3  = #fbf305
# base0D - Blue
color4  = #0000d3
# base0E - Magenta
color5  = #4700a5
# base0C - Cyan
color6  = #02abea
# base05 - White
color7  = #c0c0c0
# base03 - Bright Black
color8  = #808080
# base08 - Bright Red
color9  = #dd0907
# base0B - Bright Green
color10 = #1fb714
# base0A - Bright Yellow
color11 = #fbf305
# base0D - Bright Blue
color12 = #0000d3
# base0E - Bright Magenta
color13 = #4700a5
# base0C - Bright Cyan
color14 = #02abea
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff6403
# base0F
color17 = #90713a
# base01
color18 = #404040
# base02
color19 = #404040
# base04
color20 = #808080
# base06
color21 = #c0c0c0
