[colors]
# base24 Material Dark
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c3c3c3
foreground_bold     = #c3c3c3
cursor              = #c3c3c3
cursor_foreground   = #222221
background          = #222221

# base00 - Black
color0  = #222221
# base08 - Red
color1  = #b7141e
# base0B - Green
color2  = #457b23
# base0A - Yellow
color3  = #53a4f3
# base0D - Blue
color4  = #134eb2
# base0E - Magenta
color5  = #550087
# base0C - Cyan
color6  = #0e707c
# base05 - White
color7  = #c3c3c3
# base03 - Bright Black
color8  = #6d6d6d
# base12 - Bright Red
color9  = #e83a3f
# base14 - Bright Green
color10 = #7aba39
# base13 - Bright Yellow
color11 = #fee92e
# base16 - Bright Blue
color12 = #53a4f3
# base17 - Bright Magenta
color13 = #a94dbb
# base15 - Bright Cyan
color14 = #26bad1
# base07 - Bright White
color15 = #d8d8d8
# base09
color16 = #f5971d
# base0F
color17 = #5b0a0f
# base01
color18 = #212121
# base02
color19 = #424242
# base04
color20 = #989898
# base06
color21 = #eeeeee
