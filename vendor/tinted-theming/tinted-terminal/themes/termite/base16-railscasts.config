[colors]
# base16 Railscasts
# Scheme author: Ryan Bates (http://railscasts.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e6e1dc
foreground_bold     = #e6e1dc
cursor              = #e6e1dc
cursor_foreground   = #2b2b2b
background          = #2b2b2b

# base00 - Black
color0  = #2b2b2b
# base08 - Red
color1  = #da4939
# base0B - Green
color2  = #a5c261
# base0A - Yellow
color3  = #ffc66d
# base0D - Blue
color4  = #6d9cbe
# base0E - Magenta
color5  = #b6b3eb
# base0C - Cyan
color6  = #519f50
# base05 - White
color7  = #e6e1dc
# base03 - Bright Black
color8  = #5a647e
# base08 - Bright Red
color9  = #da4939
# base0B - Bright Green
color10 = #a5c261
# base0A - Bright Yellow
color11 = #ffc66d
# base0D - Bright Blue
color12 = #6d9cbe
# base0E - Bright Magenta
color13 = #b6b3eb
# base0C - Bright Cyan
color14 = #519f50
# base07 - Bright White
color15 = #f9f7f3
# base09
color16 = #cc7833
# base0F
color17 = #bc9458
# base01
color18 = #272935
# base02
color19 = #3a4055
# base04
color20 = #d4cfc9
# base06
color21 = #f4f1ed
