color2  = #7bd88f
# base0A - Yellow
color3  = #fce566
# base0D - Blue
color4  = #fd9353
# base0E - Magenta
color5  = #948ae3
# base0C - Cyan
color6  = #5ad4e6
# base05 - White
color7  = #f7f1ff
# base03 - Bright Black
color8  = #6b686e
# base08 - Bright Red
color9  = #fc618d
# base0B - Bright Green
color10 = #7bd88f
# base0A - Bright Yellow
color11 = #fce566
# base0D - Bright Blue
color12 = #fd9353
# base0E - Bright Magenta
color13 = #948ae3
# base0C - Bright Cyan
color14 = #5ad4e6
# base07 - Bright White
color15 = #f7f1ff
# base09
color16 = #fca37a
# base0F
color17 = #a66c51
# base01
color18 = #161616
