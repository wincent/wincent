cursor              = #a8a8a8
cursor_foreground   = #2b2b2b
background          = #2b2b2b

# base00 - Black
color0  = #2b2b2b
# base08 - Red
color1  = #cdaf95
# base0B - Green
color2  = #a7ff60
# base0A - Yellow
color3  = #86bdc9
# base0D - Blue
color4  = #75a5b0
# base0E - Magenta
color5  = #ff73fd
# base0C - Cyan
color6  = #59647e
# base05 - White
color7  = #a8a8a8
# base03 - Bright Black
color8  = #7c7c7c
# base12 - Bright Red
color9  = #eecbad
# base14 - Bright Green
color10 = #bcee68
# base13 - Bright Yellow
color11 = #e5e500
# base16 - Bright Blue
color12 = #86bdc9
# base17 - Bright Magenta
color13 = #e500e5
# base15 - Bright Cyan
color14 = #8c9bc3
# base07 - Bright White
color15 = #e5e5e5
# base09
color16 = #bfbb1f
# base0F
color17 = #66574a
# base01
color18 = #000000
# base02
color19 = #666666
# base04
color20 = #929292
# base06
color21 = #bfbfbf
