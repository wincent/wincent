[colors]
# base24 Borland
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d1d1d1
foreground_bold     = #d1d1d1
cursor              = #d1d1d1
cursor_foreground   = #0000a4
background          = #0000a4

# base00 - Black
color0  = #0000a4
# base08 - Red
color1  = #ff6b60
# base0B - Green
color2  = #a7ff60
# base0A - Yellow
color3  = #b5dcfe
# base0D - Blue
color4  = #96cafd
# base0E - Magenta
color5  = #ff73fd
# base0C - Cyan
color6  = #c6c4fd
# base05 - White
color7  = #d1d1d1
# base03 - Bright Black
color8  = #989898
# base12 - Bright Red
color9  = #ffb6b0
# base14 - Bright Green
color10 = #ceffab
# base13 - Bright Yellow
color11 = #ffffcb
# base16 - Bright Blue
color12 = #b5dcfe
# base17 - Bright Magenta
color13 = #ff9cfe
# base15 - Bright Cyan
color14 = #dfdffe
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffffb6
# base0F
color17 = #7f3530
# base01
color18 = #4e4e4e
# base02
color19 = #7c7c7c
# base04
color20 = #b5b5b5
# base06
color21 = #eeeeee
