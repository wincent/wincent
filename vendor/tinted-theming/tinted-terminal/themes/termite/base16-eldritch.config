[colors]
# base16 Eldritch
# Scheme author: https://github.com/eldritch-theme
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #ebfafa
foreground_bold     = #ebfafa
cursor              = #ebfafa
cursor_foreground   = #212337
background          = #212337

# base00 - Black
color0  = #212337
# base08 - Red
color1  = #f16c75
# base0B - Green
color2  = #37f499
# base0A - Yellow
color3  = #f1fc79
# base0D - Blue
color4  = #39ddfd
# base0E - Magenta
color5  = #a48cf2
# base0C - Cyan
color6  = #04d1f9
# base05 - White
color7  = #ebfafa
# base03 - Bright Black
color8  = #7081d0
# base08 - Bright Red
color9  = #f16c75
# base0B - Bright Green
color10 = #37f499
# base0A - Bright Yellow
color11 = #f1fc79
# base0D - Bright Blue
color12 = #39ddfd
# base0E - Bright Magenta
color13 = #a48cf2
# base0C - Bright Cyan
color14 = #04d1f9
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f7c67f
# base0F
color17 = #f265b5
# base01
color18 = #323449
# base02
color19 = #3b4261
