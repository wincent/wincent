[colors]
# base24 Lumina Quartz Light Contrast
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #0e0f13
foreground_bold     = #0e0f13
cursor              = #0e0f13
cursor_foreground   = #fdfdfe
background          = #fdfdfe

color0  = #fdfdfe # base00 - Black
color1  = #660005 # base08 - Red
color2  = #00581f # base0B - Green
color3  = #7e4800 # base0A - Yellow
color4  = #004b7a # base0D - Blue
color5  = #6d3c98 # base0E - Magenta
color6  = #005463 # base0C - Cyan
color7  = #0e0f13 # base05 - White
color8  = #dadadc # base03 - Bright Black
color9  = #470103 # base12 - Bright Red
color10 = #004215 # base14 - Bright Green
color11 = #643800 # base13 - Bright Yellow
color12 = #00385d # base16 - Bright Blue
color13 = #5b0f58 # base17 - Bright Magenta
color14 = #00404b # base15 - Bright Cyan
color15 = #0e0f13 # base07 - Bright White
color16 = #7f3900 # base09
color17 = #72246e # base0F
color18 = #f6f6f8 # base01
color19 = #ebebec # base02
color20 = #868687 # base04
color21 = #474749 # base06
