color3  = #89d3f6
# base0D - Blue
color4  = #4387cf
# base0E - Magenta
color5  = #b86cb4
# base0C - Cyan
color6  = #72d4c6
# base05 - White
color7  = #c0c4c0
# base03 - Bright Black
color8  = #a6a8a6
# base12 - Bright Red
color9  = #c37d62
# base14 - Bright Green
color10 = #83d0a2
# base13 - Bright Yellow
color11 = #fdfdc5
# base16 - Bright Blue
color12 = #89d3f6
# base17 - Bright Magenta
color13 = #fe2c79
# base15 - Bright Cyan
color14 = #82e9da
# base07 - Bright White
color15 = #fdfdf6
