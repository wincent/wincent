[colors]
# base16 Tango
# Scheme author: @Schnouki, based on the Tango Desktop Project
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d3d7cf
foreground_bold     = #d3d7cf
cursor              = #d3d7cf
cursor_foreground   = #2e3436
background          = #2e3436

# base00 - Black
color0  = #2e3436
# base08 - Red
color1  = #cc0000
# base0B - Green
color2  = #4e9a06
# base0A - Yellow
color3  = #c4a000
# base0D - Blue
color4  = #3465a4
# base0E - Magenta
color5  = #75507b
# base0C - Cyan
color6  = #06989a
# base05 - White
color7  = #d3d7cf
# base03 - Bright Black
color8  = #555753
# base08 - Bright Red
color9  = #cc0000
# base0B - Bright Green
color10 = #4e9a06
# base0A - Bright Yellow
color11 = #c4a000
# base0D - Bright Blue
color12 = #3465a4
# base0E - Bright Magenta
color13 = #75507b
# base0C - Bright Cyan
color14 = #06989a
# base07 - Bright White
color15 = #eeeeec
# base09
color16 = #ef2929
# base0F
color17 = #34e2e2
# base01
color18 = #8ae234
# base02
color19 = #fce94f
# base04
color20 = #729fcf
# base06
color21 = #ad7fa8
