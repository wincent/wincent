[colors]
# base16 ShadeSmear Light
# Scheme author: Kyle Giammarco (http://kyle.giammar.co)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #232323
foreground_bold     = #232323
cursor              = #232323
cursor_foreground   = #dbdbdb
background          = #dbdbdb

# base00 - Black
color0  = #dbdbdb
# base08 - Red
color1  = #cc5450
# base0B - Green
color2  = #71983b
# base0A - Yellow
color3  = #307878
# base0D - Blue
color4  = #376388
# base0E - Magenta
color5  = #d7ab54
# base0C - Cyan
color6  = #c57d42
# base05 - White
color7  = #232323
# base03 - Bright Black
color8  = #4e4e4e
# base08 - Bright Red
color9  = #cc5450
# base0B - Bright Green
color10 = #71983b
# base0A - Bright Yellow
color11 = #307878
# base0D - Bright Blue
color12 = #376388
# base0E - Bright Magenta
color13 = #d7ab54
# base0C - Bright Cyan
color14 = #c57d42
# base07 - Bright White
color15 = #e4e4e4
# base09
color16 = #a64270
# base0F
color17 = #6d6d6d
# base01
color18 = #e4e4e4
# base02
color19 = #c0c0c0
# base04
color20 = #1c1c1c
# base06
color21 = #1c1c1c
