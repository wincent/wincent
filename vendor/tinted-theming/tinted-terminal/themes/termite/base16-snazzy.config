[colors]
# base16 Snazzy
# Scheme author: Chawye Hsu (https://github.com/chawyehsu), based on Hyper Snazzy Theme (https://github.com/sindresorhus/hyper-snazzy)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e2e4e5
foreground_bold     = #e2e4e5
cursor              = #e2e4e5
cursor_foreground   = #282a36
background          = #282a36

# base00 - Black
color0  = #282a36
# base08 - Red
color1  = #ff5c57
# base0B - Green
color2  = #5af78e
# base0A - Yellow
color3  = #f3f99d
# base0D - Blue
color4  = #57c7ff
# base0E - Magenta
color5  = #ff6ac1
# base0C - Cyan
color6  = #9aedfe
# base05 - White
color7  = #e2e4e5
# base03 - Bright Black
color8  = #78787e
# base08 - Bright Red
color9  = #ff5c57
# base0B - Bright Green
color10 = #5af78e
# base0A - Bright Yellow
color11 = #f3f99d
# base0D - Bright Blue
color12 = #57c7ff
# base0E - Bright Magenta
color13 = #ff6ac1
# base0C - Bright Cyan
color14 = #9aedfe
# base07 - Bright White
color15 = #f1f1f0
# base09
color16 = #ff9f43
# base0F
color17 = #b2643c
# base01
color18 = #34353e
# base02
color19 = #43454f
# base04
color20 = #a5a5a9
# base06
color21 = #eff0eb
