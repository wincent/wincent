color2  = #57ab5a   # Green
color3  = #c69026  # Yellow
color4  = #539bf5    # Blue
color5  = #b083f0 # Magenta
color6  = #39c5cf    # Cyan
color7  = #f0f6fc   # White
color8  = #656c76   # Bright Black
color9  = #ff938a     # Bright Red
color10 = #6bc46d   # Bright Green
color11 = #daaa3f  # Bright Yellow
color12 = #6cb6ff    # Bright Blue
color13 = #dcbdfb # Bright Magenta
color14 = #56d4dd    # Bright Cyan
color15 = #cdd9e5   # Bright White
