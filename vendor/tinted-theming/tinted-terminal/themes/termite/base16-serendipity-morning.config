[colors]
# base16 Serendipity Morning
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #3f4363
foreground_bold     = #3f4363
cursor              = #3f4363
cursor_foreground   = #f6f7fb
background          = #f6f7fb

color0  = #f6f7fb # base00 - Black
color1  = #c25a4d # base08 - Red
color2  = #2f7aab # base0B - Green
color3  = #785fd0 # base0A - Yellow
color4  = #6288d8 # base0D - Blue
color5  = #785fd0 # base0E - Magenta
color6  = #e58678 # base0C - Cyan
color7  = #3f4363 # base05 - White
color8  = #6d7296 # base03 - Bright Black
color9  = #c25a4d # base08 - Bright Red
color10 = #2f7aab # base0B - Bright Green
color11 = #785fd0 # base0A - Bright Yellow
color12 = #6288d8 # base0D - Bright Blue
color13 = #785fd0 # base0E - Bright Magenta
color14 = #e58678 # base0C - Bright Cyan
color15 = #f6f7fb # base07 - Bright White
color16 = #c25a4d # base09
color17 = #2f7aab # base0F
color18 = #eaebee # base01
color19 = #eaebee # base02
color20 = #505575 # base04
color21 = #3f4363 # base06
