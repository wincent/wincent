[colors]
# base16 Tomorrow
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #373b41
foreground_bold     = #373b41
cursor              = #373b41
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #c82829
# base0B - Green
color2  = #718c00
# base0A - Yellow
color3  = #eab700
# base0D - Blue
color4  = #4271ae
# base0E - Magenta
color5  = #8959a8
# base0C - Cyan
color6  = #3e999f
# base05 - White
color7  = #373b41
# base03 - Bright Black
color8  = #b4b7b4
# base08 - Bright Red
color9  = #c82829
# base0B - Bright Green
color10 = #718c00
# base0A - Bright Yellow
color11 = #eab700
# base0D - Bright Blue
color12 = #4271ae
# base0E - Bright Magenta
color13 = #8959a8
# base0C - Bright Cyan
color14 = #3e999f
# base07 - Bright White
color15 = #1d1f21
# base09
color16 = #f5871f
# base0F
color17 = #a3685a
# base01
color18 = #e0e0e0
# base02
color19 = #c5c8c6
# base04
color20 = #969896
# base06
color21 = #282a2e
