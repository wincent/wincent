[colors]
# base16 PaperColor Dark
# Scheme author: Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #9e9e9e
foreground_bold     = #9e9e9e
cursor              = #9e9e9e
cursor_foreground   = #1c1c1c
background          = #1c1c1c

# base00 - Black
color0  = #1c1c1c
# base08 - Red
color1  = #ff5faf
# base0B - Green
color2  = #5faf5f
# base0A - Yellow
color3  = #ffaf00
# base0D - Blue
color4  = #5fafd7
# base0E - Magenta
color5  = #af87d7
# base0C - Cyan
color6  = #00afaf
# base05 - White
color7  = #9e9e9e
# base03 - Bright Black
color8  = #585858
# base08 - Bright Red
color9  = #ff5faf
# base0B - Bright Green
color10 = #5faf5f
# base0A - Bright Yellow
color11 = #ffaf00
# base0D - Bright Blue
color12 = #5fafd7
# base0E - Bright Magenta
color13 = #af87d7
# base0C - Bright Cyan
color14 = #00afaf
# base07 - Bright White
color15 = #d0d0d0
# base09
color16 = #d7af5f
# base0F
color17 = #af005f
# base01
color18 = #363636
# base02
color19 = #424242
# base04
color20 = #808080
# base06
color21 = #b8b8b8
