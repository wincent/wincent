[colors]
# base16 Tokyo City Terminal Dark
# Scheme author: Michaël Ball
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d8e2ec
foreground_bold     = #d8e2ec
cursor              = #d8e2ec
cursor_foreground   = #171d23
background          = #171d23

# base00 - Black
color0  = #171d23
# base08 - Red
color1  = #d95468
# base0B - Green
color2  = #8bd49c
# base0A - Yellow
color3  = #ebbf83
# base0D - Blue
color4  = #539afc
# base0E - Magenta
color5  = #b62d65
# base0C - Cyan
color6  = #70e1e8
# base05 - White
color7  = #d8e2ec
# base03 - Bright Black
color8  = #526270
# base08 - Bright Red
color9  = #d95468
# base0B - Bright Green
color10 = #8bd49c
# base0A - Bright Yellow
color11 = #ebbf83
# base0D - Bright Blue
color12 = #539afc
# base0E - Bright Magenta
color13 = #b62d65
# base0C - Bright Cyan
color14 = #70e1e8
# base07 - Bright White
color15 = #fbfbfd
# base09
color16 = #ff9e64
# base0F
color17 = #dd9d82
# base01
color18 = #1d252c
# base02
color19 = #28323a
# base04
color20 = #b7c5d3
# base06
color21 = #f6f6f8
