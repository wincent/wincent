[colors]
# base16 Spaceduck
# Scheme author: Guillermo Rodriguez (https://github.com/pineapplegiant), packaged by Gabriel Fontes (https://github.com/Misterio77)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #ecf0c1
foreground_bold     = #ecf0c1
cursor              = #ecf0c1
cursor_foreground   = #16172d
background          = #16172d

# base00 - Black
color0  = #16172d
# base08 - Red
color1  = #e33400
# base0B - Green
color2  = #5ccc96
# base0A - Yellow
color3  = #f2ce00
# base0D - Blue
color4  = #7a5ccc
# base0E - Magenta
color5  = #b3a1e6
# base0C - Cyan
color6  = #00a3cc
# base05 - White
color7  = #ecf0c1
# base03 - Bright Black
color8  = #686f9a
# base08 - Bright Red
color9  = #e33400
# base0B - Bright Green
color10 = #5ccc96
# base0A - Bright Yellow
color11 = #f2ce00
# base0D - Bright Blue
color12 = #7a5ccc
# base0E - Bright Magenta
color13 = #b3a1e6
# base0C - Bright Cyan
color14 = #00a3cc
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #e39400
# base0F
color17 = #ce6f8f
# base01
color18 = #1b1c36
# base02
color19 = #30365f
# base04
color20 = #818596
# base06
color21 = #c1c3cc
