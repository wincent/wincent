[colors]
# base16 Aztec
# Scheme author: TheNeverMan (github.com/TheNeverMan)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #ffda51
foreground_bold     = #ffda51
cursor              = #ffda51
cursor_foreground   = #101600
background          = #101600

# base00 - Black
color0  = #101600
# base08 - Red
color1  = #ee2e00
# base0B - Green
color2  = #63d932
# base0A - Yellow
color3  = #eebb00
# base0D - Blue
color4  = #5b4a9f
# base0E - Magenta
color5  = #883e9f
# base0C - Cyan
color6  = #3d94a5
# base05 - White
color7  = #ffda51
# base03 - Bright Black
color8  = #2e2e05
# base08 - Bright Red
color9  = #ee2e00
# base0B - Bright Green
color10 = #63d932
# base0A - Bright Yellow
color11 = #eebb00
# base0D - Bright Blue
color12 = #5b4a9f
# base0E - Bright Magenta
color13 = #883e9f
# base0C - Bright Cyan
color14 = #3d94a5
# base07 - Bright White
color15 = #ffeba0
# base09
color16 = #ee8800
# base0F
color17 = #a928b9
# base01
color18 = #1a1e01
# base02
color19 = #242604
# base04
color20 = #ffd129
# base06
color21 = #ffe178
