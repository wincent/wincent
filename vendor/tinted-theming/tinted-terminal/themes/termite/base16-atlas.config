color2  = #7fc06e
# base0A - Yellow
color3  = #ffcc1b
# base0D - Blue
color4  = #14747e
# base0E - Magenta
color5  = #9a70a4
# base0C - Cyan
color6  = #5dd7b9
# base05 - White
color7  = #a1a19a
# base03 - Bright Black
color8  = #6c8b91
# base08 - Bright Red
color9  = #ff5a67
# base0B - Bright Green
color10 = #7fc06e
# base0A - Bright Yellow
color11 = #ffcc1b
# base0D - Bright Blue
color12 = #14747e
# base0E - Bright Magenta
color13 = #9a70a4
# base0C - Bright Cyan
color14 = #5dd7b9
# base07 - Bright White
color15 = #fafaf8
# base09
color16 = #f08e48
# base0F
color17 = #c43060
