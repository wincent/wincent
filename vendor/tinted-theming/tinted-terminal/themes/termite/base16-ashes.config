[colors]
# base16 Ashes
# Scheme author: Jannik Siebert (https://github.com/janniks)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c7ccd1
foreground_bold     = #c7ccd1
cursor              = #c7ccd1
cursor_foreground   = #1c2023
background          = #1c2023

# base00 - Black
color0  = #1c2023
# base08 - Red
color1  = #c7ae95
# base0B - Green
color2  = #95c7ae
# base0A - Yellow
color3  = #aec795
# base0D - Blue
color4  = #ae95c7
# base0E - Magenta
color5  = #c795ae
# base0C - Cyan
color6  = #95aec7
# base05 - White
color7  = #c7ccd1
# base03 - Bright Black
color8  = #747c84
# base08 - Bright Red
color9  = #c7ae95
# base0B - Bright Green
color10 = #95c7ae
# base0A - Bright Yellow
color11 = #aec795
# base0D - Bright Blue
color12 = #ae95c7
# base0E - Bright Magenta
color13 = #c795ae
# base0C - Bright Cyan
color14 = #95aec7
# base07 - Bright White
color15 = #f3f4f5
# base09
color16 = #c7c795
# base0F
color17 = #c79595
# base01
color18 = #393f45
# base02
color19 = #565e65
# base04
color20 = #adb3ba
# base06
color21 = #dfe2e5
