color2  = #499180
# base0A - Yellow
color3  = #fdb11f
# base0D - Blue
color4  = #498091
# base0E - Magenta
color5  = #9bc0c8
# base0C - Cyan
color6  = #66d9ef
# base05 - White
color7  = #c7c7a5
# base03 - Bright Black
color8  = #555e5f
# base08 - Bright Red
color9  = #ff4658
# base0B - Bright Green
color10 = #499180
# base0A - Bright Yellow
color11 = #fdb11f
# base0D - Bright Blue
color12 = #498091
# base0E - Bright Magenta
color13 = #9bc0c8
# base0C - Bright Cyan
color14 = #66d9ef
# base07 - Bright White
color15 = #e1eaef
