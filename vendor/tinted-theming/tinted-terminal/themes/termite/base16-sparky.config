[colors]
# base16 Sparky
# Scheme author: Leila Sother (https://github.com/mixcoac)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #f4f5f0
foreground_bold     = #f4f5f0
cursor              = #f4f5f0
cursor_foreground   = #072b31
background          = #072b31

# base00 - Black
color0  = #072b31
# base08 - Red
color1  = #ff585d
# base0B - Green
color2  = #78d64b
# base0A - Yellow
color3  = #fbdd40
# base0D - Blue
color4  = #4698cb
# base0E - Magenta
color5  = #d59ed7
# base0C - Cyan
color6  = #2dccd3
# base05 - White
color7  = #f4f5f0
# base03 - Bright Black
color8  = #003b49
# base08 - Bright Red
color9  = #ff585d
# base0B - Bright Green
color10 = #78d64b
# base0A - Bright Yellow
color11 = #fbdd40
# base0D - Bright Blue
color12 = #4698cb
# base0E - Bright Magenta
color13 = #d59ed7
# base0C - Bright Cyan
color14 = #2dccd3
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff8f1c
# base0F
color17 = #9b704d
# base01
color18 = #00313c
# base02
color19 = #003c46
# base04
color20 = #00778b
# base06
color21 = #f5f5f1
