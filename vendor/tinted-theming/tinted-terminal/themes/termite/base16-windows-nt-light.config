[colors]
# base16 Windows NT Light
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #808080
foreground_bold     = #808080
cursor              = #808080
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #800000
# base0B - Green
color2  = #008000
# base0A - Yellow
color3  = #808000
# base0D - Blue
color4  = #000080
# base0E - Magenta
color5  = #800080
# base0C - Cyan
color6  = #008080
# base05 - White
color7  = #808080
# base03 - Bright Black
color8  = #c0c0c0
# base08 - Bright Red
color9  = #800000
# base0B - Bright Green
color10 = #008000
# base0A - Bright Yellow
color11 = #808000
# base0D - Bright Blue
color12 = #000080
# base0E - Bright Magenta
color13 = #800080
# base0C - Bright Cyan
color14 = #008080
# base07 - Bright White
color15 = #000000
# base09
color16 = #ffff00
# base0F
color17 = #00ff00
# base01
color18 = #eaeaea
# base02
color19 = #d5d5d5
# base04
color20 = #a0a0a0
# base06
color21 = #404040
