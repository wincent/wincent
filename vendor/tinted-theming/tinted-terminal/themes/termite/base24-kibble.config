[colors]
# base24 Kibble
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c0b3c0
foreground_bold     = #c0b3c0
cursor              = #c0b3c0
cursor_foreground   = #0e100a
background          = #0e100a

# base00 - Black
color0  = #0e100a
# base08 - Red
color1  = #c70031
# base0B - Green
color2  = #29cf13
# base0A - Yellow
color3  = #97a4f7
# base0D - Blue
color4  = #3449d1
# base0E - Magenta
color5  = #8400ff
# base0C - Cyan
color6  = #0798ab
# base05 - White
color7  = #c0b3c0
# base03 - Bright Black
color8  = #7c777c
# base12 - Bright Red
color9  = #f01578
# base14 - Bright Green
color10 = #6ce05c
# base13 - Bright Yellow
color11 = #f3f79e
# base16 - Bright Blue
color12 = #97a4f7
# base17 - Bright Magenta
color13 = #c495f0
# base15 - Bright Cyan
color14 = #68f2e0
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #d8e30e
# base0F
color17 = #630018
# base01
color18 = #4d4d4d
# base02
color19 = #5a5a5a
# base04
color20 = #9e959e
# base06
color21 = #e2d1e3
