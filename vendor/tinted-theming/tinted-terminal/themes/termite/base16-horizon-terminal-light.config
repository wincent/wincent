[colors]
# base16 Horizon Terminal Light
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #403c3d
foreground_bold     = #403c3d
cursor              = #403c3d
cursor_foreground   = #fdf0ed
background          = #fdf0ed

# base00 - Black
color0  = #fdf0ed
# base08 - Red
color1  = #e95678
# base0B - Green
color2  = #29d398
# base0A - Yellow
color3  = #fadad1
# base0D - Blue
color4  = #26bbd9
# base0E - Magenta
color5  = #ee64ac
# base0C - Cyan
color6  = #59e1e3
# base05 - White
color7  = #403c3d
# base03 - Bright Black
color8  = #bdb3b1
# base08 - Bright Red
color9  = #e95678
# base0B - Bright Green
color10 = #29d398
# base0A - Bright Yellow
color11 = #fadad1
# base0D - Bright Blue
color12 = #26bbd9
# base0E - Bright Magenta
color13 = #ee64ac
# base0C - Bright Cyan
color14 = #59e1e3
# base07 - Bright White
color15 = #201c1d
# base09
color16 = #f9cec3
# base0F
color17 = #f9cbbe
# base01
color18 = #fadad1
# base02
color19 = #f9cbbe
# base04
color20 = #948c8a
# base06
color21 = #302c2d
