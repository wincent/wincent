[colors]
# base24 Dark Plus
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c5c5c5
foreground_bold     = #c5c5c5
cursor              = #c5c5c5
cursor_foreground   = #0e0e0e
background          = #0e0e0e

# base00 - Black
color0  = #0e0e0e
# base08 - Red
color1  = #cd3131
# base0B - Green
color2  = #0dbc79
# base0A - Yellow
color3  = #3b8eea
# base0D - Blue
color4  = #2472c8
# base0E - Magenta
color5  = #bc3fbc
# base0C - Cyan
color6  = #11a8cd
# base05 - White
color7  = #c5c5c5
# base03 - Bright Black
color8  = #858585
# base12 - Bright Red
color9  = #f14c4c
# base14 - Bright Green
color10 = #23d18b
# base13 - Bright Yellow
color11 = #f5f543
# base16 - Bright Blue
color12 = #3b8eea
# base17 - Bright Magenta
color13 = #d670d6
# base15 - Bright Cyan
color14 = #29b8db
# base07 - Bright White
color15 = #e5e5e5
# base09
color16 = #e5e510
# base0F
color17 = #661818
# base01
color18 = #000000
# base02
color19 = #666666
# base04
color20 = #a5a5a5
# base06
color21 = #e5e5e5
