cursor              = #c8c5c4
cursor_foreground   = #212224
background          = #212224

# base00 - Black
color0  = #212224
# base08 - Red
color1  = #cf0d17
# base0B - Green
color2  = #128033
# base0A - Yellow
color3  = #4fc2fd
# base0D - Blue
color4  = #006ab3
# base0E - Magenta
color5  = #6a2674
# base0C - Cyan
color6  = #384563
# base05 - White
color7  = #c8c5c4
# base03 - Bright Black
color8  = #807672
# base12 - Bright Red
color9  = #ef7d17
# base14 - Bright Green
color10 = #b1d130
# base13 - Bright Yellow
color11 = #fff11f
# base16 - Bright Blue
color12 = #4fc2fd
# base17 - Bright Magenta
color13 = #de0070
# base15 - Bright Cyan
color14 = #5c4f49
# base07 - Bright White
color15 = #fefffe
# base09
color16 = #ffca3d
# base0F
color17 = #67060b
# base01
color18 = #000000
# base02
color19 = #5c4f49
# base04
color20 = #a49e9b
