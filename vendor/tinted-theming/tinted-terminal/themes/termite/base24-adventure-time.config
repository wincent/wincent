[colors]
# base24 Adventure Time
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdc3bf
foreground_bold     = #cdc3bf
cursor              = #cdc3bf
cursor_foreground   = #1e1c44
background          = #1e1c44

# base00 - Black
color0  = #1e1c44
# base08 - Red
color1  = #bc0013
# base0B - Green
color2  = #49b117
# base0A - Yellow
color3  = #1896c6
# base0D - Blue
color4  = #0f49c6
# base0E - Magenta
color5  = #665992
# base0C - Cyan
color6  = #6fa497
# base05 - White
color7  = #cdc3bf
# base03 - Bright Black
color8  = #7893bf
# base12 - Bright Red
color9  = #fc5e59
# base14 - Bright Green
color10 = #9dff6e
# base13 - Bright Yellow
color11 = #efc11a
# base16 - Bright Blue
color12 = #1896c6
# base17 - Bright Magenta
color13 = #9a5952
# base15 - Bright Cyan
color14 = #c8f9f3
# base07 - Bright White
color15 = #f5f4fb
# base09
color16 = #e6741d
# base0F
color17 = #5e0009
# base01
color18 = #050404
# base02
color19 = #4e7bbf
# base04
color20 = #a3abbf
# base06
color21 = #f8dbc0
