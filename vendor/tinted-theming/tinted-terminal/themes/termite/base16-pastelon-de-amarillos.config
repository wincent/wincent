[colors]
# base16 Pastelón de Amarillos
# Scheme author: Richard Martinez (https://sonofmartinus.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #432c3b
foreground_bold     = #432c3b
cursor              = #432c3b
cursor_foreground   = #fff4d6
background          = #fff4d6

color0  = #fff4d6 # base00 - Black
color1  = #bd3548 # base08 - Red
color2  = #167451 # base0B - Green
color3  = #946400 # base0A - Yellow
color4  = #1e5da8 # base0D - Blue
color5  = #8d3f89 # base0E - Magenta
color6  = #007270 # base0C - Cyan
color7  = #432c3b # base05 - White
color8  = #80616b # base03 - Bright Black
color9  = #bd3548 # base08 - Bright Red
color10 = #167451 # base0B - Bright Green
color11 = #946400 # base0A - Bright Yellow
color12 = #1e5da8 # base0D - Bright Blue
color13 = #8d3f89 # base0E - Bright Magenta
color14 = #007270 # base0C - Bright Cyan
color15 = #1c0f20 # base07 - Bright White
color16 = #ad570f # base09
color17 = #7c3528 # base0F
color18 = #f2d083 # base01
color19 = #d69b45 # base02
color20 = #684653 # base04
color21 = #2f1c2e # base06
