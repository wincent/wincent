[colors]
# base16 Soft Server
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e4dee9
foreground_bold     = #e4dee9
cursor              = #e4dee9
cursor_foreground   = #211e2a
background          = #211e2a

# base00 - Black
color0  = #211e2a
# base08 - Red
color1  = #e965a5
# base0B - Green
color2  = #b1f2a7
# base0A - Yellow
color3  = #ebde76
# base0D - Blue
color4  = #95a6f4
# base0E - Magenta
color5  = #ff79c6
# base0C - Cyan
color6  = #b3f4f3
# base05 - White
color7  = #e4dee9
# base03 - Bright Black
color8  = #6e6780
# base08 - Bright Red
color9  = #e965a5
# base0B - Bright Green
color10 = #b1f2a7
# base0A - Bright Yellow
color11 = #ebde76
# base0D - Bright Blue
color12 = #95a6f4
# base0E - Bright Magenta
color13 = #ff79c6
# base0C - Bright Cyan
color14 = #b3f4f3
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f4b870
# base0F
color17 = #bd93f9
# base01
color18 = #2c2737
# base02
color19 = #3f3951
# base04
color20 = #8a829e
# base06
color21 = #f2e8f0
