[colors]
# base16 Github Dark High Contrast
# Scheme author: Tinted Theming (https://github.com/tinted-theming)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d1d7e0
foreground_bold     = #d1d7e0
cursor              = #d1d7e0
cursor_foreground   = #0d1117
background          = #0d1117

color0  = #0d1117 # base00 - Black
color1  = #ff9492 # base08 - Red
color2  = #28d751 # base0B - Green
color3  = #f0b72f # base0A - Yellow
color4  = #71b7ff # base0D - Blue
color5  = #cb9eff # base0E - Magenta
color6  = #39c5cf # base0C - Cyan
color7  = #d1d7e0 # base05 - White
color8  = #656c76 # base03 - Bright Black
color9  = #ff9492 # base08 - Bright Red
color10 = #28d751 # base0B - Bright Green
color11 = #f0b72f # base0A - Bright Yellow
color12 = #71b7ff # base0D - Bright Blue
color13 = #cb9eff # base0E - Bright Magenta
color14 = #39c5cf # base0C - Bright Cyan
color15 = #ffffff # base07 - Bright White
color16 = #ffb757 # base09
color17 = #ffb1af # base0F
color18 = #151b23 # base01
color19 = #2f3742 # base02
color20 = #9198a1 # base04
color21 = #f0f6fc # base06
