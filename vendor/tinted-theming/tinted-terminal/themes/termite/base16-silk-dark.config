color1  = #fb6953
# base0B - Green
color2  = #73d8ad
# base0A - Yellow
color3  = #fce380
# base0D - Blue
color4  = #46bddd
# base0E - Magenta
color5  = #756b8a
# base0C - Cyan
color6  = #3fb2b9
# base05 - White
color7  = #c7dbdd
# base03 - Bright Black
color8  = #587073
# base08 - Bright Red
color9  = #fb6953
# base0B - Bright Green
color10 = #73d8ad
# base0A - Bright Yellow
color11 = #fce380
# base0D - Bright Blue
color12 = #46bddd
# base0E - Bright Magenta
color13 = #756b8a
# base0C - Bright Cyan
color14 = #3fb2b9
# base07 - Bright White
color15 = #d2faff
# base09
color16 = #fcab74
# base0F
color17 = #9b647b
# base01
color18 = #1d494e
