[colors]
# base16 Atelier Dune Light
# Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #6e6b5e
foreground_bold     = #6e6b5e
cursor              = #6e6b5e
