color2  = #60ac39
# base0A - Yellow
color3  = #ae9513
# base0D - Blue
color4  = #6684e1
# base0E - Magenta
color5  = #b854d4
# base0C - Cyan
color6  = #1fad83
# base05 - White
color7  = #6e6b5e
# base03 - Bright Black
color8  = #999580
# base08 - Bright Red
color9  = #d73737
# base0B - Bright Green
color10 = #60ac39
# base0A - Bright Yellow
color11 = #ae9513
# base0D - Bright Blue
color12 = #6684e1
# base0E - Bright Magenta
color13 = #b854d4
# base0C - Bright Cyan
color14 = #1fad83
# base07 - Bright White
color15 = #20201d
# base09
color16 = #b65611
# base0F
color17 = #d43552
# base01
color18 = #e8e4cf
