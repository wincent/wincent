[colors]
# base24 Man Page
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #b2b2b2
foreground_bold     = #b2b2b2
cursor              = #b2b2b2
cursor_foreground   = #fef49c
background          = #fef49c

# base00 - Black
color0  = #fef49c
# base08 - Red
color1  = #cc0000
# base0B - Green
color2  = #00a600
# base0A - Yellow
color3  = #0000ff
# base0D - Blue
color4  = #0000b2
# base0E - Magenta
color5  = #b200b2
# base0C - Cyan
color6  = #00a6b2
# base05 - White
color7  = #b2b2b2
# base03 - Bright Black
color8  = #7f7f7f
# base12 - Bright Red
color9  = #e50000
# base14 - Bright Green
color10 = #00d900
# base13 - Bright Yellow
color11 = #e5e500
# base16 - Bright Blue
color12 = #0000ff
# base17 - Bright Magenta
color13 = #e500e5
# base15 - Bright Cyan
color14 = #00e5e5
# base07 - Bright White
color15 = #e5e5e5
# base09
color16 = #999900
# base0F
color17 = #660000
# base01
color18 = #000000
# base02
color19 = #666666
# base04
color20 = #999999
# base06
color21 = #cccccc
