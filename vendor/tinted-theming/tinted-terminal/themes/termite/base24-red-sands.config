color5  = #bb00bb
# base0C - Cyan
color6  = #00bbbb
# base05 - White
color7  = #a1a1a1
# base03 - Bright Black
color8  = #6e6e6e
# base12 - Bright Red
color9  = #bb0000
# base14 - Bright Green
color10 = #00bb00
# base13 - Bright Yellow
color11 = #e7b000
# base16 - Bright Blue
color12 = #0071ae
# base17 - Bright Magenta
color13 = #ff55ff
