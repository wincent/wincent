[colors]
# base16 Summerfruit Light
# Scheme author: Christopher Corley (http://christop.club/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #101010
foreground_bold     = #101010
cursor              = #101010
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #ff0086
# base0B - Green
color2  = #00c918
# base0A - Yellow
color3  = #aba800
# base0D - Blue
color4  = #3777e6
# base0E - Magenta
color5  = #ad00a1
# base0C - Cyan
color6  = #1faaaa
# base05 - White
color7  = #101010
# base03 - Bright Black
color8  = #b0b0b0
# base08 - Bright Red
color9  = #ff0086
# base0B - Bright Green
color10 = #00c918
# base0A - Bright Yellow
color11 = #aba800
# base0D - Bright Blue
color12 = #3777e6
# base0E - Bright Magenta
color13 = #ad00a1
# base0C - Bright Cyan
color14 = #1faaaa
# base07 - Bright White
color15 = #202020
# base09
color16 = #fd8900
# base0F
color17 = #cc6633
# base01
color18 = #e0e0e0
# base02
color19 = #d0d0d0
# base04
color20 = #000000
# base06
color21 = #151515
