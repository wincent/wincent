[colors]
# base16 Nord Light
# Scheme author: threddast, based on fuxialexander&#39;s doom-nord-light-theme (Doom Emacs)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #2e3440
foreground_bold     = #2e3440
cursor              = #2e3440
cursor_foreground   = #e5e9f0
background          = #e5e9f0

# base00 - Black
color0  = #e5e9f0
