[colors]
# base16 Sakura
# Scheme author: Misterio77 (http://github.com/Misterio77)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #564448
foreground_bold     = #564448
cursor              = #564448
cursor_foreground   = #feedf3
background          = #feedf3

# base00 - Black
color0  = #feedf3
# base08 - Red
color1  = #df2d52
# base0B - Green
color2  = #2e916d
# base0A - Yellow
color3  = #c29461
# base0D - Blue
color4  = #006e93
# base0E - Magenta
color5  = #5e2180
# base0C - Cyan
color6  = #1d8991
# base05 - White
color7  = #564448
# base03 - Bright Black
color8  = #755f64
# base08 - Bright Red
color9  = #df2d52
# base0B - Bright Green
color10 = #2e916d
# base0A - Bright Yellow
color11 = #c29461
# base0D - Bright Blue
color12 = #006e93
# base0E - Bright Magenta
color13 = #5e2180
# base0C - Bright Cyan
color14 = #1d8991
# base07 - Bright White
color15 = #33292b
# base09
color16 = #f6661e
# base0F
color17 = #ba0d35
# base01
color18 = #f8e2e7
