cursor              = #98c1a3
cursor_foreground   = #131f1f
background          = #131f1f

# base00 - Black
color0  = #131f1f
# base08 - Red
color1  = #d7586e
# base0B - Green
color2  = #59d678
# base0A - Yellow
color3  = #dfe754
# base0D - Blue
color4  = #4ed2d2
# base0E - Magenta
color5  = #a874e0
# base0C - Cyan
color6  = #76dbd2
# base05 - White
color7  = #98c1a3
# base03 - Bright Black
color8  = #3e5c53
# base08 - Bright Red
color9  = #d7586e
# base0B - Bright Green
color10 = #59d678
# base0A - Bright Yellow
color11 = #dfe754
# base0D - Bright Blue
color12 = #4ed2d2
# base0E - Bright Magenta
color13 = #a874e0
# base0C - Bright Cyan
color14 = #76dbd2
# base07 - Bright White
color15 = #aacbcb
# base09
color16 = #e6b466
# base0F
color17 = #c05a8f
# base01
color18 = #213132
# base02
color19 = #273d3c
