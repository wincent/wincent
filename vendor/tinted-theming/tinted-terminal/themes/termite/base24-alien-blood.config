color3  = #00a9df
# base0D - Blue
color4  = #2f697f
# base0E - Magenta
color5  = #47577e
# base0C - Cyan
color6  = #317f76
# base05 - White
color7  = #5a6f5c
# base03 - Bright Black
color8  = #46542a
# base12 - Bright Red
color9  = #df8008
# base14 - Bright Green
color10 = #18e000
# base13 - Bright Yellow
color11 = #bde000
# base16 - Bright Blue
color12 = #00a9df
# base17 - Bright Magenta
color13 = #0058df
# base15 - Bright Cyan
color14 = #00dfc3
# base07 - Bright White
color15 = #73f990
