color5  = #c792ea
# base0C - Cyan
color6  = #89ddff
# base05 - White
color7  = #eeffff
# base03 - Bright Black
color8  = #546e7a
# base08 - Bright Red
color9  = #f07178
# base0B - Bright Green
color10 = #c3e88d
# base0A - Bright Yellow
color11 = #ffcb6b
# base0D - Bright Blue
color12 = #82aaff
# base0E - Bright Magenta
color13 = #c792ea
# base0C - Bright Cyan
color14 = #89ddff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f78c6c
# base0F
color17 = #ff5370
