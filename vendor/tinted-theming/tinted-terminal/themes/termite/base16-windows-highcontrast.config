[colors]
# base16 Windows High Contrast
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c0c0c0
foreground_bold     = #c0c0c0
cursor              = #c0c0c0
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #fc5454
# base0B - Green
color2  = #54fc54
# base0A - Yellow
color3  = #fcfc54
# base0D - Blue
color4  = #5454fc
# base0E - Magenta
color5  = #fc54fc
# base0C - Cyan
color6  = #54fcfc
# base05 - White
color7  = #c0c0c0
# base03 - Bright Black
color8  = #545454
# base08 - Bright Red
color9  = #fc5454
# base0B - Bright Green
color10 = #54fc54
# base0A - Bright Yellow
color11 = #fcfc54
# base0D - Bright Blue
color12 = #5454fc
# base0E - Bright Magenta
color13 = #fc54fc
# base0C - Bright Cyan
color14 = #54fcfc
# base07 - Bright White
color15 = #fcfcfc
# base09
color16 = #808000
# base0F
color17 = #008000
# base01
color18 = #1c1c1c
# base02
color19 = #383838
# base04
color20 = #a2a2a2
# base06
color21 = #dedede
