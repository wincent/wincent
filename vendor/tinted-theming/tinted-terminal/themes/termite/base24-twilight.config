color2  = #afb979
# base0A - Yellow
color3  = #5a5d61
# base0D - Blue
color4  = #444649
# base0E - Magenta
color5  = #b4be7b
# base0C - Cyan
color6  = #778284
# base05 - White
color7  = #c8c8a7
# base03 - Bright Black
color8  = #5c5c51
# base12 - Bright Red
color9  = #dd7c4c
# base14 - Bright Green
color10 = #cbd88c
# base13 - Bright Yellow
color11 = #e1c47d
# base16 - Bright Blue
color12 = #5a5d61
# base17 - Bright Magenta
color13 = #d0db8e
# base15 - Bright Cyan
color14 = #8a989a
# base07 - Bright White
color15 = #feffd3
# base09
color16 = #c2a86c
# base0F
color17 = #603621
