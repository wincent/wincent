color2  = #2aa298
# base0A - Yellow
color3  = #dac801
# base0D - Blue
color4  = #4876d6
# base0E - Magenta
color5  = #403f53
# base0C - Cyan
color6  = #08916a
# base05 - White
color7  = #585b5b
# base03 - Bright Black
color8  = #b1b4b4
# base12 - Bright Red
color9  = #f76e6e
# base14 - Bright Green
color10 = #49d0c5
# base13 - Bright Yellow
color11 = #dac26b
# base16 - Bright Blue
color12 = #5ca7e4
# base17 - Bright Magenta
color13 = #697098
# base15 - Bright Cyan
color14 = #00c990
# base07 - Bright White
color15 = #011627
# base09
color16 = #daaa01
# base0F
color17 = #69211f
# base01
color18 = #e5e6e6
