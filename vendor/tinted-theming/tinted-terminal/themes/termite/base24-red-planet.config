color4  = #69809e
# base0E - Magenta
color5  = #896492
# base0C - Cyan
color6  = #5b8390
# base05 - White
color7  = #a4998c
# base03 - Bright Black
color8  = #7b7773
# base12 - Bright Red
color9  = #b55242
# base14 - Bright Green
color10 = #869985
# base13 - Bright Yellow
color11 = #ebeb91
# base16 - Bright Blue
color12 = #60827e
# base17 - Bright Magenta
color13 = #de4873
# base15 - Bright Cyan
color14 = #38add8
