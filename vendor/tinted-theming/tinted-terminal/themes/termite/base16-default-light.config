[colors]
# base16 Default Light
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #383838
foreground_bold     = #383838
cursor              = #383838
cursor_foreground   = #f8f8f8
background          = #f8f8f8

# base00 - Black
color0  = #f8f8f8
# base08 - Red
color1  = #ab4642
# base0B - Green
color2  = #a1b56c
# base0A - Yellow
color3  = #f7ca88
# base0D - Blue
color4  = #7cafc2
# base0E - Magenta
color5  = #ba8baf
# base0C - Cyan
color6  = #86c1b9
# base05 - White
color7  = #383838
# base03 - Bright Black
color8  = #b8b8b8
# base08 - Bright Red
color9  = #ab4642
# base0B - Bright Green
color10 = #a1b56c
# base0A - Bright Yellow
color11 = #f7ca88
# base0D - Bright Blue
color12 = #7cafc2
# base0E - Bright Magenta
color13 = #ba8baf
# base0C - Bright Cyan
color14 = #86c1b9
# base07 - Bright White
color15 = #181818
# base09
color16 = #dc9656
# base0F
color17 = #a16946
# base01
color18 = #e8e8e8
# base02
color19 = #d8d8d8
# base04
color20 = #585858
# base06
color21 = #282828
