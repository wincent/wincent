color2  = #9ece6a
# base0A - Yellow
color3  = #0db9d7
# base0D - Blue
color4  = #2ac3de
# base0E - Magenta
color5  = #bb9af7
# base0C - Cyan
color6  = #b4f9f8
# base05 - White
color7  = #a9b1d6
# base03 - Bright Black
color8  = #444b6a
# base08 - Bright Red
color9  = #c0caf5
# base0B - Bright Green
color10 = #9ece6a
# base0A - Bright Yellow
color11 = #0db9d7
# base0D - Bright Blue
color12 = #2ac3de
# base0E - Bright Magenta
color13 = #bb9af7
# base0C - Bright Cyan
color14 = #b4f9f8
# base07 - Bright White
color15 = #d5d6db
# base09
color16 = #a9b1d6
# base0F
color17 = #f7768e
