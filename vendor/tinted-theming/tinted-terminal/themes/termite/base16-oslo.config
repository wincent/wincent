[colors]
# base16 Oslo
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #abb2bf
foreground_bold     = #abb2bf
cursor              = #abb2bf
cursor_foreground   = #3f4451
background          = #3f4451

# base00 - Black
color0  = #3f4451
# base08 - Red
color1  = #e05561
# base0B - Green
color2  = #8cc265
# base0A - Yellow
color3  = #d18f52
# base0D - Blue
color4  = #4aa5f0
# base0E - Magenta
color5  = #c162de
# base0C - Cyan
color6  = #42b3c2
# base05 - White
color7  = #abb2bf
# base03 - Bright Black
color8  = #6c727f
# base08 - Bright Red
color9  = #e05561
# base0B - Bright Green
color10 = #8cc265
# base0A - Bright Yellow
color11 = #d18f52
# base0D - Bright Blue
color12 = #4aa5f0
# base0E - Bright Magenta
color13 = #c162de
# base0C - Bright Cyan
color14 = #42b3c2
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #d8725a
# base0F
color17 = #a26257
# base01
color18 = #474c59
# base02
color19 = #4c515e
# base04
color20 = #7a808e
# base06
color21 = #bcc1cc
