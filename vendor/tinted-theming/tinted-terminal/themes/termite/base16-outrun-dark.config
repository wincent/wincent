[colors]
# base16 Outrun Dark
# Scheme author: Hugo Delahousse (http://github.com/hugodelahousse/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d0fa
foreground_bold     = #d0d0fa
cursor              = #d0d0fa
cursor_foreground   = #00002a
background          = #00002a

# base00 - Black
color0  = #00002a
# base08 - Red
color1  = #ff4242
# base0B - Green
color2  = #59f176
# base0A - Yellow
color3  = #f3e877
# base0D - Blue
color4  = #66b0ff
# base0E - Magenta
color5  = #f10596
# base0C - Cyan
color6  = #0ef0f0
# base05 - White
color7  = #d0d0fa
# base03 - Bright Black
color8  = #50507a
# base08 - Bright Red
color9  = #ff4242
# base0B - Bright Green
color10 = #59f176
# base0A - Bright Yellow
color11 = #f3e877
# base0D - Bright Blue
color12 = #66b0ff
# base0E - Bright Magenta
color13 = #f10596
# base0C - Bright Cyan
color14 = #0ef0f0
# base07 - Bright White
color15 = #f5f5ff
# base09
color16 = #fc8d28
# base0F
color17 = #f003ef
# base01
color18 = #20204a
# base02
color19 = #30305a
# base04
color20 = #b0b0da
# base06
color21 = #e0e0ff
