[colors]
# base16 OneDark
# Scheme author: Lalit Magant (http://github.com/tilal6991)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #abb2bf
foreground_bold     = #abb2bf
cursor              = #abb2bf
cursor_foreground   = #282c34
background          = #282c34

# base00 - Black
color0  = #282c34
# base08 - Red
color1  = #e06c75
# base0B - Green
color2  = #98c379
# base0A - Yellow
color3  = #e5c07b
# base0D - Blue
color4  = #61afef
# base0E - Magenta
color5  = #c678dd
# base0C - Cyan
color6  = #56b6c2
# base05 - White
color7  = #abb2bf
# base03 - Bright Black
color8  = #545862
# base08 - Bright Red
color9  = #e06c75
# base0B - Bright Green
color10 = #98c379
# base0A - Bright Yellow
color11 = #e5c07b
# base0D - Bright Blue
color12 = #61afef
# base0E - Bright Magenta
color13 = #c678dd
# base0C - Bright Cyan
color14 = #56b6c2
# base07 - Bright White
color15 = #c8ccd4
# base09
color16 = #d19a66
# base0F
color17 = #be5046
# base01
color18 = #353b45
# base02
color19 = #3e4451
