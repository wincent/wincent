[colors]
# base24 Brogrammer
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c1c8d7
foreground_bold     = #c1c8d7
cursor              = #c1c8d7
cursor_foreground   = #131313
background          = #131313

# base00 - Black
color0  = #131313
# base08 - Red
color1  = #f71118
# base0B - Green
color2  = #2cc55d
# base0A - Yellow
color3  = #0f80d5
# base0D - Blue
color4  = #2a84d2
# base0E - Magenta
color5  = #4e59b7
# base0C - Cyan
color6  = #0f80d5
# base05 - White
color7  = #c1c8d7
# base03 - Bright Black
color8  = #343d50
# base12 - Bright Red
color9  = #de342e
# base14 - Bright Green
color10 = #1dd260
# base13 - Bright Yellow
color11 = #f2bd09
# base16 - Bright Blue
color12 = #509bdc
# base17 - Bright Magenta
color13 = #524fb9
# base15 - Bright Cyan
color14 = #289af0
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ecb90f
# base0F
color17 = #7b080c
# base01
color18 = #1f1f1f
# base02
color19 = #2a3141
# base04
color20 = #d6dae4
