color3  = #23d7d7
# base0D - Blue
color4  = #338f86
# base0E - Magenta
color5  = #9413e5
# base0C - Cyan
color6  = #23d7d7
# base05 - White
color7  = #bebebd
# base03 - Bright Black
color8  = #787877
# base12 - Bright Red
color9  = #ff3242
# base14 - Bright Green
color10 = #74cd68
# base13 - Bright Yellow
color11 = #ffb929
# base16 - Bright Blue
color12 = #23d7d7
# base17 - Bright Magenta
color13 = #ff37ff
# base15 - Bright Cyan
color14 = #00ede1
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffad29
# base0F
color17 = #7f2121
# base01
color18 = #000000
