[colors]
# base24 Birds Of Paradise
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdbe9b
foreground_bold     = #cdbe9b
cursor              = #cdbe9b
cursor_foreground   = #2a1e1d
background          = #2a1e1d

# base00 - Black
color0  = #2a1e1d
# base08 - Red
color1  = #be2d26
# base0B - Green
color2  = #6ba08a
# base0A - Yellow
color3  = #b8d3ed
# base0D - Blue
color4  = #5a86ac
# base0E - Magenta
color5  = #ab80a6
# base0C - Cyan
color6  = #74a5ac
# base05 - White
color7  = #cdbe9b
# base03 - Bright Black
color8  = #ab8664
# base12 - Bright Red
color9  = #e84526
# base14 - Bright Green
color10 = #94d7ba
# base13 - Bright Yellow
color11 = #d0d04f
# base16 - Bright Blue
color12 = #b8d3ed
# base17 - Bright Magenta
color13 = #d09dca
# base15 - Bright Cyan
color14 = #92ced6
# base07 - Bright White
color15 = #fff9d4
# base09
color16 = #e99c29
# base0F
color17 = #5f1613
# base01
color18 = #573d25
# base02
color19 = #9a6b49
# base04
color20 = #bca280
# base06
color21 = #dfdab7
