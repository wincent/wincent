[colors]
# base24 Wild Cherry
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #bfe1d8
foreground_bold     = #bfe1d8
cursor              = #bfe1d8
cursor_foreground   = #1f1626
background          = #1f1626

# base00 - Black
color0  = #1f1626
# base08 - Red
color1  = #d94085
# base0B - Green
color2  = #2ab250
# base0A - Yellow
color3  = #2f8bb9
# base0D - Blue
color4  = #883cdc
# base0E - Magenta
color5  = #ececec
# base0C - Cyan
color6  = #c1b8b7
# base05 - White
color7  = #bfe1d8
# base03 - Bright Black
color8  = #3fb3ce
# base12 - Bright Red
color9  = #da6bab
# base14 - Bright Green
color10 = #f4dba5
# base13 - Bright Yellow
color11 = #eac066
# base16 - Bright Blue
color12 = #2f8bb9
# base17 - Bright Magenta
color13 = #ae636b
# base15 - Bright Cyan
color14 = #ff919d
# base07 - Bright White
color15 = #e4838d
# base09
color16 = #ffd16f
# base0F
color17 = #6c2042
# base01
color18 = #000506
# base02
color19 = #009cc9
# base04
color20 = #7fcad3
# base06
color21 = #fff8dd
