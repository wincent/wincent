[colors]
# base24 Berlin
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cccccc
foreground_bold     = #cccccc
cursor              = #cccccc
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #999999
# base0B - Green
color2  = #bbbbbb
# base0A - Yellow
color3  = #dddddd
# base0D - Blue
color4  = #888888
# base0E - Magenta
color5  = #aaaaaa
# base0C - Cyan
color6  = #cccccc
# base05 - White
color7  = #cccccc
# base03 - Bright Black
color8  = #333333
# base12 - Bright Red
color9  = #bbbbbb
# base14 - Bright Green
color10 = #dddddd
# base13 - Bright Yellow
color11 = #ffffff
# base16 - Bright Blue
color12 = #aaaaaa
# base17 - Bright Magenta
color13 = #cccccc
# base15 - Bright Cyan
color14 = #eeeeee
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #bbbbbb
# base0F
color17 = #7a7a7a
# base01
color18 = #0e0e0e
# base02
color19 = #181818
# base04
color20 = #707070
# base06
color21 = #d6d6d6
