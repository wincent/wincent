[colors]
# base24 Berlin
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cccccc
foreground_bold     = #cccccc
cursor              = #cccccc
cursor_foreground   = #000000
background          = #000000

color0  = #000000 # base00 - Black
color1  = #999999 # base08 - Red
color2  = #bbbbbb # base0B - Green
color3  = #dddddd # base0A - Yellow
color4  = #888888 # base0D - Blue
color5  = #aaaaaa # base0E - Magenta
color6  = #cccccc # base0C - Cyan
color7  = #cccccc # base05 - White
color8  = #333333 # base03 - Bright Black
color9  = #bbbbbb # base12 - Bright Red
color10 = #dddddd # base14 - Bright Green
color11 = #ffffff # base13 - Bright Yellow
color12 = #aaaaaa # base16 - Bright Blue
color13 = #cccccc # base17 - Bright Magenta
color14 = #eeeeee # base15 - Bright Cyan
color15 = #ffffff # base07 - Bright White
color16 = #bbbbbb # base09
color17 = #7a7a7a # base0F
color18 = #0e0e0e # base01
color19 = #181818 # base02
color20 = #707070 # base04
color21 = #d6d6d6 # base06
