[colors]
# base16 Flexoki Light
# Scheme author: Steph Ango (https://github.com/kepano/flexoki)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #403e3c
foreground_bold     = #403e3c
cursor              = #403e3c
cursor_foreground   = #fffcf0
background          = #fffcf0

# base00 - Black
color0  = #fffcf0
# base08 - Red
color1  = #af3029
# base0B - Green
color2  = #66800b
# base0A - Yellow
color3  = #ad8301
# base0D - Blue
color4  = #205ea6
# base0E - Magenta
color5  = #5e409d
# base0C - Cyan
color6  = #24837b
# base05 - White
color7  = #403e3c
# base03 - Bright Black
color8  = #cecdc3
# base08 - Bright Red
color9  = #af3029
# base0B - Bright Green
color10 = #66800b
# base0A - Bright Yellow
color11 = #ad8301
# base0D - Bright Blue
color12 = #205ea6
# base0E - Bright Magenta
color13 = #5e409d
# base0C - Bright Cyan
color14 = #24837b
# base07 - Bright White
color15 = #100f0f
# base09
color16 = #bc5215
# base0F
color17 = #a02f6f
# base01
color18 = #f2f0e5
# base02
color19 = #e6e4d9
# base04
color20 = #9f9d96
# base06
color21 = #282726
