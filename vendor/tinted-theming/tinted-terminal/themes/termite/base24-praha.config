foreground          = #ffffff
foreground_bold     = #ffffff
cursor              = #ffffff
cursor_foreground   = #1a1a1a
background          = #1a1a1a

color0  = #1a1a1a # base00 - Black
color1  = #ff5555 # base08 - Red
color2  = #b8e6a0 # base0B - Green
color3  = #ffe4a3 # base0A - Yellow
color4  = #bd93f9 # base0D - Blue
color5  = #ff9aa2 # base0E - Magenta
color6  = #8be9fd # base0C - Cyan
color7  = #ffffff # base05 - White
color8  = #6272a4 # base03 - Bright Black
color9  = #ff6e6e # base12 - Bright Red
color10 = #b8e6a0 # base14 - Bright Green
color11 = #ffe4a3 # base13 - Bright Yellow
color12 = #d6acff # base16 - Bright Blue
color13 = #ff9aa2 # base17 - Bright Magenta
color14 = #a4ffff # base15 - Bright Cyan
color15 = #ffffff # base07 - Bright White
color16 = #ff9c7c # base09
color17 = #af6e5a # base0F
color18 = #2a2a2a # base01
color19 = #353535 # base02
color20 = #989898 # base04
color21 = #ffffff # base06
