color8  = #838085
# base08 - Bright Red
color9  = #d8137f
# base0B - Bright Green
color10 = #17ad98
# base0A - Bright Yellow
color11 = #dc8a0e
# base0D - Bright Blue
color12 = #796af5
# base0E - Bright Magenta
color13 = #bb60ea
# base0C - Bright Cyan
color14 = #149bda
# base07 - Bright White
color15 = #f5f4f7
