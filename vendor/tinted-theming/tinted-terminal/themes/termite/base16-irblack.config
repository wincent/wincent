[colors]
# base16 IR Black
# Scheme author: Timothée Poisot (http://timotheepoisot.fr)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #b5b3aa
foreground_bold     = #b5b3aa
cursor              = #b5b3aa
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff6c60
# base0B - Green
color2  = #a8ff60
# base0A - Yellow
color3  = #ffffb6
# base0D - Blue
color4  = #96cbfe
# base0E - Magenta
color5  = #ff73fd
# base0C - Cyan
color6  = #c6c5fe
# base05 - White
color7  = #b5b3aa
# base03 - Bright Black
color8  = #6c6c66
# base08 - Bright Red
color9  = #ff6c60
# base0B - Bright Green
color10 = #a8ff60
# base0A - Bright Yellow
color11 = #ffffb6
# base0D - Bright Blue
color12 = #96cbfe
# base0E - Bright Magenta
color13 = #ff73fd
# base0C - Bright Cyan
color14 = #c6c5fe
# base07 - Bright White
color15 = #fdfbee
# base09
color16 = #e9c062
# base0F
color17 = #b18a3d
# base01
color18 = #242422
# base02
color19 = #484844
# base04
color20 = #918f88
# base06
color21 = #d9d7cc
