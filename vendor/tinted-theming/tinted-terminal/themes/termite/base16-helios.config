[colors]
# base16 Helios
# Scheme author: Alex Meyer (https://github.com/reyemxela)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d5d5d5
foreground_bold     = #d5d5d5
cursor              = #d5d5d5
cursor_foreground   = #1d2021
background          = #1d2021

# base00 - Black
color0  = #1d2021
# base08 - Red
color1  = #d72638
# base0B - Green
color2  = #88b92d
# base0A - Yellow
color3  = #f19d1a
# base0D - Blue
color4  = #1e8bac
# base0E - Magenta
color5  = #be4264
# base0C - Cyan
color6  = #1ba595
# base05 - White
color7  = #d5d5d5
# base03 - Bright Black
color8  = #6f7579
# base08 - Bright Red
color9  = #d72638
# base0B - Bright Green
color10 = #88b92d
# base0A - Bright Yellow
color11 = #f19d1a
# base0D - Bright Blue
color12 = #1e8bac
# base0E - Bright Magenta
color13 = #be4264
# base0C - Bright Cyan
color14 = #1ba595
# base07 - Bright White
color15 = #e5e5e5
# base09
color16 = #eb8413
# base0F
color17 = #c85e0d
# base01
color18 = #383c3e
# base02
color19 = #53585b
# base04
color20 = #cdcdcd
# base06
color21 = #dddddd
