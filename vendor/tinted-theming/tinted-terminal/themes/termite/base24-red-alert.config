color2  = #71be6b
# base0A - Yellow
color3  = #65a9f0
# base0D - Blue
color4  = #479bed
# base0E - Magenta
color5  = #e878d6
# base0C - Cyan
color6  = #6bbeb8
# base05 - White
color7  = #aaaaaa
# base03 - Bright Black
color8  = #525252
# base12 - Bright Red
color9  = #e02453
# base14 - Bright Green
color10 = #aff08b
# base13 - Bright Yellow
color11 = #dfddb7
# base16 - Bright Blue
color12 = #65a9f0
# base17 - Bright Magenta
color13 = #ddb7df
# base15 - Bright Cyan
color14 = #b7dfdd
# base07 - Bright White
color15 = #ffffff
