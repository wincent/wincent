[colors]
# base16 Brewer
# Scheme author: Timothée Poisot (http://github.com/tpoisot)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #b7b8b9
foreground_bold     = #b7b8b9
cursor              = #b7b8b9
cursor_foreground   = #0c0d0e
background          = #0c0d0e

# base00 - Black
color0  = #0c0d0e
# base08 - Red
color1  = #e31a1c
# base0B - Green
color2  = #31a354
# base0A - Yellow
color3  = #dca060
# base0D - Blue
color4  = #3182bd
# base0E - Magenta
color5  = #756bb1
# base0C - Cyan
color6  = #80b1d3
# base05 - White
color7  = #b7b8b9
# base03 - Bright Black
color8  = #737475
# base08 - Bright Red
color9  = #e31a1c
# base0B - Bright Green
color10 = #31a354
# base0A - Bright Yellow
color11 = #dca060
# base0D - Bright Blue
color12 = #3182bd
# base0E - Bright Magenta
color13 = #756bb1
# base0C - Bright Cyan
color14 = #80b1d3
# base07 - Bright White
color15 = #fcfdfe
# base09
color16 = #e6550d
# base0F
color17 = #b15928
# base01
color18 = #2e2f30
# base02
color19 = #515253
# base04
color20 = #959697
# base06
color21 = #dadbdc
