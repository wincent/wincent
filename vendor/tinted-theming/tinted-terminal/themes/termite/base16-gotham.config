[colors]
# base16 Gotham
# Scheme author: Andrea Leopardi (arranged by Brett Jones)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #599cab
foreground_bold     = #599cab
cursor              = #599cab
cursor_foreground   = #0c1014
background          = #0c1014

# base00 - Black
color0  = #0c1014
# base08 - Red
color1  = #c23127
# base0B - Green
color2  = #33859e
# base0A - Yellow
color3  = #edb443
# base0D - Blue
color4  = #195466
# base0E - Magenta
color5  = #888ca6
# base0C - Cyan
color6  = #2aa889
# base05 - White
color7  = #599cab
# base03 - Bright Black
color8  = #0a3749
# base08 - Bright Red
color9  = #c23127
# base0B - Bright Green
color10 = #33859e
# base0A - Bright Yellow
color11 = #edb443
# base0D - Bright Blue
color12 = #195466
# base0E - Bright Magenta
color13 = #888ca6
# base0C - Bright Cyan
color14 = #2aa889
# base07 - Bright White
color15 = #d3ebe9
# base09
color16 = #d26937
# base0F
color17 = #4e5166
# base01
color18 = #11151c
# base02
color19 = #091f2e
# base04
color20 = #245361
# base06
color21 = #99d1ce
