[colors]
# base16 Serendipity Sunset
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dee0ef
foreground_bold     = #dee0ef
cursor              = #dee0ef
cursor_foreground   = #202231
background          = #202231

color0  = #202231 # base00 - Black
color1  = #d1918f # base08 - Red
color2  = #709bbd # base0B - Green
color3  = #a392dc # base0A - Yellow
color4  = #a0b6e8 # base0D - Blue
color5  = #a392dc # base0E - Magenta
color6  = #d6b4b4 # base0C - Cyan
color7  = #dee0ef # base05 - White
color8  = #8d8f9e # base03 - Bright Black
color9  = #d1918f # base08 - Bright Red
color10 = #709bbd # base0B - Bright Green
color11 = #a392dc # base0A - Bright Yellow
color12 = #a0b6e8 # base0D - Bright Blue
color13 = #a392dc # base0E - Bright Magenta
color14 = #d6b4b4 # base0C - Bright Cyan
color15 = #202231 # base07 - Bright White
color16 = #d1918f # base09
color17 = #709bbd # base0F
color18 = #272938 # base01
color19 = #272938 # base02
color20 = #6b6d7c # base04
color21 = #dee0ef # base06
