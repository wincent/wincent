[colors]
# base24 Spacedust
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdc7a6
foreground_bold     = #cdc7a6
cursor              = #cdc7a6
cursor_foreground   = #0a1e24
background          = #0a1e24

# base00 - Black
color0  = #0a1e24
# base08 - Red
color1  = #e35a00
# base0B - Green
color2  = #5cab96
# base0A - Yellow
color3  = #67a0cd
# base0D - Blue
color4  = #0e548b
# base0E - Magenta
color5  = #e35a00
# base0C - Cyan
color6  = #06afc7
# base05 - White
color7  = #cdc7a6
# base03 - Bright Black
color8  = #897558
# base12 - Bright Red
color9  = #ff8a39
# base14 - Bright Green
color10 = #adcab8
# base13 - Bright Yellow
color11 = #ffc777
# base16 - Bright Blue
color12 = #67a0cd
# base17 - Bright Magenta
color13 = #ff8a39
# base15 - Bright Cyan
color14 = #83a6b3
# base07 - Bright White
color15 = #fefff0
# base09
color16 = #e3cd7b
# base0F
color17 = #712d00
# base01
color18 = #6e5246
# base02
color19 = #674c31
# base04
color20 = #ab9e7f
# base06
color21 = #f0f1ce
