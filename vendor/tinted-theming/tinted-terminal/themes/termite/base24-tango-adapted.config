[colors]
# base24 Tango Adapted
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #4f4f4f
foreground_bold     = #4f4f4f
cursor              = #4f4f4f
cursor_foreground   = #feffff
background          = #feffff

# base00 - Black
color0  = #feffff
# base08 - Red
color1  = #ff0000
# base0B - Green
color2  = #59d500
# base0A - Yellow
color3  = #efca00
# base0D - Blue
color4  = #00a1ff
# base0E - Magenta
color5  = #c17ecb
# base0C - Cyan
color6  = #00d0d6
# base05 - White
color7  = #4f4f4f
# base03 - Bright Black
color8  = #cccccc
# base12 - Bright Red
color9  = #ff0012
# base14 - Bright Green
color10 = #93fe00
# base13 - Bright Yellow
color11 = #fff021
# base16 - Bright Blue
color12 = #88c9ff
# base17 - Bright Magenta
color13 = #e8a6e1
# base15 - Bright Cyan
color14 = #00fdff
# base07 - Bright White
color15 = #000000
# base09
color16 = #ef9b00
# base0F
color17 = #7f0000
# base01
color18 = #f1f1f1
# base02
color19 = #dcdcdc
# base04
color20 = #757575
# base06
color21 = #323232
