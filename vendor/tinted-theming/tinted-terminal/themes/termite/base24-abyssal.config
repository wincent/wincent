color3  = #ffcc00 # base0A - Yellow
color4  = #01a0e4 # base0D - Blue
color5  = #ab5ccb # base0E - Magenta
color6  = #40e0d0 # base0C - Cyan
color7  = #e0e4e7 # base05 - White
color8  = #4f5b66 # base03 - Bright Black
color9  = #feac57 # base12 - Bright Red
color10 = #4ce070 # base14 - Bright Green
color11 = #ffee50 # base13 - Bright Yellow
color12 = #4b97c8 # base16 - Bright Blue
color13 = #ba8efa # base17 - Bright Magenta
color14 = #20b2aa # base15 - Bright Cyan
color15 = #f7f7ff # base07 - Bright White
color16 = #ff9f10 # base09
color17 = #dd5500 # base0F
color18 = #1b2b34 # base01
color19 = #343d46 # base02
color20 = #65737e # base04
