[colors]
# base16 Shapeshifter
# Scheme author: Tyler Benziger (http://tybenz.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #102015
foreground_bold     = #102015
cursor              = #102015
cursor_foreground   = #f9f9f9
background          = #f9f9f9

# base00 - Black
color0  = #f9f9f9
# base08 - Red
color1  = #e92f2f
# base0B - Green
color2  = #0ed839
# base0A - Yellow
color3  = #dddd13
# base0D - Blue
color4  = #3b48e3
# base0E - Magenta
color5  = #f996e2
# base0C - Cyan
color6  = #23edda
# base05 - White
color7  = #102015
# base03 - Bright Black
color8  = #555555
# base08 - Bright Red
color9  = #e92f2f
# base0B - Bright Green
color10 = #0ed839
# base0A - Bright Yellow
color11 = #dddd13
# base0D - Bright Blue
color12 = #3b48e3
# base0E - Bright Magenta
color13 = #f996e2
# base0C - Bright Cyan
color14 = #23edda
# base07 - Bright White
color15 = #000000
# base09
color16 = #e09448
# base0F
color17 = #69542d
# base01
color18 = #e0e0e0
# base02
color19 = #ababab
# base04
color20 = #343434
# base06
color21 = #040404
