[colors]
# base16 Colors
# Scheme author: mrmrs (http://clrs.cc)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #bbbbbb
foreground_bold     = #bbbbbb
cursor              = #bbbbbb
cursor_foreground   = #111111
background          = #111111

# base00 - Black
color0  = #111111
# base08 - Red
color1  = #ff4136
# base0B - Green
color2  = #2ecc40
# base0A - Yellow
color3  = #ffdc00
# base0D - Blue
color4  = #0074d9
# base0E - Magenta
color5  = #b10dc9
# base0C - Cyan
color6  = #7fdbff
# base05 - White
color7  = #bbbbbb
# base03 - Bright Black
color8  = #777777
# base08 - Bright Red
color9  = #ff4136
# base0B - Bright Green
color10 = #2ecc40
# base0A - Bright Yellow
color11 = #ffdc00
# base0D - Bright Blue
color12 = #0074d9
# base0E - Bright Magenta
color13 = #b10dc9
# base0C - Bright Cyan
color14 = #7fdbff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff851b
# base0F
color17 = #85144b
# base01
color18 = #333333
# base02
color19 = #555555
# base04
color20 = #999999
# base06
color21 = #dddddd
