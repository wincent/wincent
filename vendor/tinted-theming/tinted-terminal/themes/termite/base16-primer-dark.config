[colors]
# base16 Primer Dark
# Scheme author: Jimmy Lin
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #b1bac4
foreground_bold     = #b1bac4
cursor              = #b1bac4
cursor_foreground   = #010409
background          = #010409

# base00 - Black
color0  = #010409
# base08 - Red
color1  = #ff7b72
# base0B - Green
color2  = #3fb950
# base0A - Yellow
color3  = #d29922
# base0D - Blue
color4  = #58a6ff
# base0E - Magenta
color5  = #f778ba
# base0C - Cyan
color6  = #a5d6ff
# base05 - White
color7  = #b1bac4
# base03 - Bright Black
color8  = #484f58
# base08 - Bright Red
color9  = #ff7b72
# base0B - Bright Green
color10 = #3fb950
# base0A - Bright Yellow
color11 = #d29922
# base0D - Bright Blue
color12 = #58a6ff
# base0E - Bright Magenta
color13 = #f778ba
# base0C - Bright Cyan
color14 = #a5d6ff
# base07 - Bright White
color15 = #f0f6fc
# base09
color16 = #f0883e
# base0F
color17 = #bd561d
# base01
color18 = #21262d
# base02
color19 = #30363d
