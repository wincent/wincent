color5  = #e40038
# base0C - Cyan
color6  = #2594e0
# base05 - White
color7  = #c5c5c5
# base03 - Bright Black
color8  = #737373
# base12 - Bright Red
color9  = #fb1b18
# base14 - Bright Green
color10 = #6ac118
# base13 - Bright Yellow
color11 = #fdc70e
# base16 - Bright Blue
color12 = #0855fe
# base17 - Bright Magenta
color13 = #fb004f
# base15 - Bright Cyan
color14 = #3ea7fc
# base07 - Bright White
color15 = #eeeeee
