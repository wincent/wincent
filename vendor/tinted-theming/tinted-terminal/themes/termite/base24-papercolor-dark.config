[colors]
# base24 PaperColor Dark
# Scheme author: Nguyen Nguyen (https://github.com/NLKNguyen/papercolor-theme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d0d0
foreground_bold     = #d0d0d0
cursor              = #d0d0d0
cursor_foreground   = #1c1c1c
background          = #1c1c1c

# base00 - Black
color0  = #1c1c1c
# base08 - Red
color1  = #af005f
# base0B - Green
color2  = #5faf00
# base0A - Yellow
color3  = #d7af5f
# base0D - Blue
color4  = #5fafd7
# base0E - Magenta
color5  = #af87d7
# base0C - Cyan
color6  = #ffaf00
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #808080
# base12 - Bright Red
color9  = #d7005f
# base14 - Bright Green
color10 = #ffd75f
# base13 - Bright Yellow
color11 = #87d75f
# base16 - Bright Blue
color12 = #ffd700
# base17 - Bright Magenta
color13 = #87d7ff
# base15 - Bright Cyan
color14 = #87d700
# base07 - Bright White
color15 = #c6c6c6
# base09
color16 = #5faf5f
# base0F
color17 = #ff5faf
# base01
color18 = #303030
# base02
color19 = #3a3a3a
# base04
color20 = #585858
# base06
color21 = #bcbcbc
