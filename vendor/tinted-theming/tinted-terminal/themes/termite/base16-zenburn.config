# base0A - Yellow
color3  = #e0cf9f
# base0D - Blue
color4  = #7cb8bb
# base0E - Magenta
color5  = #dc8cc3
# base0C - Cyan
color6  = #93e0e3
# base05 - White
color7  = #dcdccc
# base03 - Bright Black
color8  = #6f6f6f
# base08 - Bright Red
color9  = #dca3a3
# base0B - Bright Green
color10 = #5f7f5f
# base0A - Bright Yellow
color11 = #e0cf9f
# base0D - Bright Blue
color12 = #7cb8bb
# base0E - Bright Magenta
color13 = #dc8cc3
# base0C - Bright Cyan
color14 = #93e0e3
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #dfaf8f
# base0F
color17 = #000000
# base01
color18 = #404040
