[colors]
# base16 Horizon Dark
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cbced0
foreground_bold     = #cbced0
cursor              = #cbced0
cursor_foreground   = #1c1e26
background          = #1c1e26

# base00 - Black
color0  = #1c1e26
# base08 - Red
color1  = #e93c58
# base0B - Green
color2  = #efaf8e
# base0A - Yellow
color3  = #efb993
# base0D - Blue
color4  = #df5273
# base0E - Magenta
color5  = #b072d1
# base0C - Cyan
color6  = #24a8b4
# base05 - White
color7  = #cbced0
# base03 - Bright Black
color8  = #6f6f70
# base08 - Bright Red
color9  = #e93c58
# base0B - Bright Green
color10 = #efaf8e
# base0A - Bright Yellow
color11 = #efb993
# base0D - Bright Blue
color12 = #df5273
# base0E - Bright Magenta
color13 = #b072d1
# base0C - Bright Cyan
color14 = #24a8b4
# base07 - Bright White
color15 = #e3e6ee
# base09
color16 = #e58d7d
# base0F
color17 = #e4a382
# base01
color18 = #232530
# base02
color19 = #2e303e
# base04
color20 = #9da0a2
# base06
color21 = #dcdfe4
