cursor              = #c0cbe3
cursor_foreground   = #292a37
background          = #292a37

# base00 - Black
color0  = #292a37
# base08 - Red
color1  = #ec6a88
# base0B - Green
color2  = #3fdaa4
# base0A - Yellow
color3  = #e1c697
# base0D - Blue
color4  = #3fc6de
# base0E - Magenta
color5  = #be95ff
# base0C - Cyan
color6  = #ff7eb6
# base05 - White
color7  = #c0cbe3
# base03 - Bright Black
color8  = #45475d
# base08 - Bright Red
color9  = #ec6a88
# base0B - Bright Green
color10 = #3fdaa4
# base0A - Bright Yellow
color11 = #e1c697
# base0D - Bright Blue
color12 = #3fc6de
# base0E - Bright Magenta
color13 = #be95ff
# base0C - Bright Cyan
color14 = #ff7eb6
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #efb993
# base0F
color17 = #8b8da9
# base01
color18 = #343545
# base02
color19 = #3c3e51
# base04
color20 = #50526b
# base06
color21 = #d9e0ee
