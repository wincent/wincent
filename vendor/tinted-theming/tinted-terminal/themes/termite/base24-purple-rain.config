[colors]
# base24 Purple Rain
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d3d4d4
foreground_bold     = #d3d4d4
cursor              = #d3d4d4
cursor_foreground   = #20084a
background          = #20084a

# base00 - Black
color0  = #20084a
# base08 - Red
color1  = #ff260d
# base0B - Green
color2  = #9ae204
# base0A - Yellow
color3  = #00a5ff
# base0D - Blue
color4  = #00a1f9
# base0E - Magenta
color5  = #805bb5
# base0C - Cyan
color6  = #00ddef
# base05 - White
color7  = #d3d4d4
# base03 - Bright Black
color8  = #7f7f7f
# base12 - Bright Red
color9  = #ff4250
# base14 - Bright Green
color10 = #b8e36d
# base13 - Bright Yellow
color11 = #ffd852
# base16 - Bright Blue
color12 = #00a5ff
# base17 - Bright Magenta
color13 = #ab7aef
# base15 - Bright Cyan
color14 = #74fcf3
# base07 - Bright White
color15 = #feffff
# base09
color16 = #ffc400
# base0F
color17 = #7f1306
# base01
color18 = #000000
# base02
color19 = #555555
# base04
color20 = #a9aaaa
# base06
color21 = #feffff
