[colors]
# base16 Summerfruit Dark
# Scheme author: Christopher Corley (http://christop.club/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d0d0
foreground_bold     = #d0d0d0
cursor              = #d0d0d0
cursor_foreground   = #151515
background          = #151515

# base00 - Black
color0  = #151515
# base08 - Red
color1  = #ff0086
# base0B - Green
color2  = #00c918
# base0A - Yellow
color3  = #aba800
# base0D - Blue
color4  = #3777e6
# base0E - Magenta
color5  = #ad00a1
# base0C - Cyan
color6  = #1faaaa
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #505050
# base08 - Bright Red
color9  = #ff0086
# base0B - Bright Green
color10 = #00c918
# base0A - Bright Yellow
color11 = #aba800
# base0D - Bright Blue
color12 = #3777e6
# base0E - Bright Magenta
color13 = #ad00a1
# base0C - Bright Cyan
color14 = #1faaaa
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fd8900
# base0F
color17 = #cc6633
# base01
color18 = #202020
# base02
color19 = #303030
# base04
color20 = #b0b0b0
# base06
color21 = #e0e0e0
