[colors]
# base24 Catppuccin Mocha
# Scheme author: https://github.com/catppuccin/catppuccin
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdd6f4
foreground_bold     = #cdd6f4
cursor              = #cdd6f4
cursor_foreground   = #1e1e2e
background          = #1e1e2e

# base00 - Black
color0  = #1e1e2e
# base08 - Red
color1  = #f38ba8
# base0B - Green
color2  = #a6e3a1
# base0A - Yellow
color3  = #f9e2af
# base0D - Blue
color4  = #89b4fa
# base0E - Magenta
color5  = #cba6f7
# base0C - Cyan
color6  = #94e2d5
# base05 - White
color7  = #cdd6f4
# base03 - Bright Black
color8  = #45475a
# base12 - Bright Red
color9  = #eba0ac
# base14 - Bright Green
color10 = #a6e3a1
# base13 - Bright Yellow
color11 = #f5e0dc
# base16 - Bright Blue
color12 = #74c7ec
# base17 - Bright Magenta
color13 = #f5c2e7
# base15 - Bright Cyan
color14 = #89dceb
# base07 - Bright White
color15 = #b4befe
# base09
color16 = #fab387
# base0F
color17 = #f2cdcd
# base01
color18 = #181825
# base02
color19 = #313244
# base04
color20 = #585b70
# base06
color21 = #f5e0dc
