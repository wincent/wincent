[colors]
# base16 selenized-white
# Scheme author: Jan Warchol (https://github.com/jan-warchol/selenized) / adapted to base16 by ali
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #474747
foreground_bold     = #474747
cursor              = #474747
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #bf0000
# base0B - Green
color2  = #008400
# base0A - Yellow
color3  = #af8500
# base0D - Blue
color4  = #0054cf
# base0E - Magenta
color5  = #6b40c3
# base0C - Cyan
color6  = #009a8a
# base05 - White
color7  = #474747
# base03 - Bright Black
color8  = #878787
# base08 - Bright Red
color9  = #bf0000
# base0B - Bright Green
color10 = #008400
# base0A - Bright Yellow
color11 = #af8500
# base0D - Bright Blue
color12 = #0054cf
# base0E - Bright Magenta
color13 = #6b40c3
# base0C - Bright Cyan
color14 = #009a8a
# base07 - Bright White
color15 = #282828
# base09
color16 = #ba3700
# base0F
color17 = #dd0f9d
# base01
color18 = #ebebeb
# base02
color19 = #cdcdcd
# base04
color20 = #878787
# base06
color21 = #282828
