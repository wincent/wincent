[colors]
# base16 Windows NT
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c0c0c0
foreground_bold     = #c0c0c0
cursor              = #c0c0c0
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff0000
# base0B - Green
color2  = #00ff00
# base0A - Yellow
color3  = #ffff00
# base0D - Blue
color4  = #0000ff
# base0E - Magenta
color5  = #ff00ff
# base0C - Cyan
color6  = #00ffff
# base05 - White
color7  = #c0c0c0
# base03 - Bright Black
color8  = #808080
# base08 - Bright Red
color9  = #ff0000
# base0B - Bright Green
color10 = #00ff00
# base0A - Bright Yellow
color11 = #ffff00
# base0D - Bright Blue
color12 = #0000ff
# base0E - Bright Magenta
color13 = #ff00ff
# base0C - Bright Cyan
color14 = #00ffff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #808000
# base0F
color17 = #008000
# base01
color18 = #2a2a2a
# base02
color19 = #555555
# base04
color20 = #a1a1a1
# base06
color21 = #e0e0e0
