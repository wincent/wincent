color6  = #8c9785
# base05 - White
color7  = #aa556f
# base03 - Bright Black
color8  = #74316b
# base08 - Bright Red
color9  = #c53253
# base0B - Bright Green
color10 = #a68e5a
# base0A - Bright Yellow
color11 = #ff6565
