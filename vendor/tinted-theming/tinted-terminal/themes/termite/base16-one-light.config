[colors]
# base16 One Light
# Scheme author: Daniel Pfeifer (http://github.com/purpleKarrot)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #383a42
foreground_bold     = #383a42
cursor              = #383a42
cursor_foreground   = #fafafa
background          = #fafafa

# base00 - Black
color0  = #fafafa
# base08 - Red
color1  = #ca1243
# base0B - Green
color2  = #50a14f
# base0A - Yellow
color3  = #c18401
# base0D - Blue
color4  = #4078f2
# base0E - Magenta
color5  = #a626a4
# base0C - Cyan
color6  = #0184bc
# base05 - White
color7  = #383a42
# base03 - Bright Black
color8  = #a0a1a7
# base08 - Bright Red
color9  = #ca1243
# base0B - Bright Green
color10 = #50a14f
# base0A - Bright Yellow
color11 = #c18401
# base0D - Bright Blue
color12 = #4078f2
# base0E - Bright Magenta
color13 = #a626a4
# base0C - Bright Cyan
color14 = #0184bc
# base07 - Bright White
color15 = #090a0b
# base09
color16 = #d75f00
# base0F
color17 = #986801
# base01
color18 = #f0f0f1
# base02
color19 = #e5e5e6
# base04
color20 = #696c77
# base06
color21 = #202227
