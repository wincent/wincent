[colors]
# base16 Chinoiserie Morandi
# Scheme author: Di Wang (https://cs.cmu.edu/~diw3)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c4cbcf
foreground_bold     = #c4cbcf
cursor              = #c4cbcf
cursor_foreground   = #1d1d1d
background          = #1d1d1d

# base00 - Black
color0  = #1d1d1d
# base08 - Red
color1  = #c06061
# base0B - Green
color2  = #8ca07b
# base0A - Yellow
color3  = #e5bc84
# base0D - Blue
color4  = #839ec9
# base0E - Magenta
color5  = #98a1d8
# base0C - Cyan
color6  = #5e8c9b
# base05 - White
color7  = #c4cbcf
# base03 - Bright Black
color8  = #918072
# base08 - Bright Red
color9  = #c06061
# base0B - Bright Green
color10 = #8ca07b
# base0A - Bright Yellow
color11 = #e5bc84
# base0D - Bright Blue
color12 = #839ec9
# base0E - Bright Magenta
color13 = #98a1d8
# base0C - Bright Cyan
color14 = #5e8c9b
# base07 - Bright White
color15 = #fffef9
# base09
color16 = #ff937f
# base0F
color17 = #d9cdb4
# base01
color18 = #282828
# base02
color19 = #373737
# base04
color20 = #bdaead
# base06
color21 = #eee7f2
