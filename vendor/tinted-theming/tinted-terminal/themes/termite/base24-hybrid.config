color2  = #b3be5a
# base0A - Yellow
color3  = #4b6b88
# base0D - Blue
color4  = #6d90b0
# base0E - Magenta
color5  = #a07eab
# base0C - Cyan
color6  = #7fbeb3
# base05 - White
color7  = #8f9190
# base03 - Bright Black
color8  = #434446
# base12 - Bright Red
color9  = #8c2d32
# base14 - Bright Green
color10 = #788331
# base13 - Bright Yellow
color11 = #e5894f
# base16 - Bright Blue
color12 = #4b6b88
# base17 - Bright Magenta
color13 = #6e4f79
# base15 - Bright Cyan
color14 = #4d7b73
# base07 - Bright White
color15 = #5a6169
# base09
color16 = #e3b55e
# base0F
color17 = #5b2628
