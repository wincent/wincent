[colors]
# base24 Lumina Quartz Dark Contrast
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #ebeff2
foreground_bold     = #ebeff2
cursor              = #ebeff2
cursor_foreground   = #0d0e0f
background          = #0d0e0f

color0  = #0d0e0f # base00 - Black
color1  = #ffa69b # base08 - Red
color2  = #62d17f # base0B - Green
color3  = #ffc334 # base0A - Yellow
color4  = #7fb7ff # base0D - Blue
color5  = #c09aff # base0E - Magenta
color6  = #00e2fc # base0C - Cyan
color7  = #ebeff2 # base05 - White
color8  = #242526 # base03 - Bright Black
color9  = #ffcdc6 # base12 - Bright Red
color10 = #7eeb98 # base14 - Bright Green
color11 = #ffe4b0 # base13 - Bright Yellow
color12 = #add1ff # base16 - Bright Blue
color13 = #ffadf7 # base17 - Bright Magenta
color14 = #a6f2ff # base15 - Bright Cyan
color15 = #ebeff2 # base07 - Bright White
color16 = #ff9645 # base09
color17 = #ec8ce4 # base0F
color18 = #111213 # base01
color19 = #1a1b1d # base02
color20 = #68696a # base04
color21 = #b0b1b2 # base06
