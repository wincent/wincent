[colors]
# base16 London
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #333333
foreground_bold     = #333333
cursor              = #333333
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #333333
# base0B - Green
color2  = #444444
# base0A - Yellow
color3  = #555555
# base0D - Blue
color4  = #666666
# base0E - Magenta
color5  = #777777
# base0C - Cyan
color6  = #888888
# base05 - White
color7  = #333333
# base03 - Bright Black
color8  = #333333
# base08 - Bright Red
color9  = #333333
# base0B - Bright Green
color10 = #444444
# base0A - Bright Yellow
color11 = #555555
# base0D - Bright Blue
color12 = #666666
# base0E - Bright Magenta
color13 = #777777
# base0C - Bright Cyan
color14 = #888888
# base07 - Bright White
color15 = #aaaaaa
# base09
color16 = #444444
# base0F
color17 = #303030
# base01
color18 = #f1f1f1
# base02
color19 = #e7e7e7
# base04
color20 = #7a7a7a
# base06
color21 = #242424
