color3  = #91ccff
# base0D - Blue
color4  = #a2cff5
# base0E - Magenta
color5  = #0099ff
# base0C - Cyan
color6  = #80ff80
# base05 - White
color7  = #ffcc33
# base03 - Bright Black
color8  = #a0ffa0
# base08 - Bright Red
color9  = #fffab1
# base0B - Bright Green
color10 = #80ff80
# base0A - Bright Yellow
color11 = #91ccff
# base0D - Bright Blue
color12 = #a2cff5
# base0E - Bright Magenta
color13 = #0099ff
# base0C - Bright Cyan
color14 = #80ff80
# base07 - Bright White
color15 = #375780
# base09
color16 = #ff8080
# base0F
color17 = #e7e7e7
