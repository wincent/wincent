[colors]
# base16 Tokyo City Light
# Scheme author: Michaël Ball
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #343b59
foreground_bold     = #343b59
cursor              = #343b59
cursor_foreground   = #fbfbfd
background          = #fbfbfd

# base00 - Black
color0  = #fbfbfd
# base08 - Red
color1  = #8c4351
# base0B - Green
color2  = #485e30
# base0A - Yellow
color3  = #4c505e
# base0D - Blue
color4  = #34548a
# base0E - Magenta
color5  = #5a4a78
# base0C - Cyan
color6  = #4c505e
# base05 - White
color7  = #343b59
# base03 - Bright Black
color8  = #9699a3
# base08 - Bright Red
color9  = #8c4351
# base0B - Bright Green
color10 = #485e30
# base0A - Bright Yellow
color11 = #4c505e
# base0D - Bright Blue
color12 = #34548a
# base0E - Bright Magenta
color13 = #5a4a78
# base0C - Bright Cyan
color14 = #4c505e
# base07 - Bright White
color15 = #171d23
# base09
color16 = #965027
# base0F
color17 = #5a4a78
# base01
color18 = #f6f6f8
