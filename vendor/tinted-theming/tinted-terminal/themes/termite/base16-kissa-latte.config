color1  = #9e3e3e
# base0B - Green
color2  = #387050
# base0A - Yellow
color3  = #7d6820
# base0D - Blue
color4  = #3468a8
# base0E - Magenta
color5  = #6438a0
# base0C - Cyan
color6  = #287070
# base05 - White
color7  = #1f1c16
# base03 - Bright Black
color8  = #91887d
# base08 - Bright Red
color9  = #9e3e3e
# base0B - Bright Green
color10 = #387050
# base0A - Bright Yellow
color11 = #7d6820
# base0D - Bright Blue
color12 = #3468a8
# base0E - Bright Magenta
color13 = #6438a0
# base0C - Bright Cyan
color14 = #287070
# base07 - Bright White
color15 = #fefcfa
