[colors]
# base24 Square
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #bababa
foreground_bold     = #bababa
cursor              = #bababa
cursor_foreground   = #1a1a1a
background          = #1a1a1a

# base00 - Black
color0  = #1a1a1a
# base08 - Red
color1  = #e9897c
# base0B - Green
color2  = #b6377d
# base0A - Yellow
color3  = #b6defb
# base0D - Blue
color4  = #a9cdeb
# base0E - Magenta
color5  = #75507b
# base0C - Cyan
color6  = #c9caec
# base05 - White
color7  = #bababa
# base03 - Bright Black
color8  = #4b4b4b
# base12 - Bright Red
color9  = #f99286
# base14 - Bright Green
color10 = #c3f786
# base13 - Bright Yellow
color11 = #fcfbcc
# base16 - Bright Blue
color12 = #b6defb
# base17 - Bright Magenta
color13 = #ad7fa8
# base15 - Bright Cyan
color14 = #d7d9fc
# base07 - Bright White
color15 = #e2e2e2
# base09
color16 = #ecebbe
# base0F
color17 = #74443e
# base01
color18 = #050505
# base02
color19 = #141414
# base04
color20 = #838383
# base06
color21 = #f2f2f2
