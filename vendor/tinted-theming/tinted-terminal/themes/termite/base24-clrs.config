[colors]
# base24 CLRS
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #9a9b9a
foreground_bold     = #9a9b9a
cursor              = #9a9b9a
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #f72729
# base0B - Green
color2  = #32895c
# base0A - Yellow
color3  = #156ffe
# base0D - Blue
color4  = #125ccf
# base0E - Magenta
color5  = #9f00bc
# base0C - Cyan
color6  = #32c2c0
# base05 - White
color7  = #9a9b9a
# base03 - Bright Black
color8  = #6b6d6a
# base12 - Bright Red
color9  = #fb0416
# base14 - Bright Green
color10 = #2cc631
# base13 - Bright Yellow
color11 = #fcd627
# base16 - Bright Blue
color12 = #156ffe
# base17 - Bright Magenta
color13 = #e800b0
# base15 - Bright Cyan
color14 = #39d5ce
# base07 - Bright White
color15 = #ededec
# base09
color16 = #f96f1c
# base0F
color17 = #7b1314
# base01
color18 = #000000
# base02
color19 = #545753
# base04
color20 = #838482
# base06
color21 = #b2b2b2
