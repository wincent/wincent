color3  = #c0aa00
# base0D - Blue
color4  = #0084bc
# base0E - Magenta
color5  = #a625a4
# base0C - Cyan
color6  = #0996b3
# base05 - White
color7  = #cfd0d2
# base03 - Bright Black
color8  = #797c84
# base12 - Bright Red
color9  = #df6c75
# base14 - Bright Green
color10 = #98c379
# base13 - Bright Yellow
color11 = #e4c07a
# base16 - Bright Blue
color12 = #61afef
# base17 - Bright Magenta
color13 = #c577dd
# base15 - Bright Cyan
color14 = #56b5c1
# base07 - Bright White
color15 = #ffffff
