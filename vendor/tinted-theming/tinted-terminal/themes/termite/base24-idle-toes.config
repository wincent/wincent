[colors]
# base24 Idle Toes
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c7c7c5
foreground_bold     = #c7c7c5
cursor              = #c7c7c5
cursor_foreground   = #323232
background          = #323232

# base00 - Black
color0  = #323232
# base08 - Red
color1  = #d25252
# base0B - Green
color2  = #7fe173
# base0A - Yellow
color3  = #5eb7f7
# base0D - Blue
color4  = #4098ff
# base0E - Magenta
color5  = #f57fff
# base0C - Cyan
color6  = #bed6ff
# base05 - White
color7  = #c7c7c5
# base03 - Bright Black
color8  = #797979
# base12 - Bright Red
color9  = #f07070
# base14 - Bright Green
color10 = #9dff90
# base13 - Bright Yellow
color11 = #ffe48b
# base16 - Bright Blue
color12 = #5eb7f7
# base17 - Bright Magenta
color13 = #ff9dff
# base15 - Bright Cyan
color14 = #dcf4ff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffc66d
# base0F
color17 = #692929
# base01
color18 = #323232
# base02
color19 = #535353
# base04
color20 = #a0a09f
# base06
color21 = #eeeeec
