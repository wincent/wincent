color6  = #b4f9f8
# base05 - White
color7  = #a9b1d6
# base03 - Bright Black
color8  = #444b6a
# base12 - Bright Red
color9  = #ff7a93
# base14 - Bright Green
color10 = #73daca
# base13 - Bright Yellow
color11 = #ff9e64
# base16 - Bright Blue
color12 = #89ddff
