[colors]
# base24 Tokyo Night Storm
# Scheme author: Michaël Ball, based on Tokyo Night by enkia (https://github.com/enkia/tokyo-night-vscode-theme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a9b1d6
foreground_bold     = #a9b1d6
cursor              = #a9b1d6
