[colors]
# base24 Chalk
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d0d0
foreground_bold     = #d0d0d0
cursor              = #d0d0d0
cursor_foreground   = #151515
background          = #151515

# base00 - Black
color0  = #151515
# base08 - Red
color1  = #fa859c
# base0B - Green
color2  = #a1bb54
# base0A - Yellow
color3  = #ddb26f
# base0D - Blue
color4  = #5ab9ed
# base0E - Magenta
color5  = #db8fea
# base0C - Cyan
color6  = #10bcad
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #505050
# base12 - Bright Red
color9  = #fb9fb1
# base14 - Bright Green
color10 = #acc267
# base13 - Bright Yellow
color11 = #eda987
# base16 - Bright Blue
color12 = #6fc2ef
# base17 - Bright Magenta
color13 = #e1a3ee
# base15 - Bright Cyan
color14 = #12cfc0
# base07 - Bright White
color15 = #f5f5f5
# base09
color16 = #ea9971
# base0F
color17 = #deaf8f
# base01
color18 = #202020
# base02
color19 = #303030
# base04
color20 = #b0b0b0
# base06
color21 = #e0e0e0
