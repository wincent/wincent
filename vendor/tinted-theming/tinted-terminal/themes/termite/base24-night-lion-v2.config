color3  = #62cae7
# base0D - Blue
color4  = #63d0f0
# base0E - Magenta
color5  = #ce6fda
# base0C - Cyan
color6  = #00d9df
# base05 - White
color7  = #a1a1a1
# base03 - Bright Black
color8  = #6e6e6e
# base12 - Bright Red
color9  = #ff5555
# base14 - Bright Green
color10 = #7df61c
# base13 - Bright Yellow
color11 = #ffff55
# base16 - Bright Blue
color12 = #62cae7
# base17 - Bright Magenta
color13 = #ff9af5
# base15 - Bright Cyan
color14 = #00ccd7
# base07 - Bright White
color15 = #ffffff
