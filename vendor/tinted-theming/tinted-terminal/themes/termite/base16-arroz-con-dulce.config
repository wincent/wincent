color6  = #98263e # base0C - Cyan
color7  = #4a2c20 # base05 - White
color8  = #c8a77a # base03 - Bright Black
color9  = #a11d48 # base08 - Bright Red
color10 = #a2380c # base0B - Bright Green
color11 = #855500 # base0A - Bright Yellow
color12 = #5940a0 # base0D - Bright Blue
color13 = #8c1f68 # base0E - Bright Magenta
color14 = #98263e # base0C - Bright Cyan
color15 = #21110b # base07 - Bright White
color16 = #a3470a # base09
color17 = #653221 # base0F
color18 = #f7ebd3 # base01
