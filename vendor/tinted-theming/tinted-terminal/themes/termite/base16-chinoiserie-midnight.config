[colors]
# base16 Chinoiserie Midnight
# Scheme author: Di Wang (https://cs.cmu.edu/~diw3)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c4cbcf
foreground_bold     = #c4cbcf
cursor              = #c4cbcf
cursor_foreground   = #1d1d1d
background          = #1d1d1d

# base00 - Black
color0  = #1d1d1d
# base08 - Red
color1  = #ed5a56
# base0B - Green
color2  = #aeb831
# base0A - Yellow
color3  = #fbb957
# base0D - Blue
color4  = #81a2a2
# base0E - Magenta
color5  = #cf8997
# base0C - Cyan
color6  = #88b68d
# base05 - White
color7  = #c4cbcf
# base03 - Bright Black
color8  = #918072
# base08 - Bright Red
color9  = #ed5a56
# base0B - Bright Green
color10 = #aeb831
# base0A - Bright Yellow
color11 = #fbb957
# base0D - Bright Blue
color12 = #81a2a2
# base0E - Bright Magenta
color13 = #cf8997
# base0C - Bright Cyan
color14 = #88b68d
# base07 - Bright White
color15 = #fffef9
# base09
color16 = #fc8c23
# base0F
color17 = #cd6227
# base01
color18 = #282828
# base02
color19 = #373737
# base04
color20 = #bdaead
# base06
color21 = #eee7f2
