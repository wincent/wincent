[colors]
# base16 Measured Dark
# Scheme author: Measured (https://measured.co)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dcdcdc
foreground_bold     = #dcdcdc
cursor              = #dcdcdc
cursor_foreground   = #00211f
background          = #00211f

# base00 - Black
color0  = #00211f
# base08 - Red
color1  = #ce7e8e
# base0B - Green
color2  = #56c16f
# base0A - Yellow
color3  = #bfac4e
# base0D - Blue
color4  = #88b0da
# base0E - Magenta
color5  = #b39be0
# base0C - Cyan
color6  = #62c0be
# base05 - White
color7  = #dcdcdc
# base03 - Bright Black
color8  = #ababab
# base08 - Bright Red
color9  = #ce7e8e
# base0B - Bright Green
color10 = #56c16f
# base0A - Bright Yellow
color11 = #bfac4e
# base0D - Bright Blue
color12 = #88b0da
# base0E - Bright Magenta
color13 = #b39be0
# base0C - Bright Cyan
color14 = #62c0be
# base07 - Bright White
color15 = #f5f5f5
# base09
color16 = #dca37c
# base0F
color17 = #d89aba
# base01
color18 = #003a38
# base02
color19 = #005453
# base04
color20 = #c3c3c3
# base06
color21 = #efefef
