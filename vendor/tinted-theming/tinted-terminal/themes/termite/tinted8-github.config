cursor              = #1f2328
cursor_foreground   = #ffffff
background          = #ffffff

color0  = #1f2328   # Black
color1  = #cf222e     # Red
color2  = #116329   # Green
color3  = #4d2d00  # Yellow
color4  = #0969da    # Blue
color5  = #8250df # Magenta
color6  = #1b7c83    # Cyan
color7  = #59636e   # White
color8  = #393f46   # Bright Black
color9  = #a40e26     # Bright Red
color10 = #1a7f37   # Bright Green
color11 = #633c01  # Bright Yellow
color12 = #218bff    # Bright Blue
color13 = #a475f9 # Bright Magenta
color14 = #3192aa    # Bright Cyan
color15 = #818b98   # Bright White
