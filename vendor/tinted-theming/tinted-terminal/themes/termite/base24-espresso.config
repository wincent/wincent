color3  = #8ab7d9
# base0D - Blue
color4  = #6c99bb
# base0E - Magenta
color5  = #d197d9
# base0C - Cyan
color6  = #bed6ff
# base05 - White
color7  = #c7c7c5
# base03 - Bright Black
color8  = #797979
# base12 - Bright Red
color9  = #f00c0c
# base14 - Bright Green
color10 = #c2e075
# base13 - Bright Yellow
color11 = #e1e38b
# base16 - Bright Blue
color12 = #8ab7d9
# base17 - Bright Magenta
color13 = #efb5f7
# base15 - Bright Cyan
color14 = #dcf3ff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffc66d
# base0F
color17 = #692828
# base01
color18 = #343434
