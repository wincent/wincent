color2  = #b8bb26
# base0A - Yellow
color3  = #fabd2f
# base0D - Blue
color4  = #83a598
# base0E - Magenta
color5  = #d3869b
# base0C - Cyan
color6  = #8ec07c
# base05 - White
color7  = #d5c4a1
# base03 - Bright Black
color8  = #665c54
# base08 - Bright Red
color9  = #fb4934
# base0B - Bright Green
color10 = #b8bb26
# base0A - Bright Yellow
color11 = #fabd2f
# base0D - Bright Blue
color12 = #83a598
# base0E - Bright Magenta
color13 = #d3869b
# base0C - Bright Cyan
color14 = #8ec07c
# base07 - Bright White
color15 = #fbf1c7
# base09
color16 = #fe8019
# base0F
color17 = #d65d0e
# base01
color18 = #3c3836
