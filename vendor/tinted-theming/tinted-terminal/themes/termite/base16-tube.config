[colors]
# base16 London Tube
# Scheme author: Jan T. Sott
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d9d8d8
foreground_bold     = #d9d8d8
cursor              = #d9d8d8
cursor_foreground   = #231f20
background          = #231f20

# base00 - Black
color0  = #231f20
# base08 - Red
color1  = #ee2e24
# base0B - Green
color2  = #00853e
# base0A - Yellow
color3  = #ffd204
# base0D - Blue
color4  = #009ddc
# base0E - Magenta
color5  = #98005d
# base0C - Cyan
color6  = #85cebc
# base05 - White
color7  = #d9d8d8
# base03 - Bright Black
color8  = #737171
# base08 - Bright Red
color9  = #ee2e24
# base0B - Bright Green
color10 = #00853e
# base0A - Bright Yellow
color11 = #ffd204
# base0D - Bright Blue
color12 = #009ddc
# base0E - Bright Magenta
color13 = #98005d
# base0C - Bright Cyan
color14 = #85cebc
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f386a1
# base0F
color17 = #b06110
# base01
color18 = #1c3f95
# base02
color19 = #5a5758
# base04
color20 = #959ca1
# base06
color21 = #e7e7e8
