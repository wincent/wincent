[colors]
# base16 PaperColor Light
# Scheme author: Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #5e5e5e
foreground_bold     = #5e5e5e
cursor              = #5e5e5e
cursor_foreground   = #eeeeee
background          = #eeeeee

# base00 - Black
color0  = #eeeeee
# base08 - Red
color1  = #d70000
# base0B - Green
color2  = #008700
# base0A - Yellow
color3  = #d75f00
# base0D - Blue
color4  = #005f87
# base0E - Magenta
color5  = #8700af
# base0C - Cyan
color6  = #0087af
# base05 - White
color7  = #5e5e5e
# base03 - Bright Black
color8  = #858585
# base08 - Bright Red
color9  = #d70000
# base0B - Bright Green
color10 = #008700
# base0A - Bright Yellow
color11 = #d75f00
# base0D - Bright Blue
color12 = #005f87
# base0E - Bright Magenta
color13 = #8700af
# base0C - Bright Cyan
color14 = #0087af
# base07 - Bright White
color15 = #444444
# base09
color16 = #d75f00
# base0F
color17 = #af0000
# base01
color18 = #c4c4c4
# base02
color19 = #9e9e9e
# base04
color20 = #6b6b6b
# base06
color21 = #525252
