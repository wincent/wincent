[colors]
# base24 ENCOM
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a1a1a1
foreground_bold     = #a1a1a1
cursor              = #a1a1a1
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #9f0000
# base0B - Green
color2  = #008b00
# base0A - Yellow
color3  = #0000ff
# base0D - Blue
color4  = #0081ff
# base0E - Magenta
color5  = #bc00ca
# base0C - Cyan
color6  = #008b8b
# base05 - White
color7  = #a1a1a1
# base03 - Bright Black
color8  = #6e6e6e
# base12 - Bright Red
color9  = #ff0000
# base14 - Bright Green
color10 = #00ee00
# base13 - Bright Yellow
color11 = #ffff00
# base16 - Bright Blue
color12 = #0000ff
# base17 - Bright Magenta
color13 = #ff00ff
# base15 - Bright Cyan
color14 = #00cdcd
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffcf00
# base0F
color17 = #4f0000
# base01
color18 = #000000
# base02
color19 = #555555
# base04
color20 = #888888
# base06
color21 = #bbbbbb
