[colors]
# base24 Apprentice
# Scheme author: Romain Lafourcade (https://github.com/romainl)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #bcbcbc
foreground_bold     = #bcbcbc
cursor              = #bcbcbc
cursor_foreground   = #262626
background          = #262626

color0  = #262626 # base00 - Black
color1  = #af5f5f # base08 - Red
color2  = #5f875f # base0B - Green
color3  = #87875f # base0A - Yellow
color4  = #5f87af # base0D - Blue
color5  = #5f5f87 # base0E - Magenta
color6  = #5f8787 # base0C - Cyan
color7  = #bcbcbc # base05 - White
color8  = #444444 # base03 - Bright Black
color9  = #ff8700 # base12 - Bright Red
color10 = #87af87 # base14 - Bright Green
color11 = #ffffaf # base13 - Bright Yellow
color12 = #87afd7 # base16 - Bright Blue
color13 = #8787af # base17 - Bright Magenta
color14 = #5fafaf # base15 - Bright Cyan
color15 = #ffffff # base07 - Bright White
color16 = #ff8700 # base09
color17 = #af5f5f # base0F
color18 = #303030 # base01
color19 = #3a3a3a # base02
color20 = #6c6c6c # base04
color21 = #dfdfdf # base06
