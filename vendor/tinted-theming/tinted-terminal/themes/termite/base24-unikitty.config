color3  = #eedf4b
# base0D - Blue
color4  = #145fcd
# base0E - Magenta
color5  = #ff36a2
# base0C - Cyan
color6  = #6bd0bc
# base05 - White
color7  = #b9b1b8
# base03 - Bright Black
color8  = #696769
# base12 - Bright Red
color9  = #d81329
# base14 - Bright Green
color10 = #d2ffaf
# base13 - Bright Yellow
color11 = #ffee50
# base16 - Bright Blue
color12 = #0074ea
# base17 - Bright Magenta
color13 = #fdd5e5
# base15 - Bright Cyan
color14 = #79ebd5
# base07 - Bright White
color15 = #fff2fd
# base09
color16 = #eeaa4b
# base0F
color17 = #540710
