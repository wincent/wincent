[colors]
# base16 Pop
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d0d0
foreground_bold     = #d0d0d0
cursor              = #d0d0d0
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #eb008a
# base0B - Green
color2  = #37b349
# base0A - Yellow
color3  = #f8ca12
# base0D - Blue
color4  = #0e5a94
# base0E - Magenta
color5  = #b31e8d
# base0C - Cyan
color6  = #00aabb
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #505050
# base08 - Bright Red
color9  = #eb008a
# base0B - Bright Green
color10 = #37b349
# base0A - Bright Yellow
color11 = #f8ca12
# base0D - Bright Blue
color12 = #0e5a94
# base0E - Bright Magenta
color13 = #b31e8d
# base0C - Bright Cyan
color14 = #00aabb
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f29333
# base0F
color17 = #7a2d00
# base01
color18 = #202020
# base02
color19 = #303030
# base04
color20 = #b0b0b0
# base06
color21 = #e0e0e0
