color2  = #6ca38c
# base0A - Yellow
color3  = #cfad25
# base0D - Blue
color4  = #39aac9
# base0E - Magenta
color5  = #6e6582
# base0C - Cyan
color6  = #329ca2
# base05 - White
color7  = #385156
# base03 - Bright Black
color8  = #5c787b
# base08 - Bright Red
color9  = #cf432e
# base0B - Bright Green
color10 = #6ca38c
# base0A - Bright Yellow
color11 = #cfad25
# base0D - Bright Blue
color12 = #39aac9
# base0E - Bright Magenta
color13 = #6e6582
# base0C - Bright Cyan
color14 = #329ca2
# base07 - Bright White
color15 = #d2faff
# base09
color16 = #d27f46
# base0F
color17 = #865369
