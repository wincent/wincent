[colors]
# base24 Laser
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d8d8d8
foreground_bold     = #d8d8d8
cursor              = #d8d8d8
cursor_foreground   = #030d18
background          = #030d18

# base00 - Black
color0  = #030d18
# base08 - Red
color1  = #ff8272
# base0B - Green
color2  = #b4fa72
# base0A - Yellow
color3  = #f92883
# base0D - Blue
color4  = #fed300
# base0E - Magenta
color5  = #ff8ffd
# base0C - Cyan
color6  = #d0d1fe
# base05 - White
color7  = #d8d8d8
# base03 - Bright Black
color8  = #a6a6a6
# base12 - Bright Red
color9  = #ffc4bd
# base14 - Bright Green
color10 = #d6fcb9
# base13 - Bright Yellow
color11 = #fefdd5
# base16 - Bright Blue
color12 = #f92883
# base17 - Bright Magenta
color13 = #ffb1fe
# base15 - Bright Cyan
color14 = #e5e6fe
# base07 - Bright White
color15 = #feffff
# base09
color16 = #09b4bd
# base0F
color17 = #7f4139
# base01
color18 = #616161
# base02
color19 = #8e8e8e
# base04
color20 = #bfbfbf
# base06
color21 = #f1f1f1
