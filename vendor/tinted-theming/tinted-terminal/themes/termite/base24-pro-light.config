[colors]
# base24 Pro Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #4f4f4f
foreground_bold     = #4f4f4f
cursor              = #4f4f4f
cursor_foreground   = #feffff
background          = #feffff

# base00 - Black
color0  = #feffff
# base08 - Red
color1  = #e4492b
# base0B - Green
color2  = #50d048
# base0A - Yellow
color3  = #c5c340
# base0D - Blue
color4  = #3a75ff
# base0E - Magenta
color5  = #ec65e7
# base0C - Cyan
color6  = #4ed1dd
# base05 - White
color7  = #4f4f4f
# base03 - Bright Black
color8  = #cccccc
# base12 - Bright Red
color9  = #ff6640
# base14 - Bright Green
color10 = #61ee56
# base13 - Bright Yellow
color11 = #f2f055
# base16 - Bright Blue
color12 = #0081ff
# base17 - Bright Magenta
color13 = #ff7dfe
# base15 - Bright Cyan
color14 = #60f6f8
# base07 - Bright White
color15 = #000000
# base09
color16 = #c58e40
# base0F
color17 = #722415
# base01
color18 = #f1f1f1
# base02
color19 = #dcdcdc
# base04
color20 = #757575
# base06
color21 = #323232
