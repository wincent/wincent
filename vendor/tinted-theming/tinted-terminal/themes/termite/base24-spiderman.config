[colors]
# base24 Spiderman
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d3d3cd
foreground_bold     = #d3d3cd
cursor              = #d3d3cd
cursor_foreground   = #1b1d1e
background          = #1b1d1e

# base00 - Black
color0  = #1b1d1e
# base08 - Red
color1  = #e60712
# base0B - Green
color2  = #e22828
# base0A - Yellow
color3  = #1d4fff
# base0D - Blue
color4  = #2b3fff
# base0E - Magenta
color5  = #2435db
# base0C - Cyan
color6  = #3255ff
# base05 - White
color7  = #d3d3cd
# base03 - Bright Black
color8  = #7b7d7c
# base12 - Bright Red
color9  = #ff0325
# base14 - Bright Green
color10 = #ff3238
# base13 - Bright Yellow
color11 = #fe3935
# base16 - Bright Blue
color12 = #1d4fff
# base17 - Bright Magenta
color13 = #737bff
# base15 - Bright Cyan
color14 = #6083ff
# base07 - Bright White
color15 = #fefff9
# base09
color16 = #e24655
# base0F
color17 = #730309
# base01
color18 = #1b1d1e
# base02
color19 = #505354
# base04
color20 = #a7a8a5
# base06
color21 = #fffef6
