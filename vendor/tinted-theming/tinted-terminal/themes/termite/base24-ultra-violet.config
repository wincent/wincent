color1  = #ff0090
# base0B - Green
color2  = #b5ff00
# base0A - Yellow
color3  = #7febff
# base0D - Blue
color4  = #47dffb
# base0E - Magenta
color5  = #d630ff
# base0C - Cyan
color6  = #0effbb
# base05 - White
color7  = #c1c2c2
# base03 - Bright Black
color8  = #818484
# base12 - Bright Red
color9  = #fb57b4
# base14 - Bright Green
color10 = #deff8b
# base13 - Bright Yellow
color11 = #ebdf86
# base16 - Bright Blue
color12 = #7febff
# base17 - Bright Magenta
color13 = #e681ff
# base15 - Bright Cyan
color14 = #68fcd2
# base07 - Bright White
color15 = #f9f9f4
# base09
color16 = #fff727
# base0F
color17 = #7f0048
# base01
color18 = #232628
