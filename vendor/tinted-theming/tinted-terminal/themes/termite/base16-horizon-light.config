[colors]
# base16 Horizon Light
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #403c3d
foreground_bold     = #403c3d
cursor              = #403c3d
cursor_foreground   = #fdf0ed
background          = #fdf0ed

# base00 - Black
color0  = #fdf0ed
# base08 - Red
color1  = #f7939b
# base0B - Green
color2  = #94e1b0
# base0A - Yellow
color3  = #fbe0d9
# base0D - Blue
color4  = #da103f
# base0E - Magenta
color5  = #1d8991
# base0C - Cyan
color6  = #dc3318
# base05 - White
color7  = #403c3d
# base03 - Bright Black
color8  = #bdb3b1
# base08 - Bright Red
color9  = #f7939b
# base0B - Bright Green
color10 = #94e1b0
# base0A - Bright Yellow
color11 = #fbe0d9
# base0D - Bright Blue
color12 = #da103f
# base0E - Bright Magenta
color13 = #1d8991
# base0C - Bright Cyan
color14 = #dc3318
# base07 - Bright White
color15 = #201c1d
# base09
color16 = #f6661e
# base0F
color17 = #e58c92
# base01
color18 = #fadad1
# base02
color19 = #f9cbbe
# base04
color20 = #948c8a
# base06
color21 = #302c2d
