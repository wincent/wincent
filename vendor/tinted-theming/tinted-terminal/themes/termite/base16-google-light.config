[colors]
# base16 Google Light
# Scheme author: Seth Wright (http://sethawright.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #373b41
foreground_bold     = #373b41
cursor              = #373b41
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #cc342b
# base0B - Green
color2  = #198844
# base0A - Yellow
color3  = #fba922
# base0D - Blue
color4  = #3971ed
# base0E - Magenta
color5  = #a36ac7
# base0C - Cyan
color6  = #3971ed
# base05 - White
color7  = #373b41
# base03 - Bright Black
color8  = #b4b7b4
# base08 - Bright Red
color9  = #cc342b
# base0B - Bright Green
color10 = #198844
# base0A - Bright Yellow
color11 = #fba922
# base0D - Bright Blue
color12 = #3971ed
# base0E - Bright Magenta
color13 = #a36ac7
# base0C - Bright Cyan
color14 = #3971ed
# base07 - Bright White
color15 = #1d1f21
# base09
color16 = #f96a38
# base0F
color17 = #3971ed
# base01
color18 = #e0e0e0
# base02
color19 = #c5c8c6
# base04
color20 = #969896
# base06
color21 = #282a2e
