[colors]
# base24 Japanesque
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d2ce
foreground_bold     = #d0d2ce
cursor              = #d0d2ce
cursor_foreground   = #1d1d1d
background          = #1d1d1d

# base00 - Black
color0  = #1d1d1d
# base08 - Red
color1  = #ce3e60
# base0B - Green
color2  = #7bb75b
# base0A - Yellow
color3  = #135879
# base0D - Blue
color4  = #4c99d3
# base0E - Magenta
color5  = #a57fc4
# base0C - Cyan
color6  = #389aac
# base05 - White
color7  = #d0d2ce
# base03 - Bright Black
color8  = #80827f
# base12 - Bright Red
color9  = #d18ea6
# base14 - Bright Green
color10 = #767e2b
# base13 - Bright Yellow
color11 = #77592e
# base16 - Bright Blue
color12 = #135879
# base17 - Bright Magenta
color13 = #5f4190
# base15 - Bright Cyan
color14 = #76bbca
# base07 - Bright White
color15 = #b1b5ae
# base09
color16 = #e8b32a
# base0F
color17 = #671f30
# base01
color18 = #343835
# base02
color19 = #585a58
# base04
color20 = #a8aaa7
# base06
color21 = #f9faf6
