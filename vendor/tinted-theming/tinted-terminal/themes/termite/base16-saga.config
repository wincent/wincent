[colors]
# base16 SAGA
# Scheme author: https://github.com/SAGAtheme/SAGA
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dce2f7
foreground_bold     = #dce2f7
cursor              = #dce2f7
cursor_foreground   = #05080a
background          = #05080a

# base00 - Black
color0  = #05080a
# base08 - Red
color1  = #ffd4e9
# base0B - Green
color2  = #f7ddff
# base0A - Yellow
color3  = #fbebc8
# base0D - Blue
color4  = #c9fff7
# base0E - Magenta
color5  = #dcc3f9
# base0C - Cyan
color6  = #c5edc1
# base05 - White
color7  = #dce2f7
# base03 - Bright Black
color8  = #141f27
# base08 - Bright Red
color9  = #ffd4e9
# base0B - Bright Green
color10 = #f7ddff
# base0A - Bright Yellow
color11 = #fbebc8
# base0D - Bright Blue
color12 = #c9fff7
# base0E - Bright Magenta
color13 = #dcc3f9
# base0C - Bright Cyan
color14 = #c5edc1
# base07 - Bright White
color15 = #ccd3fe
# base09
color16 = #fbcbae
# base0F
color17 = #f6dddd
# base01
color18 = #0a1014
# base02
color19 = #0f181e
# base04
color20 = #192630
# base06
color21 = #f8eae7
