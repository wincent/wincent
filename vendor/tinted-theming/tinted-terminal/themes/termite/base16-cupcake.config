[colors]
# base16 Cupcake
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #8b8198
foreground_bold     = #8b8198
cursor              = #8b8198
cursor_foreground   = #fbf1f2
background          = #fbf1f2

# base00 - Black
color0  = #fbf1f2
# base08 - Red
color1  = #d57e85
# base0B - Green
color2  = #a3b367
# base0A - Yellow
color3  = #dcb16c
# base0D - Blue
color4  = #7297b9
# base0E - Magenta
color5  = #bb99b4
# base0C - Cyan
color6  = #69a9a7
# base05 - White
color7  = #8b8198
# base03 - Bright Black
color8  = #bfb9c6
# base08 - Bright Red
color9  = #d57e85
# base0B - Bright Green
color10 = #a3b367
# base0A - Bright Yellow
color11 = #dcb16c
# base0D - Bright Blue
color12 = #7297b9
# base0E - Bright Magenta
color13 = #bb99b4
# base0C - Bright Cyan
color14 = #69a9a7
# base07 - Bright White
color15 = #585062
# base09
color16 = #ebb790
# base0F
color17 = #baa58c
# base01
color18 = #f2f1f4
# base02
color19 = #d8d5dd
# base04
color20 = #a59daf
# base06
color21 = #72677e
