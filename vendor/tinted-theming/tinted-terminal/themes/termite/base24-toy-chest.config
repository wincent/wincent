foreground          = #27b684
foreground_bold     = #27b684
cursor              = #27b684
cursor_foreground   = #23364a
background          = #23364a

# base00 - Black
color0  = #23364a
# base08 - Red
color1  = #be2d26
# base0B - Green
color2  = #199171
# base0A - Yellow
color3  = #33a5d9
# base0D - Blue
color4  = #325d96
# base0E - Magenta
color5  = #8a5ddb
# base0C - Cyan
color6  = #35a08f
# base05 - White
color7  = #27b684
# base03 - Bright Black
color8  = #2f8288
# base12 - Bright Red
color9  = #dd5943
# base14 - Bright Green
color10 = #30cf7b
# base13 - Bright Yellow
color11 = #e7d74b
# base16 - Bright Blue
color12 = #33a5d9
# base17 - Bright Magenta
color13 = #ad6bdc
# base15 - Bright Cyan
color14 = #41c3ad
# base07 - Bright White
color15 = #d4d4d4
# base09
color16 = #da8e26
# base0F
color17 = #5f1613
# base01
color18 = #2c3f57
