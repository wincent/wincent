[colors]
# base24 Desert
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdbb9b
foreground_bold     = #cdbb9b
cursor              = #cdbb9b
cursor_foreground   = #333333
background          = #333333

# base00 - Black
color0  = #333333
# base08 - Red
color1  = #ff2b2b
# base0B - Green
color2  = #98fb98
# base0A - Yellow
color3  = #87ceff
# base0D - Blue
color4  = #cd853f
# base0E - Magenta
color5  = #ffdead
# base0C - Cyan
color6  = #ffa0a0
# base05 - White
color7  = #cdbb9b
# base03 - Bright Black
color8  = #7d776c
# base12 - Bright Red
color9  = #ff5555
# base14 - Bright Green
color10 = #55ff55
# base13 - Bright Yellow
color11 = #ffff55
# base16 - Bright Blue
color12 = #87ceff
# base17 - Bright Magenta
color13 = #ff55ff
# base15 - Bright Cyan
color14 = #ffd700
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f0e68c
# base0F
color17 = #7f1515
# base01
color18 = #4d4d4d
# base02
color19 = #555555
# base04
color20 = #a59984
# base06
color21 = #f5deb3
