[colors]
# base16 Bright
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e0e0e0
foreground_bold     = #e0e0e0
cursor              = #e0e0e0
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #fb0120
# base0B - Green
color2  = #a1c659
# base0A - Yellow
color3  = #fda331
# base0D - Blue
color4  = #6fb3d2
# base0E - Magenta
color5  = #d381c3
# base0C - Cyan
color6  = #76c7b7
# base05 - White
color7  = #e0e0e0
# base03 - Bright Black
color8  = #b0b0b0
# base08 - Bright Red
color9  = #fb0120
# base0B - Bright Green
color10 = #a1c659
# base0A - Bright Yellow
color11 = #fda331
# base0D - Bright Blue
color12 = #6fb3d2
# base0E - Bright Magenta
color13 = #d381c3
# base0C - Bright Cyan
color14 = #76c7b7
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fc6d24
# base0F
color17 = #be643c
# base01
color18 = #303030
# base02
color19 = #505050
# base04
color20 = #d0d0d0
# base06
color21 = #f5f5f5
