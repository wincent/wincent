[colors]
# base16 standardized-dark
# Scheme author: ali (https://github.com/ali-githb/base16-standardized-scheme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c0c0c0
foreground_bold     = #c0c0c0
cursor              = #c0c0c0
cursor_foreground   = #222222
background          = #222222

# base00 - Black
color0  = #222222
# base08 - Red
color1  = #e15d67
# base0B - Green
color2  = #5db129
# base0A - Yellow
color3  = #e1b31a
# base0D - Blue
color4  = #00a3f2
# base0E - Magenta
color5  = #b46ee0
# base0C - Cyan
color6  = #21c992
# base05 - White
color7  = #c0c0c0
# base03 - Bright Black
color8  = #898989
# base08 - Bright Red
color9  = #e15d67
# base0B - Bright Green
color10 = #5db129
# base0A - Bright Yellow
color11 = #e1b31a
# base0D - Bright Blue
color12 = #00a3f2
# base0E - Bright Magenta
color13 = #b46ee0
# base0C - Bright Cyan
color14 = #21c992
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fc804e
# base0F
color17 = #b87d28
# base01
color18 = #303030
# base02
color19 = #555555
# base04
color20 = #898989
# base06
color21 = #e0e0e0
