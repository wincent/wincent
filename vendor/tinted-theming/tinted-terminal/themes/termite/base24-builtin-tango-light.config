[colors]
# base24 Builtin Tango Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #b3b7b0
foreground_bold     = #b3b7b0
cursor              = #b3b7b0
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #cc0000
# base0B - Green
color2  = #4e9a05
# base0A - Yellow
color3  = #719ecf
# base0D - Blue
color4  = #3464a4
# base0E - Magenta
color5  = #74507a
# base0C - Cyan
color6  = #05989a
# base05 - White
color7  = #b3b7b0
# base03 - Bright Black
color8  = #737772
# base12 - Bright Red
color9  = #ef2828
# base14 - Bright Green
color10 = #8ae234
# base13 - Bright Yellow
color11 = #fce94e
# base16 - Bright Blue
color12 = #719ecf
# base17 - Bright Magenta
color13 = #ad7ea7
# base15 - Bright Cyan
color14 = #34e2e2
# base07 - Bright White
color15 = #ededec
# base09
color16 = #c4a000
# base0F
color17 = #660000
# base01
color18 = #000000
# base02
color19 = #545753
# base04
color20 = #939791
# base06
color21 = #d3d7cf
