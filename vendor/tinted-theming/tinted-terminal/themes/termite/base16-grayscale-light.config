[colors]
# base16 Grayscale Light
# Scheme author: Alexandre Gavioli (https://github.com/Alexx2/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #464646
foreground_bold     = #464646
cursor              = #464646
cursor_foreground   = #f7f7f7
background          = #f7f7f7

# base00 - Black
color0  = #f7f7f7
# base08 - Red
color1  = #7c7c7c
# base0B - Green
color2  = #8e8e8e
# base0A - Yellow
color3  = #a0a0a0
# base0D - Blue
color4  = #686868
# base0E - Magenta
color5  = #747474
# base0C - Cyan
color6  = #868686
# base05 - White
color7  = #464646
# base03 - Bright Black
color8  = #ababab
# base08 - Bright Red
color9  = #7c7c7c
# base0B - Bright Green
color10 = #8e8e8e
# base0A - Bright Yellow
color11 = #a0a0a0
# base0D - Bright Blue
color12 = #686868
# base0E - Bright Magenta
color13 = #747474
# base0C - Bright Cyan
color14 = #868686
# base07 - Bright White
color15 = #101010
# base09
color16 = #999999
# base0F
color17 = #5e5e5e
# base01
color18 = #e3e3e3
# base02
color19 = #b9b9b9
# base04
color20 = #525252
# base06
color21 = #252525
