[colors]
# base16 Unikitty Light
# Scheme author: Josh W Lewis (@joshwlewis)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #6c696e
foreground_bold     = #6c696e
cursor              = #6c696e
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #d8137f
# base0B - Green
color2  = #17ad98
# base0A - Yellow
color3  = #dc8a0e
# base0D - Blue
color4  = #775dff
# base0E - Magenta
color5  = #aa17e6
# base0C - Cyan
color6  = #149bda
# base05 - White
color7  = #6c696e
# base03 - Bright Black
color8  = #a7a5a8
# base08 - Bright Red
color9  = #d8137f
# base0B - Bright Green
color10 = #17ad98
# base0A - Bright Yellow
color11 = #dc8a0e
# base0D - Bright Blue
color12 = #775dff
# base0E - Bright Magenta
color13 = #aa17e6
# base0C - Bright Cyan
color14 = #149bda
# base07 - Bright White
color15 = #322d34
# base09
color16 = #d65407
# base0F
color17 = #e013d0
# base01
color18 = #e1e1e2
# base02
color19 = #c4c3c5
# base04
color20 = #89878b
# base06
color21 = #4f4b51
