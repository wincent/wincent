[colors]
# base16 Sequoia Monochrome Light
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #282930
foreground_bold     = #282930
cursor              = #282930
cursor_foreground   = #edeef2
background          = #edeef2

color0  = #edeef2 # base00 - Black
color1  = #525666 # base08 - Red
color2  = #2e3038 # base0B - Green
color3  = #50535e # base0A - Yellow
color4  = #5f6370 # base0D - Blue
color5  = #50535e # base0E - Magenta
color6  = #454752 # base0C - Cyan
color7  = #282930 # base05 - White
color8  = #9da2ad # base03 - Bright Black
color9  = #525666 # base08 - Bright Red
color10 = #2e3038 # base0B - Bright Green
color11 = #50535e # base0A - Bright Yellow
color12 = #5f6370 # base0D - Bright Blue
color13 = #50535e # base0E - Bright Magenta
color14 = #454752 # base0C - Bright Cyan
color15 = #0f1014 # base07 - Bright White
color16 = #525666 # base09
color17 = #2e3038 # base0F
color18 = #e2e3e8 # base01
color19 = #e2e3e8 # base02
color20 = #42434e # base04
color21 = #282930 # base06
