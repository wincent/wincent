[colors]
# base16 Solarized Light
# Scheme author: Ethan Schoonover (modified by aramisgithub)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #586e75
foreground_bold     = #586e75
cursor              = #586e75
cursor_foreground   = #fdf6e3
background          = #fdf6e3

# base00 - Black
color0  = #fdf6e3
# base08 - Red
color1  = #dc322f
# base0B - Green
color2  = #859900
# base0A - Yellow
color3  = #b58900
# base0D - Blue
color4  = #268bd2
# base0E - Magenta
color5  = #6c71c4
# base0C - Cyan
color6  = #2aa198
# base05 - White
color7  = #586e75
# base03 - Bright Black
color8  = #839496
# base08 - Bright Red
color9  = #dc322f
# base0B - Bright Green
color10 = #859900
# base0A - Bright Yellow
color11 = #b58900
# base0D - Bright Blue
color12 = #268bd2
# base0E - Bright Magenta
color13 = #6c71c4
# base0C - Bright Cyan
color14 = #2aa198
# base07 - Bright White
color15 = #002b36
# base09
color16 = #cb4b16
# base0F
color17 = #d33682
# base01
color18 = #eee8d5
# base02
color19 = #93a1a1
# base04
color20 = #657b83
# base06
color21 = #073642
