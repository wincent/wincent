[colors]
# base16 Chinoiserie
# Scheme author: Di Wang (https://cs.cmu.edu/~diw3)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #4a4035
foreground_bold     = #4a4035
cursor              = #4a4035
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #c04851
# base0B - Green
color2  = #428675
# base0A - Yellow
color3  = #d6a01d
# base0D - Blue
color4  = #815c94
# base0E - Magenta
color5  = #c08eaf
# base0C - Cyan
color6  = #2b73af
# base05 - White
color7  = #4a4035
# base03 - Bright Black
color8  = #80766e
# base08 - Bright Red
color9  = #c04851
# base0B - Bright Green
color10 = #428675
# base0A - Bright Yellow
color11 = #d6a01d
# base0D - Bright Blue
color12 = #815c94
# base0E - Bright Magenta
color13 = #c08eaf
# base0C - Bright Cyan
color14 = #2b73af
# base07 - Bright White
color15 = #131124
# base09
color16 = #fb8b05
# base0F
color17 = #945833
# base01
color18 = #e0e0e0
# base02
color19 = #d6d6d6
# base04
color20 = #918072
# base06
color21 = #2f2f35
