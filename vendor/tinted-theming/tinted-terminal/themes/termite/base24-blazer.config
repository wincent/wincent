[colors]
# base24 Blazer
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #acacac
foreground_bold     = #acacac
cursor              = #acacac
cursor_foreground   = #0d1926
background          = #0d1926

# base00 - Black
color0  = #0d1926
# base08 - Red
color1  = #b87a7a
# base0B - Green
color2  = #7ab87a
# base0A - Yellow
color3  = #bdbddb
# base0D - Blue
color4  = #7a7ab8
# base0E - Magenta
color5  = #b87ab8
# base0C - Cyan
color6  = #7ab8b8
# base05 - White
color7  = #acacac
# base03 - Bright Black
color8  = #525252
# base12 - Bright Red
color9  = #dbbdbd
# base14 - Bright Green
color10 = #bddbbd
# base13 - Bright Yellow
color11 = #dbdbbd
# base16 - Bright Blue
color12 = #bdbddb
# base17 - Bright Magenta
color13 = #dbbddb
# base15 - Bright Cyan
color14 = #bddbdb
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #b8b87a
# base0F
color17 = #5c3d3d
# base01
color18 = #000000
# base02
color19 = #262626
# base04
color20 = #7f7f7f
# base06
color21 = #d9d9d9
