[colors]
# base24 Broadcast
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cbcbcb
foreground_bold     = #cbcbcb
cursor              = #cbcbcb
cursor_foreground   = #2b2b2b
background          = #2b2b2b

# base00 - Black
color0  = #2b2b2b
# base08 - Red
color1  = #da4939
# base0B - Green
color2  = #519f50
# base0A - Yellow
color3  = #9fcef0
# base0D - Blue
color4  = #6d9cbe
# base0E - Magenta
color5  = #d0d0ff
# base0C - Cyan
color6  = #6e9cbe
# base05 - White
color7  = #cbcbcb
# base03 - Bright Black
color8  = #656565
# base12 - Bright Red
color9  = #ff7b6b
# base14 - Bright Green
color10 = #83d182
# base13 - Bright Yellow
color11 = #ffff7c
# base16 - Bright Blue
color12 = #9fcef0
# base17 - Bright Magenta
color13 = #ffffff
# base15 - Bright Cyan
color14 = #a0cef0
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffd24a
# base0F
color17 = #6d241c
# base01
color18 = #000000
# base02
color19 = #323232
# base04
color20 = #989898
# base06
color21 = #ffffff
