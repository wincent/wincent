[colors]
# base24 Tokio
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #f7f1ff
foreground_bold     = #f7f1ff
cursor              = #f7f1ff
cursor_foreground   = #1c1c1d
background          = #1c1c1d

color0  = #1c1c1d # base00 - Black
color1  = #fc618d # base08 - Red
color2  = #7bd88f # base0B - Green
color3  = #fce566 # base0A - Yellow
color4  = #fd9353 # base0D - Blue
color5  = #948ae3 # base0E - Magenta
color6  = #5ad4e6 # base0C - Cyan
color7  = #f7f1ff # base05 - White
color8  = #78757c # base03 - Bright Black
color9  = #fc618d # base12 - Bright Red
color10 = #7bd88f # base14 - Bright Green
color11 = #fce566 # base13 - Bright Yellow
color12 = #fd9353 # base16 - Bright Blue
color13 = #948ae3 # base17 - Bright Magenta
color14 = #5ad4e6 # base15 - Bright Cyan
color15 = #f7f1ff # base07 - Bright White
color16 = #fca37a # base09
color17 = #ae7459 # base0F
color18 = #2b2b2d # base01
color19 = #363638 # base02
color20 = #949199 # base04
color21 = #f9f4ff # base06
