[colors]
# base24 Paris
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #f7f1ff
foreground_bold     = #f7f1ff
cursor              = #f7f1ff
cursor_foreground   = #1a0a30
background          = #1a0a30

color0  = #1a0a30 # base00 - Black
color1  = #fc618d # base08 - Red
color2  = #7bd88f # base0B - Green
color3  = #fce566 # base0A - Yellow
color4  = #a3f3ff # base0D - Blue
color5  = #c4bdff # base0E - Magenta
color6  = #a3f3ff # base0C - Cyan
color7  = #f7f1ff # base05 - White
color8  = #c4bdff # base03 - Bright Black
color9  = #fc618d # base12 - Bright Red
color10 = #7bd88f # base14 - Bright Green
color11 = #fce566 # base13 - Bright Yellow
color12 = #a3f3ff # base16 - Bright Blue
color13 = #c4bdff # base17 - Bright Magenta
color14 = #a3f3ff # base15 - Bright Cyan
color15 = #f7f1ff # base07 - Bright White
color16 = #fca37a # base09
color17 = #ad6d60 # base0F
color18 = #291a3e # base01
color19 = #352649 # base02
color20 = #9489a2 # base04
color21 = #f9f4ff # base06
