[colors]
# base16 Horizon Terminal Dark
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cbced0
foreground_bold     = #cbced0
cursor              = #cbced0
cursor_foreground   = #1c1e26
background          = #1c1e26

# base00 - Black
color0  = #1c1e26
# base08 - Red
color1  = #e95678
# base0B - Green
color2  = #29d398
# base0A - Yellow
color3  = #fac29a
# base0D - Blue
color4  = #26bbd9
# base0E - Magenta
color5  = #ee64ac
# base0C - Cyan
color6  = #59e1e3
# base05 - White
color7  = #cbced0
# base03 - Bright Black
color8  = #6f6f70
# base08 - Bright Red
color9  = #e95678
# base0B - Bright Green
color10 = #29d398
# base0A - Bright Yellow
color11 = #fac29a
# base0D - Bright Blue
color12 = #26bbd9
# base0E - Bright Magenta
color13 = #ee64ac
# base0C - Bright Cyan
color14 = #59e1e3
# base07 - Bright White
color15 = #e3e6ee
# base09
color16 = #fab795
# base0F
color17 = #f09383
# base01
color18 = #232530
# base02
color19 = #2e303e
# base04
color20 = #9da0a2
# base06
color21 = #dcdfe4
