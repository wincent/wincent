color3  = #a0d6ff
# base0D - Blue
color4  = #399bda
# base0E - Magenta
color5  = #bb00bb
# base0C - Cyan
color6  = #00bbbb
# base05 - White
color7  = #a1a1a1
# base03 - Bright Black
color8  = #6e6e6e
# base12 - Bright Red
color9  = #ff0003
# base14 - Bright Green
color10 = #92c763
# base13 - Bright Yellow
color11 = #fef773
# base16 - Bright Blue
color12 = #a0d6ff
# base17 - Bright Magenta
color13 = #ff55ff
# base15 - Bright Cyan
color14 = #55ffff
# base07 - Bright White
color15 = #ffffff
