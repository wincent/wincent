[colors]
# base16 pinky
# Scheme author: Benjamin (https://github.com/b3nj5m1n)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #f5f5f5
foreground_bold     = #f5f5f5
cursor              = #f5f5f5
cursor_foreground   = #171517
background          = #171517

# base00 - Black
color0  = #171517
# base08 - Red
color1  = #ffa600
# base0B - Green
color2  = #ff0066
# base0A - Yellow
color3  = #20df6c
# base0D - Blue
color4  = #00ffff
# base0E - Magenta
color5  = #007fff
# base0C - Cyan
color6  = #6600ff
# base05 - White
color7  = #f5f5f5
# base03 - Bright Black
color8  = #383338
# base08 - Bright Red
color9  = #ffa600
# base0B - Bright Green
color10 = #ff0066
# base0A - Bright Yellow
color11 = #20df6c
# base0D - Bright Blue
color12 = #00ffff
# base0E - Bright Magenta
color13 = #007fff
# base0C - Bright Cyan
color14 = #6600ff
# base07 - Bright White
color15 = #f7f3f7
# base09
color16 = #00ff66
# base0F
color17 = #df206c
# base01
color18 = #1b181b
# base02
color19 = #1d1b1d
# base04
color20 = #e7dbdb
# base06
color21 = #ffffff
