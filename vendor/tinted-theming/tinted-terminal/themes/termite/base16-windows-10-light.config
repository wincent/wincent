[colors]
# base16 Windows 10 Light
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #767676
foreground_bold     = #767676
cursor              = #767676
cursor_foreground   = #f2f2f2
background          = #f2f2f2

# base00 - Black
color0  = #f2f2f2
# base08 - Red
color1  = #c50f1f
# base0B - Green
color2  = #13a10e
# base0A - Yellow
color3  = #c19c00
# base0D - Blue
color4  = #0037da
# base0E - Magenta
color5  = #881798
# base0C - Cyan
color6  = #3a96dd
# base05 - White
color7  = #767676
# base03 - Bright Black
color8  = #cccccc
# base08 - Bright Red
color9  = #c50f1f
# base0B - Bright Green
color10 = #13a10e
# base0A - Bright Yellow
color11 = #c19c00
# base0D - Bright Blue
color12 = #0037da
# base0E - Bright Magenta
color13 = #881798
# base0C - Bright Cyan
color14 = #3a96dd
# base07 - Bright White
color15 = #0c0c0c
# base09
color16 = #f9f1a5
# base0F
color17 = #16c60c
# base01
color18 = #e5e5e5
# base02
color19 = #d9d9d9
# base04
color20 = #ababab
# base06
color21 = #414141
