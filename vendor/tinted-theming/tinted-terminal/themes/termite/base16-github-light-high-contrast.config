[colors]
# base16 Github Light High Contrast
# Scheme author: Tinted Theming (https://github.com/tinted-theming)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #454c54
foreground_bold     = #454c54
cursor              = #454c54
cursor_foreground   = #ffffff
background          = #ffffff

# base00 - Black
color0  = #ffffff
# base08 - Red
color1  = #a0111f
# base0B - Green
color2  = #024c1a
# base0A - Yellow
color3  = #603700
# base0D - Blue
color4  = #0349b4
# base0E - Magenta
color5  = #622cbc
# base0C - Cyan
color6  = #1b7c83
# base05 - White
color7  = #454c54
# base03 - Bright Black
color8  = #818b98
# base08 - Bright Red
color9  = #a0111f
# base0B - Bright Green
color10 = #024c1a
# base0A - Bright Yellow
color11 = #603700
# base0D - Bright Blue
color12 = #0349b4
# base0E - Bright Magenta
color13 = #622cbc
# base0C - Bright Cyan
color14 = #1b7c83
# base07 - Bright White
color15 = #010409
# base09
color16 = #702c00
# base0F
color17 = #86061d
# base01
color18 = #f6f8fa
