[colors]
# base16 selenized-dark
# Scheme author: Jan Warchol (https://github.com/jan-warchol/selenized) / adapted to base16 by ali
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #adbcbc
foreground_bold     = #adbcbc
cursor              = #adbcbc
cursor_foreground   = #103c48
background          = #103c48

# base00 - Black
color0  = #103c48
# base08 - Red
color1  = #fa5750
# base0B - Green
color2  = #75b938
# base0A - Yellow
color3  = #dbb32d
# base0D - Blue
color4  = #4695f7
# base0E - Magenta
color5  = #af88eb
# base0C - Cyan
color6  = #41c7b9
# base05 - White
color7  = #adbcbc
# base03 - Bright Black
color8  = #72898f
# base08 - Bright Red
color9  = #fa5750
# base0B - Bright Green
color10 = #75b938
# base0A - Bright Yellow
color11 = #dbb32d
# base0D - Bright Blue
color12 = #4695f7
# base0E - Bright Magenta
color13 = #af88eb
# base0C - Bright Cyan
color14 = #41c7b9
# base07 - Bright White
color15 = #cad8d9
# base09
color16 = #ed8649
# base0F
color17 = #f275be
# base01
color18 = #184956
# base02
color19 = #2d5b69
# base04
color20 = #72898f
# base06
color21 = #cad8d9
