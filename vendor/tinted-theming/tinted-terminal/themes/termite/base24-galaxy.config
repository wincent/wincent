[colors]
# base24 Galaxy
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a1a1a1
foreground_bold     = #a1a1a1
cursor              = #a1a1a1
cursor_foreground   = #1c2836
background          = #1c2836

# base00 - Black
color0  = #1c2836
# base08 - Red
color1  = #f9555f
# base0B - Green
color2  = #20af89
# base0A - Yellow
color3  = #fdf029
# base0D - Blue
color4  = #589cf5
# base0E - Magenta
color5  = #934d95
# base0C - Cyan
color6  = #1e9ee6
# base05 - White
color7  = #a1a1a1
# base03 - Bright Black
color8  = #6e6e6e
# base12 - Bright Red
color9  = #fa8b8e
# base14 - Bright Green
color10 = #34bb99
# base13 - Bright Yellow
color11 = #ffff55
# base16 - Bright Blue
color12 = #589cf5
# base17 - Bright Magenta
color13 = #e75598
# base15 - Bright Cyan
color14 = #3978bb
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #fdba29
# base0F
color17 = #7c2a2f
# base01
color18 = #000000
# base02
color19 = #555555
# base04
color20 = #888888
# base06
color21 = #bbbbbb
