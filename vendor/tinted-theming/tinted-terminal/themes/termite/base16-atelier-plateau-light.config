color3  = #a06e3b
# base0D - Blue
color4  = #7272ca
# base0E - Magenta
color5  = #8464c4
# base0C - Cyan
color6  = #5485b6
# base05 - White
color7  = #585050
# base03 - Bright Black
color8  = #7e7777
# base08 - Bright Red
color9  = #ca4949
# base0B - Bright Green
color10 = #4b8b8b
# base0A - Bright Yellow
color11 = #a06e3b
# base0D - Bright Blue
color12 = #7272ca
