[colors]
# base24 Lab Fox
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cfd0d0
foreground_bold     = #cfd0d0
cursor              = #cfd0d0
cursor_foreground   = #2e2e2e
background          = #2e2e2e

# base00 - Black
color0  = #2e2e2e
# base08 - Red
color1  = #fc6d26
# base0B - Green
color2  = #3eb383
# base0A - Yellow
color3  = #db501f
# base0D - Blue
color4  = #db3b21
# base0E - Magenta
color5  = #380d75
# base0C - Cyan
color6  = #6e49cb
# base05 - White
color7  = #cfd0d0
# base03 - Bright Black
color8  = #737373
# base12 - Bright Red
color9  = #ff6517
# base14 - Bright Green
color10 = #52e9a8
# base13 - Bright Yellow
color11 = #fca012
# base16 - Bright Blue
color12 = #db501f
# base17 - Bright Magenta
color13 = #441090
# base15 - Bright Cyan
color14 = #7d53e7
# base07 - Bright White
color15 = #feffff
# base09
color16 = #fca121
# base0F
color17 = #7e3613
# base01
color18 = #2e2e2e
# base02
color19 = #454545
# base04
color20 = #a1a2a2
# base06
color21 = #feffff
