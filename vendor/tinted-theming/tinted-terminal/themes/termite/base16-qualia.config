color5  = #e0af85
# base0C - Cyan
color6  = #c8c874
# base05 - White
color7  = #c0c0c0
# base03 - Bright Black
color8  = #454545
# base08 - Bright Red
color9  = #efa6a2
# base0B - Bright Green
color10 = #80c990
# base0A - Bright Yellow
color11 = #e6a3dc
# base0D - Bright Blue
color12 = #50cacd
# base0E - Bright Magenta
color13 = #e0af85
# base0C - Bright Cyan
color14 = #c8c874
# base07 - Bright White
color15 = #454545
# base09
color16 = #a3b8ef
# base0F
color17 = #808080
