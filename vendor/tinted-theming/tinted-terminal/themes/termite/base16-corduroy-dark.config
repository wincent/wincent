color3  = #f0bd9c # base0A - Yellow
color4  = #dc92a3 # base0D - Blue
color5  = #cf98c4 # base0E - Magenta
color6  = #f0a89b # base0C - Cyan
color7  = #ddd8df # base05 - White
color8  = #7d7082 # base03 - Bright Black
color9  = #e8758a # base08 - Bright Red
color10 = #55a0a0 # base0B - Bright Green
color11 = #f0bd9c # base0A - Bright Yellow
color12 = #dc92a3 # base0D - Bright Blue
color13 = #cf98c4 # base0E - Bright Magenta
color14 = #f0a89b # base0C - Bright Cyan
color15 = #5a5160 # base07 - Bright White
color16 = #f0a89b # base09
color17 = #9a8d9e # base0F
color18 = #1b151e # base01
