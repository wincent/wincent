[colors]
# base16 Moonlight
# Scheme author: Jeremy Swinarton (https://github.com/jswinarton)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a3ace1
foreground_bold     = #a3ace1
cursor              = #a3ace1
cursor_foreground   = #212337
background          = #212337

# base00 - Black
color0  = #212337
# base08 - Red
color1  = #ff5370
# base0B - Green
color2  = #2df4c0
# base0A - Yellow
color3  = #ffc777
# base0D - Blue
color4  = #40ffff
# base0E - Magenta
color5  = #b994f1
# base0C - Cyan
color6  = #04d1f9
# base05 - White
color7  = #a3ace1
# base03 - Bright Black
color8  = #748cd6
# base08 - Bright Red
color9  = #ff5370
# base0B - Bright Green
color10 = #2df4c0
# base0A - Bright Yellow
color11 = #ffc777
# base0D - Bright Blue
color12 = #40ffff
# base0E - Bright Magenta
color13 = #b994f1
# base0C - Bright Cyan
color14 = #04d1f9
# base07 - Bright White
color15 = #ef43fa
# base09
color16 = #f67f81
# base0F
color17 = #ecb2f0
# base01
color18 = #403c64
# base02
color19 = #596399
# base04
color20 = #a1abe0
# base06
color21 = #b4a4f4
