[colors]
# base24 Vibrant Ink
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdcdcd
foreground_bold     = #cdcdcd
cursor              = #cdcdcd
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff6600
# base0B - Green
color2  = #ccff04
# base0A - Yellow
color3  = #0000ff
# base0D - Blue
color4  = #44b3cc
# base0E - Magenta
color5  = #9933cc
# base0C - Cyan
color6  = #44b3cc
# base05 - White
color7  = #cdcdcd
# base03 - Bright Black
color8  = #7d7d7d
# base12 - Bright Red
color9  = #ff0000
# base14 - Bright Green
color10 = #00ff00
# base13 - Bright Yellow
color11 = #ffff00
# base16 - Bright Blue
color12 = #0000ff
# base17 - Bright Magenta
color13 = #ff00ff
# base15 - Bright Cyan
color14 = #00ffff
# base07 - Bright White
color15 = #e5e5e5
# base09
color16 = #ffcc00
# base0F
color17 = #7f3300
# base01
color18 = #878787
# base02
color19 = #555555
# base04
color20 = #a5a5a5
# base06
color21 = #f5f5f5
