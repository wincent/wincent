color2  = #027c9b
# base0A - Yellow
color3  = #1bbcdd
# base0D - Blue
color4  = #1e4950
# base0E - Magenta
color5  = #68d3f1
# base0C - Cyan
color6  = #50a3b5
# base05 - White
color7  = #b79c7e
# base03 - Bright Black
color8  = #696660
# base12 - Bright Red
color9  = #d38677
# base14 - Bright Green
color10 = #618c98
# base13 - Bright Yellow
color11 = #fdd29e
# base16 - Bright Blue
color12 = #1bbcdd
# base17 - Bright Magenta
color13 = #bbe3ee
# base15 - Bright Cyan
color14 = #86abb3
# base07 - Bright White
color15 = #fee3cd
