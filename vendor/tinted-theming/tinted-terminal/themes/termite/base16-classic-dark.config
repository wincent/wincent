color2  = #90a959
# base0A - Yellow
color3  = #f4bf75
# base0D - Blue
color4  = #6a9fb5
# base0E - Magenta
color5  = #aa759f
# base0C - Cyan
color6  = #75b5aa
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #505050
# base08 - Bright Red
color9  = #ac4142
# base0B - Bright Green
color10 = #90a959
# base0A - Bright Yellow
color11 = #f4bf75
# base0D - Bright Blue
color12 = #6a9fb5
# base0E - Bright Magenta
color13 = #aa759f
# base0C - Bright Cyan
color14 = #75b5aa
# base07 - Bright White
color15 = #f5f5f5
# base09
color16 = #d28445
# base0F
color17 = #8f5536
# base01
color18 = #202020
