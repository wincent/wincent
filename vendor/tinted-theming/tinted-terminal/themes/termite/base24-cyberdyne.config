[colors]
# base24 Cyberdyne
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c0c0c0
foreground_bold     = #c0c0c0
cursor              = #c0c0c0
cursor_foreground   = #151144
background          = #151144

# base00 - Black
color0  = #151144
# base08 - Red
color1  = #ff8272
# base0B - Green
color2  = #00c172
# base0A - Yellow
color3  = #c1e3fe
# base0D - Blue
color4  = #0071cf
# base0E - Magenta
color5  = #ff8ffd
# base0C - Cyan
color6  = #6bffdc
# base05 - White
color7  = #c0c0c0
# base03 - Bright Black
color8  = #5e5e5e
# base12 - Bright Red
color9  = #ffc4bd
# base14 - Bright Green
color10 = #d6fcb9
# base13 - Bright Yellow
color11 = #fefdd5
# base16 - Bright Blue
color12 = #c1e3fe
# base17 - Bright Magenta
color13 = #ffb1fe
# base15 - Bright Cyan
color14 = #e5e6fe
# base07 - Bright White
color15 = #feffff
# base09
color16 = #d2a700
# base0F
color17 = #7f4139
# base01
color18 = #080808
# base02
color19 = #2d2d2d
# base04
color20 = #8f8f8f
# base06
color21 = #f1f1f1
