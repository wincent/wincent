[colors]
# base16 Chinoiserie Night
# Scheme author: Di Wang (https://cs.cmu.edu/~diw3)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c4cbcf
foreground_bold     = #c4cbcf
cursor              = #c4cbcf
cursor_foreground   = #1d1d1d
background          = #1d1d1d

# base00 - Black
color0  = #1d1d1d
# base08 - Red
color1  = #f07c82
# base0B - Green
color2  = #b2cf87
# base0A - Yellow
color3  = #f4ce69
# base0D - Blue
color4  = #8fb2c9
# base0E - Magenta
color5  = #be9db9
# base0C - Cyan
color6  = #b0d5df
# base05 - White
color7  = #c4cbcf
# base03 - Bright Black
color8  = #918072
# base08 - Bright Red
color9  = #f07c82
# base0B - Bright Green
color10 = #b2cf87
# base0A - Bright Yellow
color11 = #f4ce69
# base0D - Bright Blue
color12 = #8fb2c9
# base0E - Bright Magenta
color13 = #be9db9
# base0C - Bright Cyan
color14 = #b0d5df
# base07 - Bright White
color15 = #fffef9
# base09
color16 = #f4a83a
# base0F
color17 = #b89485
# base01
color18 = #282828
# base02
color19 = #373737
# base04
color20 = #bdaead
# base06
color21 = #eee7f2
