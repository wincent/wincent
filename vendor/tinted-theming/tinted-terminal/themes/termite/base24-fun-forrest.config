color3  = #7cc9ce
# base0D - Blue
color4  = #4698a2
# base0E - Magenta
color5  = #8c4231
# base0C - Cyan
color6  = #d98112
# base05 - White
color7  = #c5ab60
# base03 - Bright Black
color8  = #957f58
# base12 - Bright Red
color9  = #e4591b
# base14 - Bright Green
color10 = #bfc659
# base13 - Bright Yellow
color11 = #ffca1b
# base16 - Bright Blue
color12 = #7cc9ce
# base17 - Bright Magenta
color13 = #d16349
# base15 - Bright Cyan
color14 = #e6a96b
# base07 - Bright White
color15 = #ffe9a3
# base09
color16 = #bd8a13
# base0F
color17 = #6a1215
# base01
color18 = #000000
