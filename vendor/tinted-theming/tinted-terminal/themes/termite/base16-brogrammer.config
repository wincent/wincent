[colors]
# base16 Brogrammer
# Scheme author: Vik Ramanujam (http://github.com/piggyslasher)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #4e5ab7
foreground_bold     = #4e5ab7
cursor              = #4e5ab7
cursor_foreground   = #1f1f1f
background          = #1f1f1f

# base00 - Black
color0  = #1f1f1f
# base08 - Red
color1  = #d6dbe5
# base0B - Green
color2  = #f3bd09
# base0A - Yellow
color3  = #1dd361
# base0D - Blue
color4  = #5350b9
# base0E - Magenta
color5  = #0f7ddb
# base0C - Cyan
color6  = #1081d6
# base05 - White
color7  = #4e5ab7
# base03 - Bright Black
color8  = #ecba0f
# base08 - Bright Red
color9  = #d6dbe5
# base0B - Bright Green
color10 = #f3bd09
# base0A - Bright Yellow
color11 = #1dd361
# base0D - Bright Blue
color12 = #5350b9
# base0E - Bright Magenta
color13 = #0f7ddb
# base0C - Bright Cyan
color14 = #1081d6
# base07 - Bright White
color15 = #d6dbe5
# base09
color16 = #de352e
# base0F
color17 = #ffffff
# base01
color18 = #f81118
# base02
color19 = #2dc55e
# base04
color20 = #2a84d2
# base06
color21 = #1081d6
