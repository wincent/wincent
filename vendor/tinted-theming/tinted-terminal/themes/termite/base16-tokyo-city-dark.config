color2  = #9ece6a
# base0A - Yellow
color3  = #b7c5d3
# base0D - Blue
color4  = #7aa2f7
# base0E - Magenta
color5  = #bb9af7
# base0C - Cyan
color6  = #89ddff
# base05 - White
color7  = #d8e2ec
# base03 - Bright Black
color8  = #526270
# base08 - Bright Red
color9  = #f7768e
# base0B - Bright Green
color10 = #9ece6a
# base0A - Bright Yellow
color11 = #b7c5d3
# base0D - Bright Blue
color12 = #7aa2f7
# base0E - Bright Magenta
color13 = #bb9af7
# base0C - Bright Cyan
color14 = #89ddff
# base07 - Bright White
color15 = #fbfbfd
# base09
color16 = #ff9e64
# base0F
color17 = #bb9af7
# base01
color18 = #1d252c
