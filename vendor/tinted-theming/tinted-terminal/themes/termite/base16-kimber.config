[colors]
# base16 Kimber
# Scheme author: Mishka Nguyen (https://github.com/akhsiM)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dedee7
foreground_bold     = #dedee7
cursor              = #dedee7
cursor_foreground   = #222222
background          = #222222

# base00 - Black
color0  = #222222
# base08 - Red
color1  = #c88c8c
# base0B - Green
color2  = #99c899
# base0A - Yellow
color3  = #d8b56d
# base0D - Blue
color4  = #537c9c
# base0E - Magenta
color5  = #86cacd
# base0C - Cyan
color6  = #78b4b4
# base05 - White
color7  = #dedee7
# base03 - Bright Black
color8  = #644646
# base08 - Bright Red
color9  = #c88c8c
# base0B - Bright Green
color10 = #99c899
# base0A - Bright Yellow
color11 = #d8b56d
# base0D - Bright Blue
color12 = #537c9c
# base0E - Bright Magenta
color13 = #86cacd
# base0C - Bright Cyan
color14 = #78b4b4
# base07 - Bright White
color15 = #ffffe6
# base09
color16 = #476c88
# base0F
color17 = #704f4f
# base01
color18 = #313131
# base02
color19 = #555d55
# base04
color20 = #5a5a5a
# base06
color21 = #c3c3b4
