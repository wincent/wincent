[colors]
# base24 Argonaut
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d0d0
foreground_bold     = #d0d0d0
cursor              = #d0d0d0
cursor_foreground   = #0d0f18
background          = #0d0f18

# base00 - Black
color0  = #0d0f18
# base08 - Red
color1  = #ff000f
# base0B - Green
color2  = #8ce00a
# base0A - Yellow
color3  = #0092ff
# base0D - Blue
color4  = #008df8
# base0E - Magenta
color5  = #6c43a5
# base0C - Cyan
color6  = #00d7eb
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #727272
# base12 - Bright Red
color9  = #ff273f
# base14 - Bright Green
color10 = #abe05a
# base13 - Bright Yellow
color11 = #ffd141
# base16 - Bright Blue
color12 = #0092ff
# base17 - Bright Magenta
color13 = #9a5feb
# base15 - Bright Cyan
color14 = #67ffef
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffb900
# base0F
color17 = #7f0007
# base01
color18 = #222222
# base02
color19 = #444444
# base04
color20 = #a1a1a1
# base06
color21 = #ffffff
