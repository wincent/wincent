[colors]
# base16 Decaf
# Scheme author: Alex Mirrington (https://github.com/alexmirrington)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cccccc
foreground_bold     = #cccccc
cursor              = #cccccc
cursor_foreground   = #2d2d2d
background          = #2d2d2d

# base00 - Black
color0  = #2d2d2d
# base08 - Red
color1  = #ff7f7b
# base0B - Green
color2  = #beda78
# base0A - Yellow
color3  = #ffd67c
# base0D - Blue
color4  = #90bee1
# base0E - Magenta
color5  = #efb3f7
# base0C - Cyan
color6  = #bed6ff
# base05 - White
color7  = #cccccc
# base03 - Bright Black
color8  = #777777
# base08 - Bright Red
color9  = #ff7f7b
# base0B - Bright Green
color10 = #beda78
# base0A - Bright Yellow
color11 = #ffd67c
# base0D - Bright Blue
color12 = #90bee1
# base0E - Bright Magenta
color13 = #efb3f7
# base0C - Bright Cyan
color14 = #bed6ff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffbf70
# base0F
color17 = #ff93b3
# base01
color18 = #393939
# base02
color19 = #515151
# base04
color20 = #b4b7b4
# base06
color21 = #e0e0e0
