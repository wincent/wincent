[colors]
# base16 Gruvbox dark, pale
# Scheme author: Dawid Kurek (dawikur@gmail.com), morhetz (https://github.com/morhetz/gruvbox)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dab997
foreground_bold     = #dab997
cursor              = #dab997
cursor_foreground   = #262626
background          = #262626

# base00 - Black
color0  = #262626
# base08 - Red
color1  = #d75f5f
# base0B - Green
color2  = #afaf00
# base0A - Yellow
color3  = #ffaf00
# base0D - Blue
color4  = #83adad
# base0E - Magenta
color5  = #d485ad
# base0C - Cyan
color6  = #85ad85
# base05 - White
color7  = #dab997
# base03 - Bright Black
color8  = #8a8a8a
# base08 - Bright Red
color9  = #d75f5f
# base0B - Bright Green
color10 = #afaf00
# base0A - Bright Yellow
color11 = #ffaf00
# base0D - Bright Blue
color12 = #83adad
# base0E - Bright Magenta
color13 = #d485ad
# base0C - Bright Cyan
color14 = #85ad85
# base07 - Bright White
color15 = #ebdbb2
# base09
color16 = #ff8700
# base0F
color17 = #d65d0e
# base01
color18 = #3a3a3a
# base02
color19 = #4e4e4e
# base04
color20 = #949494
# base06
color21 = #d5c4a1
