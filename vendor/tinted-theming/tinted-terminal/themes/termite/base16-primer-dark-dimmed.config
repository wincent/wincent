[colors]
# base16 Primer Dark Dimmed
# Scheme author: Jimmy Lin
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #909dab
foreground_bold     = #909dab
cursor              = #909dab
cursor_foreground   = #1c2128
background          = #1c2128

# base00 - Black
color0  = #1c2128
# base08 - Red
color1  = #f47067
# base0B - Green
color2  = #57ab5a
# base0A - Yellow
color3  = #c69026
# base0D - Blue
color4  = #539bf5
# base0E - Magenta
color5  = #e275ad
# base0C - Cyan
color6  = #96d0ff
# base05 - White
color7  = #909dab
# base03 - Bright Black
color8  = #545d68
# base08 - Bright Red
color9  = #f47067
# base0B - Bright Green
color10 = #57ab5a
# base0A - Bright Yellow
color11 = #c69026
# base0D - Bright Blue
color12 = #539bf5
# base0E - Bright Magenta
color13 = #e275ad
# base0C - Bright Cyan
color14 = #96d0ff
# base07 - Bright White
color15 = #cdd9e5
# base09
color16 = #e0823d
# base0F
color17 = #ae5622
# base01
color18 = #373e47
# base02
color19 = #444c56
# base04
color20 = #768390
# base06
color21 = #adbac7
