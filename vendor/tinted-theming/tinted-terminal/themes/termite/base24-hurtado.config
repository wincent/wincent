[colors]
# base24 Hurtado
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a1a1a1
foreground_bold     = #a1a1a1
cursor              = #a1a1a1
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff1b00
# base0B - Green
color2  = #a5df55
# base0A - Yellow
color3  = #89bdff
# base0D - Blue
color4  = #486387
# base0E - Magenta
color5  = #fc5ef0
# base0C - Cyan
color6  = #85e9fe
# base05 - White
color7  = #a1a1a1
# base03 - Bright Black
color8  = #4e4e4e
# base12 - Bright Red
color9  = #d41c00
# base14 - Bright Green
color10 = #a5df55
# base13 - Bright Yellow
color11 = #fbe749
# base16 - Bright Blue
color12 = #89bdff
# base17 - Bright Magenta
color13 = #bf00c0
# base15 - Bright Cyan
color14 = #85e9fe
# base07 - Bright White
color15 = #dbdbdb
# base09
color16 = #fbe74a
# base0F
color17 = #7f0d00
# base01
color18 = #575757
# base02
color19 = #252525
# base04
color20 = #787878
# base06
color21 = #cbcbcb
