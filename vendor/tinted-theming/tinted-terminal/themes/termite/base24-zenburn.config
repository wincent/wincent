color3  = #94bff3
# base0D - Blue
color4  = #506070
# base0E - Magenta
color5  = #dc8cc3
# base0C - Cyan
color6  = #8cd0d3
# base05 - White
color7  = #c1c9b9
# base03 - Bright Black
color8  = #8ba393
# base12 - Bright Red
color9  = #dca3a3
# base14 - Bright Green
color10 = #c3bf9f
# base13 - Bright Yellow
color11 = #e0cf9f
# base16 - Bright Blue
color12 = #94bff3
# base17 - Bright Magenta
color13 = #ec93d3
# base15 - Bright Cyan
color14 = #93e0e3
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f0dfaf
# base0F
color17 = #382828
# base01
color18 = #4d4d4d
