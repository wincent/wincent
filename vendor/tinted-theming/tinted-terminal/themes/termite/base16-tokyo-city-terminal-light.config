[colors]
# base16 Tokyo City Terminal Light
# Scheme author: Michaël Ball
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #28323a
foreground_bold     = #28323a
cursor              = #28323a
cursor_foreground   = #fbfbfd
background          = #fbfbfd

# base00 - Black
color0  = #fbfbfd
# base08 - Red
color1  = #8c4351
# base0B - Green
color2  = #33635c
# base0A - Yellow
color3  = #8f5e15
# base0D - Blue
color4  = #34548a
# base0E - Magenta
color5  = #5a4a78
# base0C - Cyan
color6  = #0f4b6e
# base05 - White
color7  = #28323a
# base03 - Bright Black
color8  = #b7c5d3
# base08 - Bright Red
color9  = #8c4351
# base0B - Bright Green
color10 = #33635c
# base0A - Bright Yellow
color11 = #8f5e15
# base0D - Bright Blue
color12 = #34548a
# base0E - Bright Magenta
color13 = #5a4a78
# base0C - Bright Cyan
color14 = #0f4b6e
# base07 - Bright White
color15 = #171d23
# base09
color16 = #965027
# base0F
color17 = #7e5140
# base01
color18 = #f6f6f8
# base02
color19 = #d8e2ec
# base04
color20 = #526270
# base06
color21 = #1d252c
