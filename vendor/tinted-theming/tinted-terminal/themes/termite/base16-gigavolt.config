color8  = #a1d2e6
# base08 - Bright Red
color9  = #ff661a
# base0B - Bright Green
color10 = #f2e6a9
# base0A - Bright Yellow
color11 = #ffdc2d
# base0D - Bright Blue
color12 = #40bfff
# base0E - Bright Magenta
color13 = #ae94f9
