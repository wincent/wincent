[colors]
# base16 Green Screen
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #00bb00
foreground_bold     = #00bb00
cursor              = #00bb00
cursor_foreground   = #001100
background          = #001100

# base00 - Black
color0  = #001100
# base08 - Red
color1  = #007700
# base0B - Green
color2  = #00bb00
# base0A - Yellow
color3  = #007700
# base0D - Blue
color4  = #009900
# base0E - Magenta
color5  = #00bb00
# base0C - Cyan
color6  = #005500
# base05 - White
color7  = #00bb00
# base03 - Bright Black
color8  = #007700
# base08 - Bright Red
color9  = #007700
# base0B - Bright Green
color10 = #00bb00
# base0A - Bright Yellow
color11 = #007700
# base0D - Bright Blue
color12 = #009900
# base0E - Bright Magenta
color13 = #00bb00
# base0C - Bright Cyan
color14 = #005500
# base07 - Bright White
color15 = #00ff00
# base09
color16 = #009900
# base0F
color17 = #005500
# base01
color18 = #003300
# base02
color19 = #005500
# base04
color20 = #009900
# base06
color21 = #00dd00
