[colors]
# base24 Tomorrow Night
# Scheme author: Cody Buell (https://github.com/codybuell)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c5c8c6
foreground_bold     = #c5c8c6
cursor              = #c5c8c6
cursor_foreground   = #1d1f21
background          = #1d1f21

# base00 - Black
color0  = #1d1f21
# base08 - Red
color1  = #cc6666
# base0B - Green
color2  = #b5bd68
# base0A - Yellow
color3  = #f0c674
# base0D - Blue
color4  = #81a2be
# base0E - Magenta
color5  = #b294bb
# base0C - Cyan
color6  = #8abeb7
# base05 - White
color7  = #c5c8c6
# base03 - Bright Black
color8  = #969896
# base12 - Bright Red
color9  = #e74c3c
# base14 - Bright Green
color10 = #b8d4b3
# base13 - Bright Yellow
color11 = #f7dc6f
# base16 - Bright Blue
color12 = #85c1e9
# base17 - Bright Magenta
color13 = #d7a3ca
# base15 - Bright Cyan
color14 = #95d3ce
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #de935f
# base0F
color17 = #a3685a
# base01
color18 = #282a2e
# base02
color19 = #373b41
# base04
color20 = #b4b7b4
# base06
color21 = #e0e0e0
