[colors]
# base16 Neovim Dark
# Scheme author: https://github.com/neovim/neovim/blob/master/src/nvim/highlight_group.c
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e0e2ea
foreground_bold     = #e0e2ea
cursor              = #e0e2ea
cursor_foreground   = #14161b
background          = #14161b

# base00 - Black
color0  = #14161b
# base08 - Red
color1  = #ffc0b9
# base0B - Green
color2  = #b3f6c0
# base0A - Yellow
color3  = #fce094
# base0D - Blue
color4  = #a6dbff
# base0E - Magenta
color5  = #ffcaff
# base0C - Cyan
color6  = #8cf8f7
# base05 - White
color7  = #e0e2ea
# base03 - Bright Black
color8  = #9b9ea4
# base08 - Bright Red
color9  = #ffc0b9
# base0B - Bright Green
color10 = #b3f6c0
# base0A - Bright Yellow
color11 = #fce094
# base0D - Bright Blue
color12 = #a6dbff
# base0E - Bright Magenta
color13 = #ffcaff
# base0C - Bright Cyan
color14 = #8cf8f7
# base07 - Bright White
color15 = #eef1f8
# base09
color16 = #ffa500
# base0F
color17 = #cd853f
# base01
color18 = #07080d
# base02
color19 = #4f5258
# base04
color20 = #c4c6cd
# base06
color21 = #eef1f8
