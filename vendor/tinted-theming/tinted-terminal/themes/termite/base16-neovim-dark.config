[colors]
# base16 Neovim Dark
# Scheme author: https://github.com/neovim/neovim/blob/master/src/nvim/highlight_group.c
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e0e2ea
foreground_bold     = #e0e2ea
cursor              = #e0e2ea
cursor_foreground   = #14161b
background          = #14161b

color0  = #14161b # base00 - Black
color1  = #ffc0b9 # base08 - Red
color2  = #b3f6c0 # base0B - Green
color3  = #fce094 # base0A - Yellow
color4  = #a6dbff # base0D - Blue
color5  = #ffcaff # base0E - Magenta
color6  = #8cf8f7 # base0C - Cyan
color7  = #e0e2ea # base05 - White
color8  = #9b9ea4 # base03 - Bright Black
color9  = #ffc0b9 # base08 - Bright Red
color10 = #b3f6c0 # base0B - Bright Green
color11 = #fce094 # base0A - Bright Yellow
color12 = #a6dbff # base0D - Bright Blue
color13 = #ffcaff # base0E - Bright Magenta
color14 = #8cf8f7 # base0C - Bright Cyan
color15 = #eef1f8 # base07 - Bright White
color16 = #ffa500 # base09
color17 = #cd853f # base0F
color18 = #07080d # base01
color19 = #4f5258 # base02
color20 = #c4c6cd # base04
color21 = #eef1f8 # base06
