[colors]
# base16 Ocean
# Scheme author: Chris Kempson (http://chriskempson.com)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c0c5ce
foreground_bold     = #c0c5ce
cursor              = #c0c5ce
cursor_foreground   = #2b303b
background          = #2b303b

# base00 - Black
color0  = #2b303b
# base08 - Red
color1  = #bf616a
# base0B - Green
color2  = #a3be8c
# base0A - Yellow
color3  = #ebcb8b
# base0D - Blue
color4  = #8fa1b3
# base0E - Magenta
color5  = #b48ead
# base0C - Cyan
color6  = #96b5b4
# base05 - White
color7  = #c0c5ce
# base03 - Bright Black
color8  = #65737e
# base08 - Bright Red
color9  = #bf616a
# base0B - Bright Green
color10 = #a3be8c
# base0A - Bright Yellow
color11 = #ebcb8b
# base0D - Bright Blue
color12 = #8fa1b3
# base0E - Bright Magenta
color13 = #b48ead
# base0C - Bright Cyan
color14 = #96b5b4
# base07 - Bright White
color15 = #eff1f5
# base09
color16 = #d08770
# base0F
color17 = #ab7967
# base01
color18 = #343d46
# base02
color19 = #4f5b66
# base04
color20 = #a7adba
# base06
color21 = #dfe1e8
