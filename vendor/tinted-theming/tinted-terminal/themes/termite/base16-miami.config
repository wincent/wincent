[colors]
# base16 Miami
# Scheme author: xscriptor (https://github.com/xscriptor)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #f7f1ff
foreground_bold     = #f7f1ff
cursor              = #f7f1ff
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff4c8b
# base0B - Green
color2  = #7fffd4
# base0A - Yellow
color3  = #ffd84c
# base0D - Blue
color4  = #00ffa8
# base0E - Magenta
color5  = #d36cff
# base0C - Cyan
color6  = #47cfff
# base05 - White
color7  = #f7f1ff
# base03 - Bright Black
color8  = #69676c
# base08 - Bright Red
color9  = #ff4c8b
# base0B - Bright Green
color10 = #7fffd4
# base0A - Bright Yellow
color11 = #ffd84c
# base0D - Bright Blue
color12 = #00ffa8
# base0E - Bright Magenta
color13 = #d36cff
# base0C - Bright Cyan
color14 = #47cfff
# base07 - Bright White
color15 = #f7f1ff
# base09
color16 = #ff926c
# base0F
color17 = #a65f46
# base01
color18 = #111112
# base02
color19 = #1e1d1f
# base04
color20 = #88858c
# base06
color21 = #f9f4ff
