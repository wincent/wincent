color6  = #31a99e # base0C - Cyan
color7  = #ffe0a3 # base05 - White
color8  = #a0747c # base03 - Bright Black
color9  = #ffd052 # base12 - Bright Red
color10 = #3ed2c3 # base14 - Bright Green
color11 = #43d98d # base13 - Bright Yellow
color12 = #e581dc # base16 - Bright Blue
color13 = #ed7d51 # base17 - Bright Magenta
color14 = #64abf4 # base15 - Bright Cyan
color15 = #fff7e6 # base07 - Bright White
color16 = #d98328 # base09
color17 = #bd6242 # base0F
