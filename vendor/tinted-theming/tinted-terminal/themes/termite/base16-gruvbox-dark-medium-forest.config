[colors]
# base16 Gruvbox Dark Medium (Forest)
# Scheme author: Muhammad Talha (muhammadtalha.quant@gmail.com), morhetz (https://github.com/morhetz/gruvbox)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d5c4a1
foreground_bold     = #d5c4a1
cursor              = #d5c4a1
cursor_foreground   = #282828
background          = #282828

color0  = #282828 # base00 - Black
color1  = #fb4934 # base08 - Red
color2  = #b8bb26 # base0B - Green
color3  = #fabd2f # base0A - Yellow
color4  = #b8bb26 # base0D - Blue
color5  = #96bda2 # base0E - Magenta
color6  = #5f6c1f # base0C - Cyan
color7  = #d5c4a1 # base05 - White
color8  = #665c50 # base03 - Bright Black
color9  = #fb4934 # base08 - Bright Red
color10 = #b8bb26 # base0B - Bright Green
color11 = #fabd2f # base0A - Bright Yellow
color12 = #b8bb26 # base0D - Bright Blue
color13 = #96bda2 # base0E - Bright Magenta
color14 = #5f6c1f # base0C - Bright Cyan
color15 = #fbf1c7 # base07 - Bright White
color16 = #fe8019 # base09
color17 = #d65d0e # base0F
color18 = #3c3836 # base01
color19 = #504945 # base02
color20 = #bdae93 # base04
color21 = #ebdbb2 # base06
