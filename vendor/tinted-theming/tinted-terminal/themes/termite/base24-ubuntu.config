[colors]
# base24 Ubuntu
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #b3b7b0
foreground_bold     = #b3b7b0
cursor              = #b3b7b0
cursor_foreground   = #300a24
background          = #300a24

# base00 - Black
color0  = #300a24
# base08 - Red
color1  = #cc0000
# base0B - Green
color2  = #4e9a06
# base0A - Yellow
color3  = #729fcf
# base0D - Blue
color4  = #3465a4
# base0E - Magenta
color5  = #75507b
# base0C - Cyan
color6  = #06989a
# base05 - White
color7  = #b3b7b0
# base03 - Bright Black
color8  = #747772
# base12 - Bright Red
color9  = #ef2929
# base14 - Bright Green
color10 = #8ae234
# base13 - Bright Yellow
color11 = #fce94f
# base16 - Bright Blue
color12 = #729fcf
# base17 - Bright Magenta
color13 = #ad7fa8
# base15 - Bright Cyan
color14 = #34e2e2
# base07 - Bright White
color15 = #eeeeec
# base09
color16 = #c4a000
# base0F
color17 = #660000
# base01
color18 = #2e3436
# base02
color19 = #555753
# base04
color20 = #949791
# base06
color21 = #d3d7cf
