color2  = #8cb870
# base0A - Yellow
color3  = #eac67a
# base0D - Blue
color4  = #7fa8d4
# base0E - Magenta
color5  = #b094cc
# base0C - Cyan
color6  = #6ab8b0
# base05 - White
color7  = #faf0e6
# base03 - Bright Black
color8  = #b8a48c
# base08 - Bright Red
color9  = #e87777
# base0B - Bright Green
color10 = #8cb870
# base0A - Bright Yellow
color11 = #eac67a
# base0D - Bright Blue
color12 = #7fa8d4
# base0E - Bright Magenta
color13 = #b094cc
# base0C - Bright Cyan
color14 = #6ab8b0
# base07 - Bright White
color15 = #fef4e4
# base09
color16 = #da9050
# base0F
color17 = #cc88aa
