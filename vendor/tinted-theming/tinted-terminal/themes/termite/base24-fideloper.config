color3  = #7c84c4
# base0D - Blue
color4  = #2e78c1
# base0E - Magenta
color5  = #c0226e
# base0C - Cyan
color6  = #309185
# base05 - White
color7  = #b1b1a3
# base03 - Bright Black
color8  = #415050
# base12 - Bright Red
color9  = #d35f5a
# base14 - Bright Green
color10 = #d35f5a
# base13 - Bright Yellow
color11 = #a86571
# base16 - Bright Blue
color12 = #7c84c4
# base17 - Bright Magenta
color13 = #5b5db2
# base15 - Bright Cyan
color14 = #81908f
# base07 - Bright White
color15 = #fcf4de
# base09
color16 = #b7aa9a
# base0F
color17 = #650e16
