[colors]
# base16 Black Metal (Immortal)
# Scheme author: metalelf0 (https://github.com/metalelf0)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c1c1c1
foreground_bold     = #c1c1c1
cursor              = #c1c1c1
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #5f8787
# base0B - Green
color2  = #7799bb
# base0A - Yellow
color3  = #556677
# base0D - Blue
color4  = #888888
# base0E - Magenta
color5  = #999999
# base0C - Cyan
color6  = #aaaaaa
# base05 - White
color7  = #c1c1c1
# base03 - Bright Black
color8  = #333333
# base08 - Bright Red
color9  = #5f8787
# base0B - Bright Green
color10 = #7799bb
# base0A - Bright Yellow
color11 = #556677
# base0D - Bright Blue
color12 = #888888
# base0E - Bright Magenta
color13 = #999999
# base0C - Bright Cyan
color14 = #aaaaaa
# base07 - Bright White
color15 = #c1c1c1
# base09
color16 = #aaaaaa
# base0F
color17 = #444444
# base01
color18 = #121212
# base02
color19 = #222222
# base04
color20 = #999999
# base06
color21 = #999999
