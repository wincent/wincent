cursor              = #9fa2a6
cursor_foreground   = #2a3b4d
background          = #2a3b4d

# base00 - Black
color0  = #2a3b4d
# base08 - Red
color1  = #c4676c
# base0B - Green
color2  = #66ff66
# base0A - Yellow
color3  = #ffff66
# base0D - Blue
color4  = #15f4ee
# base0E - Magenta
color5  = #9c6cd3
# base0C - Cyan
color6  = #4b8f77
# base05 - White
color7  = #9fa2a6
# base03 - Bright Black
color8  = #55799c
# base08 - Bright Red
color9  = #c4676c
# base0B - Bright Green
color10 = #66ff66
# base0A - Bright Yellow
color11 = #ffff66
# base0D - Bright Blue
color12 = #15f4ee
# base0E - Bright Magenta
color13 = #9c6cd3
# base0C - Bright Cyan
color14 = #4b8f77
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff9966
# base0F
color17 = #bb64a9
# base01
color18 = #3d566f
# base02
color19 = #4b6988
