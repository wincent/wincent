[colors]
# base16 iA Dark
# Scheme author: iA Inc. (modified by aramisgithub)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cccccc
foreground_bold     = #cccccc
cursor              = #cccccc
cursor_foreground   = #1a1a1a
background          = #1a1a1a

# base00 - Black
color0  = #1a1a1a
# base08 - Red
color1  = #d88568
# base0B - Green
color2  = #83a471
# base0A - Yellow
color3  = #b99353
# base0D - Blue
color4  = #8eccdd
# base0E - Magenta
color5  = #b98eb2
# base0C - Cyan
color6  = #7c9cae
# base05 - White
color7  = #cccccc
# base03 - Bright Black
color8  = #767676
# base08 - Bright Red
color9  = #d88568
# base0B - Bright Green
color10 = #83a471
# base0A - Bright Yellow
color11 = #b99353
# base0D - Bright Blue
color12 = #8eccdd
# base0E - Bright Magenta
color13 = #b98eb2
# base0C - Bright Cyan
color14 = #7c9cae
# base07 - Bright White
color15 = #f8f8f8
# base09
color16 = #d86868
# base0F
color17 = #8b6c37
# base01
color18 = #222222
# base02
color19 = #1d414d
# base04
color20 = #b8b8b8
# base06
color21 = #e8e8e8
