color2  = #024c1a # base0B - Green
color3  = #603700 # base0A - Yellow
color4  = #0349b4 # base0D - Blue
color5  = #622cbc # base0E - Magenta
color6  = #1b7c83 # base0C - Cyan
color7  = #454c54 # base05 - White
color8  = #818b98 # base03 - Bright Black
color9  = #86061d # base12 - Bright Red
color10 = #055d20 # base14 - Bright Green
color11 = #4e2c00 # base13 - Bright Yellow
color12 = #1168e3 # base16 - Bright Blue
color13 = #844ae7 # base17 - Bright Magenta
color14 = #3192aa # base15 - Bright Cyan
color15 = #010409 # base07 - Bright White
color16 = #702c00 # base09
color17 = #86061d # base0F
color18 = #f6f8fa # base01
color19 = #d1d9e0 # base02
color20 = #59636e # base04
color21 = #25292e # base06
