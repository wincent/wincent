[colors]
# base24 Mountain
# Scheme author: Stefan Weigl-Bosker (https://github.com/sweiglbosker), based on Mountain Theme (https://github.com/mountain-theme/Mountain)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cacaca
foreground_bold     = #cacaca
cursor              = #cacaca
cursor_foreground   = #0f0f0f
background          = #0f0f0f

# base00 - Black
color0  = #0f0f0f
# base08 - Red
color1  = #ac8a8c
# base0B - Green
color2  = #8aac8b
# base0A - Yellow
color3  = #aca98a
# base0D - Blue
color4  = #8f8aac
# base0E - Magenta
color5  = #ac8aac
# base0C - Cyan
color6  = #8aabac
# base05 - White
color7  = #cacaca
# base03 - Bright Black
color8  = #393939
# base12 - Bright Red
color9  = #c49ea0
# base14 - Bright Green
color10 = #9ec49f
# base13 - Bright Yellow
color11 = #c4c19e
# base16 - Bright Blue
color12 = #a39ec4
# base17 - Bright Magenta
color13 = #c49ec4
# base15 - Bright Cyan
color14 = #9ec3c4
# base07 - Bright White
color15 = #f0f0f0
# base09
color16 = #c6a679
# base0F
color17 = #ac8a8c
# base01
color18 = #191919
