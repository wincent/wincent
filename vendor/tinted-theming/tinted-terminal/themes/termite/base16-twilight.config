[colors]
# base16 Twilight
# Scheme author: David Hart (https://github.com/hartbit)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #a7a7a7
foreground_bold     = #a7a7a7
cursor              = #a7a7a7
cursor_foreground   = #1e1e1e
background          = #1e1e1e

# base00 - Black
color0  = #1e1e1e
# base08 - Red
color1  = #cf6a4c
# base0B - Green
color2  = #8f9d6a
# base0A - Yellow
color3  = #f9ee98
# base0D - Blue
color4  = #7587a6
# base0E - Magenta
color5  = #9b859d
# base0C - Cyan
color6  = #afc4db
# base05 - White
color7  = #a7a7a7
# base03 - Bright Black
color8  = #5f5a60
# base08 - Bright Red
color9  = #cf6a4c
# base0B - Bright Green
color10 = #8f9d6a
# base0A - Bright Yellow
color11 = #f9ee98
# base0D - Bright Blue
color12 = #7587a6
# base0E - Bright Magenta
color13 = #9b859d
# base0C - Bright Cyan
color14 = #afc4db
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #cda869
# base0F
color17 = #9b703f
# base01
color18 = #323537
# base02
color19 = #464b50
# base04
color20 = #838184
# base06
color21 = #c3c3c3
