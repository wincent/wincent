[colors]
# base24 Catppuccin Macchiato
# Scheme author: https://github.com/catppuccin/catppuccin
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cad3f5
foreground_bold     = #cad3f5
cursor              = #cad3f5
cursor_foreground   = #24273a
background          = #24273a

# base00 - Black
color0  = #24273a
# base08 - Red
color1  = #ed8796
# base0B - Green
color2  = #a6da95
# base0A - Yellow
color3  = #eed49f
# base0D - Blue
color4  = #8aadf4
# base0E - Magenta
color5  = #c6a0f6
# base0C - Cyan
color6  = #8bd5ca
# base05 - White
color7  = #cad3f5
# base03 - Bright Black
color8  = #494d64
# base12 - Bright Red
color9  = #ee99a0
# base14 - Bright Green
color10 = #a6da95
# base13 - Bright Yellow
color11 = #f4dbd6
# base16 - Bright Blue
color12 = #7dc4e4
# base17 - Bright Magenta
color13 = #f5bde6
# base15 - Bright Cyan
color14 = #91d7e3
# base07 - Bright White
color15 = #b7bdf8
# base09
color16 = #f5a97f
# base0F
color17 = #f0c6c6
# base01
color18 = #1e2030
