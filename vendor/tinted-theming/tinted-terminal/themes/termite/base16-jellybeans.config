[colors]
# base16 Jellybeans
# Scheme author: FredHappyface (https://github.com/fredHappyface), converted to Base16 by https://github.com/nonetrix
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d5d5d5
foreground_bold     = #d5d5d5
cursor              = #d5d5d5
cursor_foreground   = #121212
background          = #121212

color0  = #121212 # base00 - Black
color1  = #ffa1a1 # base08 - Red
color2  = #bddeab # base0B - Green
color3  = #ffdca0 # base0A - Yellow
color4  = #b1d8f6 # base0D - Blue
color5  = #fbdaff # base0E - Magenta
color6  = #1ab2a8 # base0C - Cyan
color7  = #d5d5d5 # base05 - White
color8  = #c5c5c5 # base03 - Bright Black
color9  = #ffa1a1 # base08 - Bright Red
color10 = #bddeab # base0B - Bright Green
color11 = #ffdca0 # base0A - Bright Yellow
color12 = #b1d8f6 # base0D - Bright Blue
color13 = #fbdaff # base0E - Bright Magenta
color14 = #1ab2a8 # base0C - Bright Cyan
color15 = #ffffff # base07 - Bright White
color16 = #ffba7b # base09
color17 = #713939 # base0F
color18 = #929292 # base01
color19 = #bdbdbd # base02
color20 = #cdcdcd # base04
color21 = #dedede # base06
