[colors]
# base16 Jellybeans
# Scheme author: FredHappyface (https://github.com/fredHappyface), converted to Base16 by https://github.com/nonetrix
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d5d5d5
foreground_bold     = #d5d5d5
cursor              = #d5d5d5
cursor_foreground   = #121212
background          = #121212

# base00 - Black
color0  = #121212
# base08 - Red
color1  = #ffa1a1
# base0B - Green
color2  = #bddeab
# base0A - Yellow
color3  = #ffdca0
# base0D - Blue
color4  = #b1d8f6
# base0E - Magenta
color5  = #fbdaff
# base0C - Cyan
color6  = #1ab2a8
# base05 - White
color7  = #d5d5d5
# base03 - Bright Black
color8  = #c5c5c5
# base08 - Bright Red
color9  = #ffa1a1
# base0B - Bright Green
color10 = #bddeab
# base0A - Bright Yellow
color11 = #ffdca0
# base0D - Bright Blue
color12 = #b1d8f6
# base0E - Bright Magenta
color13 = #fbdaff
# base0C - Bright Cyan
color14 = #1ab2a8
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ffba7b
# base0F
color17 = #713939
# base01
color18 = #929292
# base02
color19 = #bdbdbd
# base04
color20 = #cdcdcd
# base06
color21 = #dedede
