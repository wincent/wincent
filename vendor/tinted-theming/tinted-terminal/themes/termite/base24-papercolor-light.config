[colors]
# base24 PaperColor Light
# Scheme author: Nguyen Nguyen (https://github.com/NLKNguyen/papercolor-theme)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #444444
foreground_bold     = #444444
cursor              = #444444
cursor_foreground   = #eeeeee
background          = #eeeeee

# base00 - Black
color0  = #eeeeee
# base08 - Red
color1  = #af0000
# base0B - Green
color2  = #008700
# base0A - Yellow
color3  = #5f8700
# base0D - Blue
color4  = #0087af
# base0E - Magenta
color5  = #8700af
# base0C - Cyan
color6  = #d75f00
# base05 - White
color7  = #444444
# base03 - Bright Black
color8  = #878787
# base12 - Bright Red
color9  = #d70000
# base14 - Bright Green
color10 = #87af00
# base13 - Bright Yellow
color11 = #ff00af
# base16 - Bright Blue
color12 = #ff8700
# base17 - Bright Magenta
color13 = #5fafff
# base15 - Bright Cyan
color14 = #00af00
# base07 - Bright White
color15 = #0087af
# base09
color16 = #d70087
# base0F
color17 = #005faf
# base01
color18 = #e4e4e4
# base02
color19 = #d0d0d0
# base04
color20 = #b2b2b2
# base06
color21 = #005f87
