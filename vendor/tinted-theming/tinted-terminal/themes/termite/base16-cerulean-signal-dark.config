[colors]
# base16 Cerulean Signal Dark
# Scheme author: Aaron Colichia (https://aaron.colichia.org/)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dce6f2
foreground_bold     = #dce6f2
cursor              = #dce6f2
cursor_foreground   = #101722
background          = #101722

color0  = #101722 # base00 - Black
color1  = #ff8a9a # base08 - Red
color2  = #70e1b0 # base0B - Green
color3  = #e2c85f # base0A - Yellow
color4  = #7dd3ff # base0D - Blue
color5  = #ff74d4 # base0E - Magenta
color6  = #58d9df # base0C - Cyan
color7  = #dce6f2 # base05 - White
color8  = #8fa0b5 # base03 - Bright Black
color9  = #ff8a9a # base08 - Bright Red
color10 = #70e1b0 # base0B - Bright Green
color11 = #e2c85f # base0A - Bright Yellow
color12 = #7dd3ff # base0D - Bright Blue
color13 = #ff74d4 # base0E - Bright Magenta
color14 = #58d9df # base0C - Bright Cyan
color15 = #f7f9fc # base07 - Bright White
color16 = #f5a35c # base09
color17 = #d59b7d # base0F
color18 = #131c29 # base01
color19 = #173a5a # base02
color20 = #aab8ca # base04
color21 = #f1f6fc # base06
