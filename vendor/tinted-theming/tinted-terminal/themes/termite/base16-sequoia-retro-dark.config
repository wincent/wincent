color7  = #868690 # base05 - White
color8  = #43444d # base03 - Bright Black
color9  = #829fa7 # base08 - Bright Red
color10 = #648f68 # base0B - Bright Green
color11 = #da674b # base0A - Bright Yellow
color12 = #5c87a4 # base0D - Bright Blue
color13 = #da674b # base0E - Bright Magenta
