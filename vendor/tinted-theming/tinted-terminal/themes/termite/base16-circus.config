color6  = #4bb1a7
# base05 - White
color7  = #a7a7a7
# base03 - Bright Black
color8  = #5f5a60
# base08 - Bright Red
color9  = #dc657d
# base0B - Bright Green
color10 = #84b97c
# base0A - Bright Yellow
color11 = #c3ba63
# base0D - Bright Blue
color12 = #639ee4
# base0E - Bright Magenta
color13 = #b888e2
