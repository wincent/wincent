color2  = #5adecd
# base0A - Yellow
color3  = #556fff
# base0D - Blue
color4  = #8897f4
# base0E - Magenta
color5  = #c574dd
# base0C - Cyan
color6  = #79e6f3
# base05 - White
color7  = #ceced3
# base03 - Bright Black
color8  = #707281
# base12 - Bright Red
color9  = #ff4971
# base14 - Bright Green
color10 = #18e3c8
# base13 - Bright Yellow
color11 = #ff8037
# base16 - Bright Blue
color12 = #556fff
# base17 - Bright Magenta
color13 = #b043d1
# base15 - Bright Cyan
color14 = #3fdcee
# base07 - Bright White
color15 = #bebec1
# base09
color16 = #f2a272
# base0F
color17 = #793f4b
# base01
color18 = #282a36
