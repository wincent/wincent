[colors]
# base16 Corduroy
# Scheme author: taysatte (https://github.com/taysatte)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cdc8d0
foreground_bold     = #cdc8d0
cursor              = #cdc8d0
cursor_foreground   = #1d1920
background          = #1d1920

color0  = #1d1920 # base00 - Black
color1  = #e06278 # base08 - Red
color2  = #4b8686 # base0B - Green
color3  = #edb392 # base0A - Yellow
color4  = #d27f91 # base0D - Blue
color5  = #c285b2 # base0E - Magenta
color6  = #e99d90 # base0C - Cyan
color7  = #cdc8d0 # base05 - White
color8  = #6f6373 # base03 - Bright Black
color9  = #e06278 # base08 - Bright Red
color10 = #4b8686 # base0B - Bright Green
color11 = #edb392 # base0A - Bright Yellow
color12 = #d27f91 # base0D - Bright Blue
color13 = #c285b2 # base0E - Bright Magenta
color14 = #e99d90 # base0C - Bright Cyan
color15 = #504757 # base07 - Bright White
color16 = #e99d90 # base09
color17 = #887b8c # base0F
color18 = #261e2a # base01
color19 = #2e2533 # base02
color20 = #887b8c # base04
color21 = #cdc8d0 # base06
