[colors]
# base16 Shades of Purple
# Scheme author: Iolar Demartini Junior (http://github.com/demartini), based on Shades of Purple Theme (https://github.com/ahmadawais/shades-of-purple-vscode)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #c7c7c7
foreground_bold     = #c7c7c7
cursor              = #c7c7c7
cursor_foreground   = #1e1e3f
background          = #1e1e3f

# base00 - Black
color0  = #1e1e3f
# base08 - Red
color1  = #d90429
# base0B - Green
color2  = #3ad900
# base0A - Yellow
color3  = #ffe700
# base0D - Blue
color4  = #6943ff
# base0E - Magenta
color5  = #ff2c70
# base0C - Cyan
color6  = #00c5c7
# base05 - White
color7  = #c7c7c7
# base03 - Bright Black
color8  = #808080
# base08 - Bright Red
color9  = #d90429
# base0B - Bright Green
color10 = #3ad900
# base0A - Bright Yellow
color11 = #ffe700
# base0D - Bright Blue
color12 = #6943ff
# base0E - Bright Magenta
color13 = #ff2c70
# base0C - Bright Cyan
color14 = #00c5c7
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #f92a1c
# base0F
color17 = #79e8fb
# base01
color18 = #43d426
# base02
color19 = #f1d000
# base04
color20 = #6871ff
# base06
color21 = #ff77ff
