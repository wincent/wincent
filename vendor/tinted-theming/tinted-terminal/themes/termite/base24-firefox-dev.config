cursor              = #a5acae
cursor_foreground   = #0e1011
background          = #0e1011

# base00 - Black
color0  = #0e1011
# base08 - Red
color1  = #e63853
# base0B - Green
color2  = #5eb83c
# base0A - Yellow
color3  = #006fc0
# base0D - Blue
color4  = #359ddf
# base0E - Magenta
color5  = #d75cff
# base0C - Cyan
color6  = #4b73a2
# base05 - White
color7  = #a5acae
# base03 - Bright Black
color8  = #374d53
# base12 - Bright Red
color9  = #e1003f
# base14 - Bright Green
color10 = #1d9000
# base13 - Bright Yellow
color11 = #cc9308
# base16 - Bright Blue
color12 = #006fc0
# base17 - Bright Magenta
color13 = #a200da
# base15 - Bright Cyan
color14 = #005794
# base07 - Bright White
color15 = #e2e2e2
# base09
color16 = #a57705
# base0F
color17 = #731c29
# base01
color18 = #002731
