[colors]
# base16 Isotope
# Scheme author: Jan T. Sott
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #d0d0d0
foreground_bold     = #d0d0d0
cursor              = #d0d0d0
cursor_foreground   = #000000
background          = #000000

# base00 - Black
color0  = #000000
# base08 - Red
color1  = #ff0000
# base0B - Green
color2  = #33ff00
# base0A - Yellow
color3  = #ff0099
# base0D - Blue
color4  = #0066ff
# base0E - Magenta
color5  = #cc00ff
# base0C - Cyan
color6  = #00ffff
# base05 - White
color7  = #d0d0d0
# base03 - Bright Black
color8  = #808080
# base08 - Bright Red
color9  = #ff0000
# base0B - Bright Green
color10 = #33ff00
# base0A - Bright Yellow
color11 = #ff0099
# base0D - Bright Blue
color12 = #0066ff
# base0E - Bright Magenta
color13 = #cc00ff
# base0C - Bright Cyan
color14 = #00ffff
# base07 - Bright White
color15 = #ffffff
# base09
color16 = #ff9900
# base0F
color17 = #3300ff
# base01
color18 = #404040
# base02
color19 = #606060
# base04
color20 = #c0c0c0
# base06
color21 = #e0e0e0
