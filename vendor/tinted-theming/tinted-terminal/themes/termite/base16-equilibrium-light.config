color6  = #007a72
# base05 - White
color7  = #43474e
# base03 - Bright Black
color8  = #73777f
# base08 - Bright Red
color9  = #d02023
# base0B - Bright Green
color10 = #637200
# base0A - Bright Yellow
color11 = #9d6f00
# base0D - Bright Blue
color12 = #0073b5
# base0E - Bright Magenta
color13 = #4e66b6
