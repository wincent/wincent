[colors]
# base24 Blue Matrix
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #afafaf
foreground_bold     = #afafaf
cursor              = #afafaf
cursor_foreground   = #0f1115
background          = #0f1115

# base00 - Black
color0  = #0f1115
# base08 - Red
color1  = #ff567f
# base0B - Green
color2  = #00ff9b
# base0A - Yellow
color3  = #6871ff
# base0D - Blue
color4  = #00b0fe
# base0E - Magenta
color5  = #d47bfe
# base0C - Cyan
color6  = #75c1fe
# base05 - White
color7  = #afafaf
# base03 - Bright Black
color8  = #7f7f7f
# base12 - Bright Red
color9  = #ff6d67
# base14 - Bright Green
color10 = #5ff967
# base13 - Bright Yellow
color11 = #fefb67
# base16 - Bright Blue
color12 = #6871ff
# base17 - Bright Magenta
color13 = #d582eb
# base15 - Bright Cyan
color14 = #5ffdff
# base07 - Bright White
color15 = #feffff
# base09
color16 = #fefc57
# base0F
color17 = #7f2b3f
# base01
color18 = #101116
# base02
color19 = #676767
# base04
color20 = #979797
# base06
color21 = #c7c7c7
