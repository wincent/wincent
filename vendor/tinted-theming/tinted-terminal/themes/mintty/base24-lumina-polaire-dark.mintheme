# Lumina Polaire Dark theme for Mintty
# Scheme Author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #0f1a21
Red         = #cd776f
Green       = #a9d6b1
Yellow      = #e2c682
Blue        = #aeccf2
Magenta     = #bfbaf7
Cyan        = #8cd9f4
White       = #d7e1e8
BoldBlack   = #25323b
BoldRed     = #dc978f
BoldGreen   = #c2f1ca
BoldYellow  = #fde099
BoldBlue    = #d1e5ff
BoldMagenta = #ffd3fa
BoldCyan    = #c2efff
BoldWhite   = #d7e1e8

# Background & foreground colors
BackgroundColour = #0f1a21
ForegroundColour = #d7e1e8
CursorColour     = #d7e1e8
