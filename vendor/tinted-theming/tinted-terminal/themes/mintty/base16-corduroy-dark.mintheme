Blue        = #dc92a3
Magenta     = #cf98c4
Cyan        = #f0a89b
White       = #ddd8df
BoldBlack   = #7d7082
BoldRed     = #e8758a
BoldGreen   = #55a0a0
BoldYellow  = #f0bd9c
BoldBlue    = #dc92a3
BoldMagenta = #cf98c4
BoldCyan    = #f0a89b
BoldWhite   = #5a5160

# Background & foreground colors
BackgroundColour = #141016
ForegroundColour = #ddd8df
CursorColour     = #ddd8df
