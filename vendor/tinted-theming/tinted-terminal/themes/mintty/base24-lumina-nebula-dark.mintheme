# Lumina Nebula Dark theme for Mintty
# Scheme Author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #161826
Red         = #d57068
Green       = #8fdcba
Yellow      = #f3c085
Blue        = #c6d6e8
Magenta     = #b0a4f8
Cyan        = #88d2da
White       = #dde1ec
BoldBlack   = #2d3041
BoldRed     = #e2928a
BoldGreen   = #b0f5d5
BoldYellow  = #ffdfba
BoldBlue    = #d8eaff
BoldMagenta = #ffc8f9
BoldCyan    = #a1ecf5
BoldWhite   = #dde1ec

# Background & foreground colors
BackgroundColour = #161826
ForegroundColour = #dde1ec
CursorColour     = #dde1ec
