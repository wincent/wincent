# Github Light High Contrast theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #ffffff
Red         = #a0111f
Green       = #024c1a
Yellow      = #603700
Blue        = #0349b4
Magenta     = #622cbc
Cyan        = #1b7c83
White       = #454c54
BoldBlack   = #818b98
BoldRed     = #a0111f
BoldGreen   = #024c1a
BoldYellow  = #603700
BoldBlue    = #0349b4
BoldMagenta = #622cbc
BoldCyan    = #1b7c83
BoldWhite   = #010409

# Background & foreground colors
BackgroundColour = #ffffff
ForegroundColour = #454c54
CursorColour     = #454c54
