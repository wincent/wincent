# Lumina Canopy Dark theme for Mintty
# Scheme Author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #0c1b10
Red         = #d57068
Green       = #99d0a4
Yellow      = #d1cca8
Blue        = #9acaf1
Magenta     = #bfb8f3
Cyan        = #86cfd7
White       = #d8e3d6
BoldBlack   = #223427
BoldRed     = #e1928b
BoldGreen   = #b2ebbd
BoldYellow  = #f4e792
BoldBlue    = #c0e3ff
BoldMagenta = #fdc5f8
BoldCyan    = #9fe9f1
BoldWhite   = #d8e3d6

# Background & foreground colors
BackgroundColour = #0c1b10
ForegroundColour = #d8e3d6
CursorColour     = #d8e3d6
