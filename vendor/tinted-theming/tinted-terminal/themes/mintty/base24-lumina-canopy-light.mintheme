Magenta     = #65599e
Cyan        = #007184
White       = #1e3323
BoldBlack   = #cdd7cb
BoldRed     = #5b1d26
BoldGreen   = #206033
BoldYellow  = #764600
BoldBlue    = #0e5686
BoldMagenta = #70396c
BoldCyan    = #005b6b
