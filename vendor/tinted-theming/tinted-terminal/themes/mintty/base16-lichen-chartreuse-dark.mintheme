# Lichen Chartreuse Dark theme for Mintty
# Scheme Author: Aaron Colichia (https://aaron.colichia.org/)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #151613
Red         = #e28b82
Green       = #83bda5
Yellow      = #b2d084
Blue        = #78adc4
Magenta     = #bfa6d4
Cyan        = #9cc6c9
White       = #e0e5da
BoldBlack   = #899282
BoldRed     = #e28b82
BoldGreen   = #83bda5
BoldYellow  = #b2d084
BoldBlue    = #78adc4
BoldMagenta = #bfa6d4
BoldCyan    = #9cc6c9
BoldWhite   = #fcfcfa

# Background & foreground colors
BackgroundColour = #151613
ForegroundColour = #e0e5da
CursorColour     = #e0e5da
