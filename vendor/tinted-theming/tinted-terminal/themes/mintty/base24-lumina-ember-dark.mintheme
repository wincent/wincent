Blue        = #94bedc
Magenta     = #bbb5e3
Cyan        = #91c7cd
White       = #e4ddd0
BoldBlack   = #2f2d28
BoldRed     = #da9890
BoldGreen   = #c5e5b5
BoldYellow  = #ffe6a2
BoldBlue    = #b0d7f4
BoldMagenta = #f0bcdf
BoldCyan    = #aae1e7
BoldWhite   = #e4ddd0

# Background & foreground colors
BackgroundColour = #171511
ForegroundColour = #e4ddd0
CursorColour     = #e4ddd0
