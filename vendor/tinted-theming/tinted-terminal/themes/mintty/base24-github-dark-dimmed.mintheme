# Github Dark Dimmed theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #0d1117
Red         = #f47067
Green       = #57ab5a
Yellow      = #c69026
Blue        = #539bf5
Magenta     = #b083f0
Cyan        = #39c5cf
White       = #d1d7e0
BoldBlack   = #656c76
BoldRed     = #ff938a
BoldGreen   = #6bc46d
BoldYellow  = #daaa3f
BoldBlue    = #6cb6ff
BoldMagenta = #dcbdfb
BoldCyan    = #56d4dd
BoldWhite   = #cdd9e5

# Background & foreground colors
BackgroundColour = #0d1117
ForegroundColour = #d1d7e0
CursorColour     = #d1d7e0
