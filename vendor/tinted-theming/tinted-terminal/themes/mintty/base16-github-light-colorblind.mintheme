# Github Light Colorblind theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #ffffff
Red         = #bc4c00
Green       = #0550ae
Yellow      = #9a6700
Blue        = #0969da
Magenta     = #8250df
Cyan        = #1b7c83
White       = #454c54
BoldBlack   = #818b98
BoldRed     = #bc4c00
BoldGreen   = #0550ae
BoldYellow  = #9a6700
BoldBlue    = #0969da
BoldMagenta = #8250df
BoldCyan    = #1b7c83
BoldWhite   = #1f2328

# Background & foreground colors
BackgroundColour = #ffffff
ForegroundColour = #454c54
CursorColour     = #454c54
