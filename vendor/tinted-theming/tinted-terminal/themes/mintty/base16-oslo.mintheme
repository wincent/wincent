# Oslo theme for Mintty
# Scheme Author: xscriptor (https://github.com/xscriptor)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #3f4451
Red         = #e05561
Green       = #8cc265
Yellow      = #d18f52
Blue        = #4aa5f0
Magenta     = #c162de
Cyan        = #42b3c2
White       = #abb2bf
BoldBlack   = #6c727f
BoldRed     = #e05561
BoldGreen   = #8cc265
BoldYellow  = #d18f52
BoldBlue    = #4aa5f0
BoldMagenta = #c162de
BoldCyan    = #42b3c2
BoldWhite   = #ffffff

# Background & foreground colors
BackgroundColour = #3f4451
ForegroundColour = #abb2bf
CursorColour     = #abb2bf
