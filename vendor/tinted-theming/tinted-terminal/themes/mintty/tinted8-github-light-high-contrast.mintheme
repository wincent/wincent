# Github Light High Contrast theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: tinted8
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #010409
Red         = #a0111f
Green       = #024c1a
Yellow      = #3f2200
Blue        = #0349b4
Magenta     = #622cbc
Cyan        = #1b7c83
White       = #59636e
BoldBlack   = #393f46
BoldRed     = #86061d
BoldGreen   = #055d20
BoldYellow  = #4e2c00
BoldBlue    = #1168e3
BoldMagenta = #844ae7
BoldCyan    = #3192aa
BoldWhite   = #818b98

# Background & foreground colors
BackgroundColour = #ffffff
ForegroundColour = #010409
CursorColour     = #010409
