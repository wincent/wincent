# Github Dark theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: tinted8
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #2f3742
Red         = #ff7b72
Green       = #3fb950
Yellow      = #d29922
Blue        = #58a6ff
Magenta     = #be8fff
Cyan        = #39c5cf
White       = #f0f6fc
BoldBlack   = #656c76
BoldRed     = #ffa198
BoldGreen   = #56d364
BoldYellow  = #e3b341
BoldBlue    = #79c0ff
BoldMagenta = #d2a8ff
BoldCyan    = #56d4dd
BoldWhite   = #ffffff

# Background & foreground colors
BackgroundColour = #0d1117
ForegroundColour = #f0f6fc
CursorColour     = #f0f6fc
