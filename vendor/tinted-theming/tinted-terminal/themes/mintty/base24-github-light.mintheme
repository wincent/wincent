# Github Light theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #ffffff
Red         = #cf222e
Green       = #116329
Yellow      = #9a6700
Blue        = #0969da
Magenta     = #8250df
Cyan        = #1b7c83
White       = #454c54
BoldBlack   = #818b98
BoldRed     = #a40e26
BoldGreen   = #1a7f37
BoldYellow  = #633c01
BoldBlue    = #218bff
BoldMagenta = #a475f9
BoldCyan    = #3192aa
BoldWhite   = #1f2328

# Background & foreground colors
BackgroundColour = #ffffff
ForegroundColour = #454c54
CursorColour     = #454c54
