# Github Dark theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #0d1117
Red         = #ff7b72
Green       = #3fb950
Yellow      = #d29922
Blue        = #58a6ff
Magenta     = #be8fff
Cyan        = #39c5cf
White       = #d1d7e0
BoldBlack   = #656c76
BoldRed     = #ff7b72
BoldGreen   = #3fb950
BoldYellow  = #d29922
BoldBlue    = #58a6ff
BoldMagenta = #be8fff
BoldCyan    = #39c5cf
BoldWhite   = #ffffff

# Background & foreground colors
BackgroundColour = #0d1117
ForegroundColour = #d1d7e0
CursorColour     = #d1d7e0
