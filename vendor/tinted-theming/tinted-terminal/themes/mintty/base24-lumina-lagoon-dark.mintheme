Cyan        = #5ad3d6
White       = #d7e6e7
BoldBlack   = #1c434b
BoldRed     = #e0938c
BoldGreen   = #b8efc2
BoldYellow  = #ffe6a7
BoldBlue    = #badcff
BoldMagenta = #ffcaf9
BoldCyan    = #9fe6e8
