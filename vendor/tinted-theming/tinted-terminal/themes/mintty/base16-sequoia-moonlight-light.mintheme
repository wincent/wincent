# Sequoia Moonlight Light theme for Mintty
# Scheme Author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #edeef2
Red         = #c94da8
Green       = #4a85d4
Yellow      = #6a6a78
Blue        = #9a5fd9
Magenta     = #6a6a78
Cyan        = #d9884a
White       = #282930
BoldBlack   = #565760
BoldRed     = #c94da8
BoldGreen   = #4a85d4
BoldYellow  = #6a6a78
BoldBlue    = #9a5fd9
BoldMagenta = #6a6a78
BoldCyan    = #d9884a
BoldWhite   = #0f1014

# Background & foreground colors
BackgroundColour = #edeef2
ForegroundColour = #282930
CursorColour     = #282930
