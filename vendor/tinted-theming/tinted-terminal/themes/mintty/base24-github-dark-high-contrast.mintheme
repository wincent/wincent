# Github Dark High Contrast theme for Mintty
# Scheme Author: Tinted Theming (https://github.com/tinted-theming)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #0d1117
Red         = #ff9492
Green       = #28d751
Yellow      = #f0b72f
Blue        = #71b7ff
Magenta     = #cb9eff
Cyan        = #39c5cf
White       = #d1d7e0
BoldBlack   = #656c76
BoldRed     = #ffb1af
BoldGreen   = #4ae168
BoldYellow  = #f7c843
BoldBlue    = #91cbff
BoldMagenta = #dbb7ff
BoldCyan    = #56d4dd
BoldWhite   = #ffffff

# Background & foreground colors
BackgroundColour = #0d1117
ForegroundColour = #d1d7e0
CursorColour     = #d1d7e0
