# Sequoia Moonlight Dark theme for Mintty
# Scheme Author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #0f1014
Red         = #f58ee0
Green       = #8eb6f5
Yellow      = #9898a6
Blue        = #c58fff
Magenta     = #9898a6
Cyan        = #ffbb88
White       = #868690
BoldBlack   = #43444d
BoldRed     = #f58ee0
BoldGreen   = #8eb6f5
BoldYellow  = #9898a6
BoldBlue    = #c58fff
BoldMagenta = #9898a6
BoldCyan    = #ffbb88
BoldWhite   = #0f1014

# Background & foreground colors
BackgroundColour = #0f1014
ForegroundColour = #868690
CursorColour     = #868690
