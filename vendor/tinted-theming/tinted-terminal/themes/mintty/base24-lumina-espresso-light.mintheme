Magenta     = #7049a1
Cyan        = #007083
White       = #39261b
BoldBlack   = #d9cec2
BoldRed     = #5f201e
BoldGreen   = #005e3c
BoldYellow  = #653400
BoldBlue    = #1a5488
BoldMagenta = #70386b
BoldCyan    = #005a6a
BoldWhite   = #39261b

# Background & foreground colors
BackgroundColour = #fcf0e3
ForegroundColour = #39261b
