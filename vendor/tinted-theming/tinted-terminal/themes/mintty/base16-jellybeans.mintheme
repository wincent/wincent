# Jellybeans theme for Mintty
# Scheme Author: FredHappyface (https://github.com/fredHappyface), converted to Base16 by https://github.com/nonetrix
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #121212
Red         = #ffa1a1
Green       = #bddeab
Yellow      = #ffdca0
Blue        = #b1d8f6
Magenta     = #fbdaff
Cyan        = #1ab2a8
White       = #d5d5d5
BoldBlack   = #c5c5c5
BoldRed     = #ffa1a1
BoldGreen   = #bddeab
BoldYellow  = #ffdca0
BoldBlue    = #b1d8f6
BoldMagenta = #fbdaff
BoldCyan    = #1ab2a8
BoldWhite   = #ffffff

# Background & foreground colors
BackgroundColour = #121212
ForegroundColour = #d5d5d5
CursorColour     = #d5d5d5
