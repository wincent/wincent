# Apprentice theme for Mintty
# Scheme Author: Romain Lafourcade (https://github.com/romainl)
# Scheme System: base16
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #262626
Red         = #af5f5f
Green       = #5f875f
Yellow      = #87875f
Blue        = #5f87af
Magenta     = #5f5f87
Cyan        = #5f8787
White       = #bcbcbc
BoldBlack   = #444444
BoldRed     = #af5f5f
BoldGreen   = #5f875f
BoldYellow  = #87875f
BoldBlue    = #5f87af
BoldMagenta = #5f5f87
BoldCyan    = #5f8787
BoldWhite   = #ffffff

# Background & foreground colors
BackgroundColour = #262626
ForegroundColour = #bcbcbc
CursorColour     = #bcbcbc
