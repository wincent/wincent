-- vim: ft=lua
-- {{ scheme.name }} theme for Rex
-- Scheme Author: {{ scheme.author }}
-- Scheme System: {{ scheme.system }}
-- Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)
--
-- Imports this scheme into every Rex app running on this machine and switches
-- the app to the scheme's appearance. Run it with the Rex CLI, for example as a
-- tinty hook:
--
--     hook = "rex --autostart=false do %f"
--
-- Rex can only import theme files from the app's own machine, so apps connected
-- to the Rex server from another machine are skipped. Run tinty there too.

local name = "{{ scheme.system }}-{{ scheme.slug }}"
local variant = "{{#option.is-dark-variant}}dark{{/option.is-dark-variant}}{{^option.is-dark-variant}}light{{/option.is-dark-variant}}"

-- This must match themes/ghostty/{{ scheme.system }}-{{ scheme.slug }} exactly. CI checks that it does.
local theme = [==[
# vim: ft=ghostty
# {{ scheme.name }} theme for Ghostty
# Scheme Author: {{ scheme.author }}
# Scheme System: {{ scheme.system }}
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# Color palette
palette = 0=#{{ palette.black.normal.hex }}
palette = 1=#{{ palette.red.normal.hex }}
palette = 2=#{{ palette.green.normal.hex }}
palette = 3=#{{ palette.yellow.normal.hex }}
palette = 4=#{{ palette.blue.normal.hex }}
palette = 5=#{{ palette.magenta.normal.hex }}
palette = 6=#{{ palette.cyan.normal.hex }}
palette = 7=#{{ palette.white.normal.hex }}
palette = 8=#{{ palette.black.bright.hex }}
palette = 9=#{{ palette.red.bright.hex }}
palette = 10=#{{ palette.green.bright.hex }}
palette = 11=#{{ palette.yellow.bright.hex }}
palette = 12=#{{ palette.blue.bright.hex }}
palette = 13=#{{ palette.magenta.bright.hex }}
palette = 14=#{{ palette.cyan.bright.hex }}
palette = 15=#{{ palette.white.bright.hex }}

# Foreground & background colors
background = #{{ ui.global.background.normal.hex }}
foreground = #{{ ui.global.foreground.normal.hex }}
cursor-color = #{{ ui.cursor.normal.background.hex }}
selection-background = #{{ ui.selection.background.hex }}
selection-foreground = #{{ ui.selection.foreground.hex }}

# Set `macos-icon = custom-style` in your main configuration file to enable theming of the app icon.
#
# Set the ghost color to the lightest foreground:
macos-icon-ghost-color = #{{ palette.white.bright.hex}}
# Replace the official icon's blue background with the designated bright blue color:
macos-icon-screen-color = #{{ palette.blue.bright.hex }}
]==]

local me = assert(rex.call("server.whoami")).principal
if me.transport ~= "unix" then
    io.stderr:write("rex: not connected to a local Rex server, skipping\n")
    return
end

-- Rex names an imported theme after its file, and re-importing a name
-- replaces that theme's colors.
local home = os.getenv("HOME")
local dir = (os.getenv("XDG_CACHE_HOME") or (home .. "/.cache")) .. "/tinted-theming/rex"
rex.exec({ "mkdir", "-p", dir })
local file = dir .. "/" .. name
local out = assert(io.open(file, "w"))
out:write(theme)
out:close()

local function perform(client, action, args)
    local _, err = rex.call("client.perform", {
        client_id = client.client_id, action = action, args = args,
    })
    return err
end

-- Apps connected over the server's local socket as the same user are the
-- apps on this machine.
local list = assert(rex.call("client.list", { kinds = { "app" } }))
local failures = {}
for _, client in ipairs(list.clients or {}) do
    local peer = client.principal or {}
    local label = (client.info or {}).label or client.client_id
    if peer.transport == "unix" and peer.uid == me.uid then
        -- Rex guesses a theme's appearance from its colors when importing.
        -- Switch to the scheme's own variant in case it guessed wrong.
        local err = perform(client, "client.theme.import", { path = file })
            or perform(client, "client.appearance.switch_mode", { mode = variant })
        if err then
            table.insert(failures, label .. ": " .. tostring(err))
        end
    else
        io.stderr:write("rex: skipped " .. label .. ", which is connected from another machine or user\n")
    end
end

if #failures > 0 then
    error(table.concat(failures, "\n"))
end
