// <%= variables.figManaged %>
//
// Validate the installed profile with `nono profile validate pi`.
{
  "meta": {
    "name": "pi",
    "description": "Pi sandbox config."
  },

  // - `deny_credentials` blocks "~/.config/op" (still blocked) and "~/.gnupg"
  //   (homedir is re-granted below for signing, then secret subtrees are denied)
  // - `deny_keychains_macos` blocks "~/Library/Group Containers/2BUA8C4S2C.com.1password"
  "extends": "default",

  "groups": {
    // Read-only access to node/npm/pnpm cache and runtime paths.
    "include": ["node_runtime"]
  },

  "workdir": {
    "access": "readwrite"
  },

  // Hide expected CFPreferences / NSUserDefaults probes from Node and Apple
  // frameworks. Does not grant access.
  "diagnostics": {
    "suppress_system_services": ["user-preference-read"]
  },

  "network": {
    "credentials": ["anthropic_api_key", <%= variables.atlassianSite ? '"atlassian", ' : '' %>"kagi_search", "openrouter_api_key", "xai_api_key"],
    "custom_credentials": {
      "anthropic_api_key": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "op://CLI/anthropic-api-key/credential",
        "inject_header": "x-api-key",
        "credential_format": "{}",
        "env_var": "ANTHROPIC_API_KEY",
        "endpoint_rules": [
          {"method": "POST", "path": "/v1/messages"},
          {"method": "POST", "path": "/v1/messages/count_tokens"},
          {"method": "GET", "path": "/v1/models"}
        ]
      },
      <%- if (variables.atlassianSite) { -%>
      "atlassian": {
        "upstream": <%= JSON.stringify('https://' + variables.atlassianSite) %>,
        // Complete email:token pair, not Base64 and not just the API token.
        "credential_key": "op://CLI/atlassian-api-key/credential",
        "inject_mode": "basic_auth",
        "inject_header": "Authorization",
        "env_var": "ATLASSIAN_API_KEY",
        // Protect credential material, not individual operations.
        "endpoint_policy": {"default": {"decision": "allow"}}
      },
      <%- } -%>
      "kagi_search": {
        "upstream": "https://kagi.com",
        "credential_key": "op://CLI/kagi-api-token/credential",
        "inject_header": "Authorization",
        "credential_format": "Bot {}",
        "env_var": "KAGI_API_TOKEN",
        "endpoint_rules": [{"method": "POST", "path": "/api/v1/search"}]
      },
      "openrouter_api_key": {
        "upstream": "https://openrouter.ai",
        "credential_key": "op://CLI/openrouter-api-key/credential",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "env_var": "OPENROUTER_API_KEY",
        "endpoint_rules": [
          {"method": "POST", "path": "/api/v1/chat/completions"},
          {"method": "GET", "path": "/api/v1/models"}
        ]
      },
      "xai_api_key": {
        "upstream": "https://api.x.ai",
        "credential_key": "op://CLI/xai-api-key/credential",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "env_var": "XAI_API_KEY",
        "endpoint_rules": [
          {"method": "POST", "path": "/v1/chat/completions"},
          {"method": "POST", "path": "/v1/responses"},
          {"method": "GET", "path": "/v1/models"}
        ]
      }
    }
  },

  "environment": {
    "set_vars": {
      <%- if (variables.atlassianSite) { -%>
      "ATLASSIAN_SITE": <%= JSON.stringify(variables.atlassianSite) %>,
      "ATLASSIAN_EMAIL": <%= JSON.stringify(variables.atlassianEmail) %>,
      <%- } -%>
      // Keep sandboxed agent state separate (don't commingle with non-sandboxed
      // state in  "~/.local/state" or "~/.cache").
      "XDG_CACHE_HOME": "$TMPDIR/nono-pi/cache",
      "XDG_STATE_HOME": "$TMPDIR/nono-pi/state"
    }
  },

  "filesystem": {
    // Read+write.
    "allow": [
      // Sessions, models, extension state, etc
      // (TODO: use nono's oauth_capture phantom rewriting).
      "~/.pi",

      "~/.config/jj/repos"
    ],

    // Read-only.
    "read": [
      // `node` and `pi` live under "~/n" (installed via `n`).
      "~/n",

      "~/.claude/skills",
      "~/.claude/plugins",
      "~/.config/git",
      "~/.config/jj",
      "~/.rgrc",

      // Needed so `jj`/Git can read the public keyring and gpg.conf. Secret
      // subtrees are denied below; signing itself goes through gpg-agent.
      "~/.gnupg",
      "~/.zsh/bin",

      // Allow Neovim to read color configuration (necessary because Pi spawns
      // a copy of $EDITOR when using `/edit-answer` or CTRL-g).
      "~/.zsh/.tinted",

      // Ditto, for Neovim's config and data directories. Literal paths rather
      // than "$XDG_CONFIG_HOME"/"$XDG_DATA_HOME", which are unset here, and so
      // would expand to no grant at all.
      "~/.config/nvim",
      "~/.local/share/nvim",

      // Only on work machine; on personal machine harmlessly ignored.
      "$DATADOG_ROOT/wincent/.pi",
      "$DATADOG_ROOT/wincent/.config/git"
    ],

    "unix_socket": [
      // Needed for `clip` and `notify` to reach clipper.
      "~/.clipper.sock",

      // gpg-agent holds the unlocked private key; `jj` signing talks to this
      // rather than decrypting key files in-process.
      "~/.gnupg/S.gpg-agent"
    ],

    "deny": [
      // Deny access to tokens; trailing "*" also covers .zwc (compiled) files.
      "~/.zsh/*.private.zsh*",
      "~/.zsh/host/comp-*",

      // Don't leak unsandboxed nvim undo/view/shada to the agent.
      "~/.local/state/nvim",

      // nono cannot grant individual files under a denied directory without
      // also granting (and bypassing) the directory, which is recursive. Carve
      // the secret material back out (macOS Seatbelt deny-within-allow).
      "~/.gnupg/private-keys-v1.d",
      "~/.gnupg/openpgp-revocs.d",
      "~/.gnupg/secring.gpg"
    ],

    // Lift `deny_credentials` on "~/.gnupg" so the read/socket grants above
    // can take effect. Does not grant access by itself.
    "bypass_protection": ["~/.gnupg"]
  }
}
