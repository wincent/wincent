{
  "filesystem": {
    "read": [
      // Allow Neovim to read its config files (necessary because Pi spawns
      // a copy of $EDITOR when using `/edit-answer` or CTRL-g).
      //
      // Note that even though I don't have $XDG_CONFIG_HOME set, Nono defaults
      // it to "$HOME/.config".
      "$XDG_CONFIG_HOME/nvim",
      "$HOME/.zsh/.tinted"
    ],
    "unix_socket": [
      // Make yanking to Clipper work in Neovim.
      "$HOME/.clipper.sock"
    ]
  },
  "network": {
    // Hide KAGI_API_TOKEN from sandboxed processes.
    "credentials": [
      "kagi_search"
    ],
    "custom_credentials": {
      "kagi_search": {
        "upstream": "https://kagi.com",
        "credential_key": "env://KAGI_API_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bot {}",
        "env_var": "KAGI_API_TOKEN",
        "endpoint_rules": [
          {
            "method": "GET",
            "path": "/api/v0/search"
          }
        ]
      }
    }
  },
  "environment": {
    "deny_vars": [
      "KAGI_API_TOKEN"
    ]
  }
}
