{
  "filesystem": {
    "read": [
      // Allow Neovim to read color configuration (necessary because Pi spawns
      // a copy of $EDITOR when using `/edit-answer` or CTRL-g).
      "$HOME/.zsh/.tinted"
    ],
    "unix_socket": [
      // Make yanking to Clipper work in Neovim.
      "$HOME/.clipper.sock"
    ]
  },
  "network": {
    // Hide API tokens from sandboxed processes and restrict their use to the
    // endpoints Pi needs.
    "credentials": [
      "anthropic_api_key",
      "gemini_generation",
      "kagi_search"
    ],
    "custom_credentials": {
      "anthropic_api_key": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://ANTHROPIC_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}",
        "env_var": "ANTHROPIC_API_KEY",
        "endpoint_rules": [
          {
            "method": "POST",
            "path": "/v1/messages"
          }
        ]
      },
      "gemini_generation": {
        "upstream": "https://generativelanguage.googleapis.com",
        "credential_key": "env://GOOGLE_API_KEY",
        "inject_header": "x-goog-api-key",
        "credential_format": "{}",
        "env_var": "GEMINI_API_KEY",
        "endpoint_rules": [
          {
            "method": "POST",
            "path": "/v1beta/models/*:streamGenerateContent"
          }
        ]
      },
      "kagi_search": {
        "upstream": "https://kagi.com",
        "credential_key": "env://KAGI_API_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bot {}",
        "env_var": "KAGI_API_TOKEN",
        "endpoint_rules": [
          {
            "method": "GET",
            "path": "/api/v0/search"
          }
        ]
      }
    }
  },
  "environment": {
    "deny_vars": [
      "ANTHROPIC_API_KEY",
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY",
      "KAGI_API_TOKEN"
    ]
  }
}
