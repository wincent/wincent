    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-astra",
    "openrouter-zdr-fireworks/deepseek/deepseek-v4.1-flash",
    "openrouter-zdr-deepinfra/deepseek/deepseek-v4.1-flash",
