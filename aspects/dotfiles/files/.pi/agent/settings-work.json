{
  "defaultModel": "gpt-6-astra",
  "defaultProvider": "openai-codex",
  "enabledModels": [
    "anthropic/claude-haiku-5-5",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "datadog-anthropic/*",
    "datadog-google/*",
    "datadog-openai/*",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-astra",
    "openrouter-zdr-fireworks/deepseek/deepseek-v4.1-flash-1017",
    "openrouter-zdr-deepinfra/deepseek/deepseek-v4.1-flash-1017",
    "xai/grok-4.7"
  ],
  "extensions": [
    "~/.local/share/agents/wincent-agent-plugins/pi/extensions",
    "~/dd/wincent/.pi/agent/extensions",
    "!extensions/**/.*/**"
  ],
  "prompts": [
    "~/.local/share/agents/wincent-agent-plugins/pi/prompts",
    "~/.pi/agent/prompts",
    "~/dd/wincent/.pi/agent/prompts"
  ],
  "skills": [
    "~/.local/share/agents/wincent-agent-plugins/pi/skills",
    "~/dd/wincent/.pi/agent/skills"
  ]
}
