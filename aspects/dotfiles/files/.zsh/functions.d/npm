function npm () {
  emulate -L zsh

  # Default launcher: `command npm`
  # (Corporate dotfiles override this.)
  (( $#__npm_launcher )) || typeset -ga __npm_launcher=(command npm)

  case $1 in
    publish|whoami|access|owner|deprecate|unpublish|dist-tag)
      local auth rc
      auth=$(op inject --account my.1password.eu -i "$HOME/.npmrc.tpl") \
        || { print -u2 "npm: op inject failed"; return 1 }
      [[ $auth == *_authToken=* ]] \
        || { print -u2 "npm: no _authToken after injection"; return 1 }
      rc="$(cat "$HOME/.npmrc")"$'\n'"$auth"
      print -r -- "$rc" | $__npm_launcher "$@" --userconfig /dev/stdin
      ;;
    *)
      $__npm_launcher "$@"
      ;;
  esac
}
