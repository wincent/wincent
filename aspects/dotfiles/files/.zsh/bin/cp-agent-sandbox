#!/bin/bash
#
# Launch the Control Plane worker under the existing macOS Pi sandbox.
# Usage: cp-agent-sandbox -- <node> <worker-entrypoint> [args...]
set -e

. "$HOME/.zsh/bin/helpers/agent-launch.bash" || exit 1
agent_launch_validate_worker "$@" || exit $?
shift

endpoint="${CONTROL_PLANE_WORKER_ENDPOINT:-}"
if [[ $endpoint != /* || ! -S $endpoint || -z ${CONTROL_PLANE_WORKER_TOKEN:-} ]]; then
  echo 'cp-agent-sandbox: missing or invalid Control Plane IPC configuration' >&2
  exit 2
fi

nono=/opt/homebrew/bin/nono
if [[ $(uname -s) != Darwin || ! -x $nono ]]; then
  echo 'cp-agent-sandbox: the macOS nono launcher is unavailable; refusing direct launch' >&2
  exit 1
fi

agent_launch_export_worker_entrypoint

agent_launch_prepare_socket_root || exit $?
export PI_SUBAGENT_SOCKET_ROOT="$socket_root"

package_root="$(dirname "$(dirname "$2")")"
agent_launch_exec_sandbox "$nono" cp --no-rollback \
  --allow-unix-socket "$endpoint" \
  --read-file "$1" --read-file "$2" \
  --read "$package_root/node_modules" \
  -- "$@"
