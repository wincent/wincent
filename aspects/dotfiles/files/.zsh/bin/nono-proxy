#!/bin/bash
#
# Run nono's credential-injecting proxy as a standalone server, for use by
# processes that are *not* inside a nono sandbox.
#
# Why: the sandbox hides API keys from the agent by handing it a phantom token
# and swapping in the real credential on the way out (see
# ~/.config/nono/profiles/pi.jsonc). Outside the sandbox there is no phantom,
# so an unsandboxed Pi would need real keys in its environment again. Pointing
# it at this proxy keeps 1Password as the only place a key lives, keeps the
# per-endpoint restrictions, and keeps one credential path for sandboxed Pi,
# unsandboxed Pi, and VMs (via `ssh -R`, see `sb ssh`).
#
# This does *not* hide credentials from an unsandboxed agent, which can run
# `op` itself. What it buys is no plaintext in the dotfiles, one place to
# rotate, endpoint restrictions, and a log of every use.
#
# The process is started from this script (not launchd) so `op` can talk to
# the 1Password app in the user session. CA, password, phantom exports, and
# explicitly shared nonsecret profile metadata come from `./install dotfiles`.
#
# Usage:
#
#   nono-proxy start|stop|status|env|guest-env|port|ca|help
#
#   eval "$(nono-proxy env)"    # starts it if needed, then exports the vars
#   nono-proxy guest-env <guest-ca-path> <guest-bundle-path>
#   nono-proxy stop

set -euo pipefail

PORT=18099
PROFILE=pi
STATE="$HOME/.local/state/nono-proxy"
CA_CERT="$STATE/ca.crt"
CA_KEY="$STATE/ca.key"
CA_BUNDLE="$STATE/bundle.crt"
PASS_FILE="$STATE/pass"
PHANTOMS="$STATE/phantoms.env"
SHARED_ENV="$STATE/shared.env"
LOG_FILE="$STATE/log"
PID_FILE="$STATE/pid"

die() {
  echo "nono-proxy: $*" >&2
  exit 1
}

need_state() {
  [ -f "$PASS_FILE" ] && [ -f "$CA_CERT" ] && [ -f "$CA_KEY" ] &&
    [ -f "$CA_BUNDLE" ] && [ -f "$PHANTOMS" ] && [ -f "$SHARED_ENV" ] ||
    die "state missing under $STATE; run \`./install dotfiles\`"
}

listening() {
  nc -z 127.0.0.1 "$PORT" 2>/dev/null
}

wait_for_listen() {
  local i
  for i in $(seq 1 50); do
    if listening; then
      return 0
    fi
    sleep 0.1
  done
  die "proxy did not start listening on port $PORT; see $LOG_FILE"
}

cmd_start() {
  need_state
  if listening; then
    return 0
  fi

  command -v nono >/dev/null || die "nono is not installed"
  export OP_ACCOUNT="${OP_ACCOUNT:-my.1password.eu}"
  export NONO_PROXY_PASS="$(<"$PASS_FILE")"

  # Loopback only: the proxy holds live credentials. A VM should reach this
  # over `ssh -R`, which arrives on loopback too.
  nohup nono proxy \
    --profile "$PROFILE" \
    --listen 127.0.0.1 \
    --port "$PORT" \
    --proxy-ca-cert "$CA_CERT" \
    --proxy-ca-key "$CA_KEY" \
    >"$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"

  wait_for_listen
}

cmd_stop() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(<"$PID_FILE")"
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
}

cmd_status() {
  if listening; then
    echo "running (profile $PROFILE, port $PORT)"
  else
    echo "not running"
    return 1
  fi
}

# Placeholder credentials: the proxy overwrites the injected header, so the
# value is never used. They exist because clients check that a variable is set
# before making a request (Pi's `web_search` throws without $KAGI_API_TOKEN,
# and a provider with no key is treated as unavailable). The names themselves
# come from the profile, via $PHANTOMS, written at install time.
#
# $NO_PROXY keeps loopback traffic direct, so that local services (eg. agent
# observability on 127.0.0.1) are not routed through, and intercepted by, the
# proxy.
proxy_url() {
  local pass
  pass="$(<"$PASS_FILE")"
  echo "http://x:$pass@127.0.0.1:$PORT"
}

print_export() {
  printf 'export %s=%q\n' "$1" "$2"
}

print_proxy_exports() {
  local url
  url="$(proxy_url)"
  print_export HTTP_PROXY "$url"
  print_export HTTPS_PROXY "$url"
  print_export NO_PROXY localhost,127.0.0.1,::1
  print_export NODE_EXTRA_CA_CERTS "$1"
}

print_bundle_exports() {
  print_export CURL_CA_BUNDLE "$1"
  print_export SSL_CERT_FILE "$1"
  print_export REQUESTS_CA_BUNDLE "$1"
}

print_client_env() {
  # Generated, shell-quoted metadata only. Phantoms win on any collision;
  # dynamic proxy/CA exports are emitted afterward and take precedence too.
  cat "$SHARED_ENV" "$PHANTOMS"
}

cmd_env() {
  need_state
  if ! openssl x509 -in "$CA_CERT" -checkend 0 >/dev/null 2>&1; then
    die "CA expired; run \`./install dotfiles\`"
  fi
  cmd_start
  print_client_env
  print_proxy_exports "$CA_CERT"
  print_bundle_exports "$CA_BUNDLE"
}

# Guest-oriented exports for `sb ssh`. Both paths refer to files on the
# guest. The bundle must combine guest-native roots with the proxy CA, not
# the host's macOS roots. Does not start the proxy: the caller does that.
cmd_guest_env() {
  need_state
  local ca_path="${1:-}" bundle_path="${2:-}"
  [ -n "$ca_path" ] && [ -n "$bundle_path" ] ||
    die "guest-env requires the guest CA and combined bundle paths"
  print_client_env
  print_proxy_exports "$ca_path"
  print_bundle_exports "$bundle_path"
}

cmd_port() {
  echo "$PORT"
}

cmd_ca() {
  need_state
  echo "$CA_CERT"
}

cmd_help() {
  cat <<'EOF'
Run nono's credential-injecting proxy as a standalone server, for use
by processes that are not inside a nono sandbox.

Usage:

  nono-proxy start|stop|status|env|guest-env|port|ca|help

  eval "$(nono-proxy env)"    # starts it if needed, then exports the vars
  nono-proxy guest-env <guest-ca-path> <guest-bundle-path>
  nono-proxy stop

CA, password, phantom exports, and shared nonsecret profile metadata
are created by `./install dotfiles`.
The process itself is started from this script so 1Password CLI can
talk to the unlocked 1Password app.
EOF
}

case "${1:-help}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  env) cmd_env ;;
  guest-env) cmd_guest_env "${2:-}" "${3:-}" ;;
  port) cmd_port ;;
  ca) cmd_ca ;;
  help | --help | -h) cmd_help ;;
  *) die "unknown command: $1 (try \`nono-proxy help\`)" ;;
esac
